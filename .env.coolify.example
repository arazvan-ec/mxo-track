# =============================================================================
# Coolify Environment Variables
# =============================================================================
# Copy this file to .env.coolify and adjust values for your deployment.
# In Coolify, you can also set these via the web UI per service.
# =============================================================================

# --- Symfony App ---
APP_ENV=prod
APP_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
APP_URL=https://tudominio.com

# --- Database (Docker service: db) ---
DATABASE_URL=postgresql://mxo:CHANGE_ME@db:5432/mxo_track?serverVersion=16&charset=utf8
POSTGRES_DB=mxo_track
POSTGRES_USER=mxo
POSTGRES_PASSWORD=CHANGE_ME

# --- Redis (Docker service: redis) ---
REDIS_URL=redis://redis:6379
REDIS_SESSION_PREFIX=sess:transporte:

# --- Mercure (Docker service: mercure) ---
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=https://mercure.tudominio.com/.well-known/mercure
MERCURE_PUBLISHER_JWT_KEY=CHANGE_ME_same_key_for_app_and_mercure
MERCURE_SUBSCRIBER_JWT_KEY=CHANGE_ME_same_key_for_app_and_mercure
MERCURE_SUBSCRIBER_TOKEN_TTL=3600

# Mercure service config
MERCURE_SERVER_NAME=':80'
MERCURE_CORS_ORIGINS=https://tudominio.com

# --- Traccar (Docker service: traccar) ---
TRACCAR_BASE_URL=http://traccar:8082
TRACCAR_WS_URL=ws://traccar:8082/api/socket
TRACCAR_USERNAME=admin
TRACCAR_PASSWORD=CHANGE_ME

# Traccar DB (Docker service: traccar_db)
TRACCAR_DB_HOST=traccar_db
TRACCAR_DB_PORT=5432
TRACCAR_DB_NAME=traccar
TRACCAR_DB_USER=traccar
TRACCAR_DB_PASSWORD=CHANGE_ME

TRACCAR_POSTGRES_DB=traccar
TRACCAR_POSTGRES_USER=traccar
TRACCAR_POSTGRES_PASSWORD=CHANGE_ME

# --- Route optimization (Docker services: vroom, osrm) ---
VROOM_URL=http://vroom:3000
OSRM_URL=http://osrm:5000

# --- Proof of Delivery storage ---
POD_STORAGE=database
# For S3 storage (optional):
# POD_S3_BUCKET=
# POD_S3_REGION=
# POD_S3_ENDPOINT=
# POD_S3_KEY=
# POD_S3_SECRET=

# --- Trusted proxies (Coolify reverse proxy) ---
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
TRUSTED_HEADERS=x-forwarded-for,x-forwarded-host,x-forwarded-proto,x-forwarded-port,x-forwarded-prefix
