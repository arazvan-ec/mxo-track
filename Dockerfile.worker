FROM php:8.4-cli-bookworm

# System dependencies (same as app)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       git unzip curl libpq-dev libzip-dev libicu-dev \
    && docker-php-ext-install pdo pdo_pgsql zip intl opcache \
    && rm -rf /var/lib/apt/lists/*

# PHP production settings
RUN echo 'memory_limit=256M\n\
display_errors=Off\n\
log_errors=On' > /usr/local/etc/php/conf.d/production.ini

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

# Copy backend code
COPY backend/ /app/

# Install dependencies (no dev, optimized autoloader)
ENV APP_ENV=prod
RUN composer install --no-dev --optimize-autoloader --no-interaction --no-scripts \
    && composer run-script post-install-cmd --no-interaction

# Generate Doctrine proxy classes at build time
RUN php bin/console doctrine:proxy:create-proxy-classes --env=prod 2>/dev/null || \
    php bin/console cache:warmup --env=prod

# Copy start script
COPY scripts/railway-worker-start.sh /app/railway-worker-start.sh
RUN chmod +x /app/railway-worker-start.sh

CMD ["/app/railway-worker-start.sh"]
