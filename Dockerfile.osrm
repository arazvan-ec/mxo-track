FROM osrm/osrm-backend:latest

# The base image uses Debian Stretch (EOL) whose repos are offline.
# Point to archive.debian.org for the EOL release.
RUN sed -i 's|http://deb.debian.org/debian|http://archive.debian.org/debian|g' /etc/apt/sources.list && \
    sed -i 's|http://security.debian.org/debian-security|http://archive.debian.org/debian-security|g' /etc/apt/sources.list && \
    sed -i '/stretch-updates/d' /etc/apt/sources.list && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

COPY scripts/osrm-start.sh /opt/osrm-start.sh
RUN chmod +x /opt/osrm-start.sh

# Mount /data as a Railway volume from the dashboard for persistent map data

EXPOSE 5000

ENTRYPOINT ["/opt/osrm-start.sh"]
