# Pin to v5.27.1 from the official GitHub Container Registry (Docker Hub is deprecated).
# IMPORTANT: If you change this version, clear the /data volume on Railway to force
# map data reprocessing — processed data is not compatible across OSRM versions.
FROM ghcr.io/project-osrm/osrm-backend:v5.27.1

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY scripts/osrm-start.sh /opt/osrm-start.sh
RUN chmod +x /opt/osrm-start.sh

# Mount /data as a Railway volume from the dashboard for persistent map data

EXPOSE 5000

ENTRYPOINT ["/opt/osrm-start.sh"]
