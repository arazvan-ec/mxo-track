{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/mxo-track/.claude/hooks/session-start.sh",
            "timeout": 5,
            "statusMessage": "Initializing session state..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/mxo-track/.claude/hooks/full-flow-gate.sh",
            "timeout": 5,
            "statusMessage": "Checking Full-flow compliance..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'FILE=\"$CLAUDE_TOOL_INPUT_FILE_PATH\"; if [[ \"$FILE\" == /root/.claude/plans/* ]]; then BASENAME=$(basename \"$FILE\"); DATE=$(date +%Y-%m-%d); DEST_DIR=\"/home/user/mxo-track/docs/superpowers/plans/conversation\"; mkdir -p \"$DEST_DIR\"; DEST=\"$DEST_DIR/${DATE}-${BASENAME}\"; cp \"$FILE\" \"$DEST\" && cd /home/user/mxo-track && git add \"$DEST\" && git commit -m \"docs: persist conversation plan ${DATE}-${BASENAME}\" && git push; fi'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/mxo-track/.claude/hooks/commit-msg-lint.sh",
            "timeout": 5,
            "statusMessage": "Checking commit message format..."
          },
          {
            "type": "command",
            "command": "/home/user/mxo-track/.claude/hooks/post-commit-reminder.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/home/user/mxo-track/.claude/hooks/manifest-auto-run.sh",
            "timeout": 30,
            "statusMessage": "Updating codebase manifest..."
          }
        ]
      }
    ]
  },
  "plugins": [
    {
      "name": "multi-agent-workflow",
      "path": ".claude/plugins/multi-agent-workflow",
      "enabled": true
    }
  ]
}
