{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/mxo-track/.claude/hooks/session-start.sh",
            "timeout": 5,
            "statusMessage": "Inicializando sesion..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/mxo-track/.claude/hooks/user-prompt-state.sh",
            "timeout": 2,
            "statusMessage": "Leyendo estado del proceso..."
          },
          {
            "type": "command",
            "command": "/home/user/mxo-track/.claude/hooks/parallel-tasks-status.sh",
            "timeout": 2,
            "statusMessage": "Leyendo tareas paralelas..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/mxo-track/.claude/hooks/workflow-engine.sh",
            "timeout": 5,
            "statusMessage": "Workflow..."
          },
          {
            "type": "command",
            "command": "/home/user/mxo-track/.claude/hooks/validators/classify-validator.sh",
            "timeout": 5,
            "statusMessage": "Classify gate..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/mxo-track/.claude/hooks/pre-push-gate.sh",
            "timeout": 5,
            "statusMessage": "Push gate..."
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/mxo-track/.claude/hooks/pre-agent-check.sh",
            "timeout": 5,
            "statusMessage": "Agent pre-check..."
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/mxo-track/.claude/hooks/pre-tool-freshness.sh",
            "timeout": 5,
            "statusMessage": "Freshness check..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Write|Edit|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/mxo-track/.claude/hooks/post-rwe-hook.sh",
            "timeout": 5,
            "statusMessage": "Procesando..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/mxo-track/.claude/hooks/post-bash-validator.sh",
            "timeout": 30,
            "statusMessage": "Validando..."
          }
        ]
      },
      {
        "matcher": "TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/mxo-track/.claude/hooks/todowrite-mirror.sh",
            "timeout": 2,
            "statusMessage": "Reflejando todos..."
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "codebase-search": {
      "command": "node",
      "args": [
        "tools/codebase-search/dist/index.js"
      ],
      "cwd": "/home/user/mxo-track",
      "env": {
        "PROJECT_ROOT": "/home/user/mxo-track"
      }
    }
  },
  "plugins": [
    {
      "name": "multi-agent-workflow",
      "path": ".claude/plugins/multi-agent-workflow",
      "enabled": true
    }
  ]
}
