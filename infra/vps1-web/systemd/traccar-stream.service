[Unit]
Description=Traccar GPS Stream Ingestion Worker
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/transporte-tracking/backend
ExecStart=/usr/bin/php bin/console app:traccar:stream --sleep=5
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=traccar-stream

# Environment
EnvironmentFile=/var/www/transporte-tracking/.env.local

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
