<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Shipment\Model\ShipmentEvent" table="shipment_event">
        <unique-constraints>
            <unique-constraint name="uniq_shipment_event_public_id" columns="public_id"/>
        </unique-constraints>

        <lifecycle-callbacks>
            <lifecycle-callback type="prePersist" method="initializePublicId"/>
        </lifecycle-callbacks>

        <id name="id" type="bigint" column="id">
            <generator strategy="IDENTITY"/>
        </id>

        <field name="publicId" type="ulid" column="public_id" unique="true"/>
        <field name="eventType" type="string" column="event_type" length="40" enum-type="App\Enum\ShipmentEventType"/>
        <field name="payload" type="json"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>

        <many-to-one field="shipment" target-entity="App\Domain\Shipment\Model\Shipment">
            <join-column name="shipment_id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
    </entity>

</doctrine-mapping>
