# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='test-secret-for-testing-only'
APP_DEBUG=1
SYMFONY_DEPRECATIONS_HELPER=disabled

DATABASE_URL="postgresql://app:test@127.0.0.1:5432/transporte_test?serverVersion=16&charset=utf8"
REDIS_URL=redis://127.0.0.1:6379
REDIS_SESSION_PREFIX=sess:transporte_test:

MERCURE_URL=http://127.0.0.1:3000/.well-known/mercure
MERCURE_PUBLIC_URL=http://127.0.0.1:3000/.well-known/mercure
MERCURE_PUBLISHER_JWT_KEY=test-publisher-jwt-key-32bytesxx
MERCURE_SUBSCRIBER_JWT_KEY=test-subscriber-key-at-least-256b
MERCURE_SUBSCRIBER_TOKEN_TTL=3600

TRACCAR_BASE_URL=http://127.0.0.1:8082
TRACCAR_WS_URL=ws://127.0.0.1:8082/api/socket
TRACCAR_USERNAME=admin
TRACCAR_PASSWORD=admin
POD_STORAGE=database

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
