<!doctype html>
<html lang="es" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Reprogramar entrega - {{ shipment.reference }} | MXO Track</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: { extend: { colors: { brand: { 500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8' } } } }
    }
  </script>
</head>
<body class="min-h-full bg-gray-50">

  {# -- Header --------------------------------------------------------- #}
  <header class="bg-white border-b border-gray-200">
    <div class="mx-auto max-w-2xl px-4 py-4 flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-600">
        <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
        </svg>
      </div>
      <div>
        <h1 class="text-lg font-bold text-gray-900">MXO Track</h1>
        <p class="text-xs text-gray-500">Reprogramar entrega</p>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-2xl px-4 py-6">

    {# -- Flash messages ------------------------------------------------ #}
    {% for type, messages in app.flashes %}
      {% for message in messages %}
        <div class="mb-4 rounded-lg px-4 py-3 text-sm font-medium
          {% if type == 'error' %}bg-red-100 text-red-800{% else %}bg-green-100 text-green-800{% endif %}">
          {{ message }}
        </div>
      {% endfor %}
    {% endfor %}

    {# -- Shipment info ------------------------------------------------- #}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 mb-6">
      <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Referencia</p>
      <p class="mt-1 text-xl font-bold text-gray-900">{{ shipment.reference }}</p>
      <p class="mt-1 text-sm text-gray-500">{{ shipment.recipientName }}</p>
    </div>

    {# -- Reschedule form ----------------------------------------------- #}
    <form method="post" action="{{ path('public_tracking_reschedule_submit', {trackingToken: trackingToken}) }}">

      {# -- Time slot cards --------------------------------------------- #}
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 mb-6">
        <h2 class="text-sm font-semibold text-gray-900 mb-4">Selecciona una nueva franja horaria</h2>

        <div class="space-y-3">
          {% for slot in slots %}
            <label class="relative flex items-center gap-4 rounded-lg border border-gray-200 p-4 cursor-pointer hover:border-brand-500 hover:bg-blue-50 transition-colors has-[:checked]:border-brand-600 has-[:checked]:bg-blue-50 has-[:checked]:ring-1 has-[:checked]:ring-brand-600">
              <input type="radio" name="slot_id" value="{{ slot.publicIdString }}"
                     class="h-4 w-4 text-brand-600 border-gray-300 focus:ring-brand-500">
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-900">
                  {{ slot.slotDate|date('l d/m/Y') }}
                </p>
                <p class="text-sm text-gray-500">
                  {{ slot.slotStart|date('H:i') }} - {{ slot.slotEnd|date('H:i') }}
                  {% if slot.slotStart|date('H') < 13 %}
                    <span class="ml-1 inline-flex rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800">Manana</span>
                  {% else %}
                    <span class="ml-1 inline-flex rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-800">Tarde</span>
                  {% endif %}
                </p>
              </div>
              <svg class="w-5 h-5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </label>
          {% endfor %}
        </div>
      </div>

      {# -- Alternative options ----------------------------------------- #}
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 mb-6">
        <h2 class="text-sm font-semibold text-gray-900 mb-4">O elige una alternativa</h2>

        <div class="space-y-3">
          <label class="relative flex items-center gap-4 rounded-lg border border-gray-200 p-4 cursor-pointer hover:border-brand-500 hover:bg-blue-50 transition-colors has-[:checked]:border-brand-600 has-[:checked]:bg-blue-50 has-[:checked]:ring-1 has-[:checked]:ring-brand-600">
            <input type="radio" name="alternative_option" value="porteria"
                   class="h-4 w-4 text-brand-600 border-gray-300 focus:ring-brand-500"
                   onclick="document.querySelectorAll('input[name=slot_id]').forEach(r => r.checked = false)">
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-gray-900">Dejar en porteria</p>
              <p class="text-sm text-gray-500">El paquete se dejara con el portero del edificio</p>
            </div>
            <svg class="w-5 h-5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z"/>
            </svg>
          </label>

          <label class="relative flex items-center gap-4 rounded-lg border border-gray-200 p-4 cursor-pointer hover:border-brand-500 hover:bg-blue-50 transition-colors has-[:checked]:border-brand-600 has-[:checked]:bg-blue-50 has-[:checked]:ring-1 has-[:checked]:ring-brand-600">
            <input type="radio" name="alternative_option" value="vecino"
                   class="h-4 w-4 text-brand-600 border-gray-300 focus:ring-brand-500"
                   onclick="document.querySelectorAll('input[name=slot_id]').forEach(r => r.checked = false)">
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-gray-900">Dejar con vecino</p>
              <p class="text-sm text-gray-500">El paquete se entregara a un vecino cercano</p>
            </div>
            <svg class="w-5 h-5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"/>
            </svg>
          </label>
        </div>
      </div>

      {# -- Submit ------------------------------------------------------ #}
      <div class="flex gap-3">
        <a href="{{ path('public_tracking', {trackingToken: trackingToken}) }}"
           class="flex-1 inline-flex justify-center rounded-lg border border-gray-300 bg-white px-4 py-3 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50">
          Volver
        </a>
        <button type="submit"
                class="flex-1 inline-flex justify-center rounded-lg bg-brand-600 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2">
          Confirmar reprogramacion
        </button>
      </div>

    </form>
  </main>

  <footer class="text-center py-6">
    <p class="text-xs text-gray-400">MXO Track - Plataforma de seguimiento logistico</p>
  </footer>

  <script>
    // Deselect alternative options when a time slot is selected
    document.querySelectorAll('input[name="slot_id"]').forEach(function(radio) {
      radio.addEventListener('change', function() {
        document.querySelectorAll('input[name="alternative_option"]').forEach(function(r) {
          r.checked = false;
        });
      });
    });
  </script>

</body>
</html>
