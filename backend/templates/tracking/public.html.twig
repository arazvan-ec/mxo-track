<!doctype html>
<html lang="es" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Seguimiento - {{ shipment.reference }} | MXO Track</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: { extend: { colors: { brand: { 500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8' } } } }
    }
  </script>
</head>
<body class="min-h-full" style="background: var(--color-surface);">

  {# ── Header ─────────────────────────────────────────────────────── #}
  <header style="background: var(--color-surface-elevated); border-color: var(--color-border);" class="border-b">
    <div class="mx-auto max-w-2xl px-4 py-4 flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-600">
        <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
        </svg>
      </div>
      <div>
        <h1 class="text-lg font-bold" style="color: var(--color-text-primary);">MXO Track</h1>
        <p class="text-xs" style="color: var(--color-text-secondary);">Seguimiento de envio</p>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-2xl px-4 py-6">

    {# ── Shipment Reference Card ──────────────────────────────────── #}
    <div class="theme-card rounded-xl shadow-sm p-5 mb-6" style="border-color: var(--color-border);">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Referencia</p>
          <p class="mt-1 text-xl font-bold" style="color: var(--color-text-primary);">{{ shipment.reference }}</p>
          <p class="mt-1 text-sm" style="color: var(--color-text-secondary);">{{ shipment.recipientName }}</p>
        </div>
        <div class="shrink-0">
          {% if currentStatus == 'DELIVERED' %}
            <span class="inline-flex items-center gap-1 rounded-full badge-green px-3 py-1 text-sm font-semibold">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
              Entregado
            </span>
          {% elseif currentStatus == 'EXCEPTION' %}
            <span class="inline-flex items-center gap-1 rounded-full badge-red px-3 py-1 text-sm font-semibold">
              Incidencia
            </span>
          {% elseif currentStatus == 'IN_TRANSIT' or currentStatus == 'OUT_FOR_DELIVERY' %}
            <span class="inline-flex items-center gap-1 rounded-full badge-blue px-3 py-1 text-sm font-semibold">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-600"></span>
              </span>
              En camino
            </span>
          {% else %}
            <span class="inline-flex rounded-full px-3 py-1 text-sm font-semibold" style="background: var(--color-surface); color: var(--color-text-secondary);">
              {{ currentStatus }}
            </span>
          {% endif %}
        </div>
      </div>
    </div>

    {# ── ETA Card (shown when route is active and ETA available) ──── #}
    {% if routeActive and etaMinutes is defined and etaMinutes is not null %}
      <div class="bg-blue-50 rounded-xl shadow-sm border border-blue-200 p-5 mb-6">
        <div class="flex items-center gap-3">
          <div class="shrink-0 flex h-10 w-10 items-center justify-center rounded-full bg-blue-500">
            <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-blue-900">Llegada estimada</p>
            <p class="text-lg font-bold text-blue-800">
              {% if etaTime is not null %}{{ etaTime }}{% endif %}
              <span class="text-sm font-medium text-blue-600">(~{{ etaMinutes }} min)</span>
            </p>
            {% if etaDistanceKm is not null %}
              <p class="text-xs text-blue-600">{{ etaDistanceKm|number_format(1) }} km de distancia</p>
            {% endif %}
          </div>
        </div>
      </div>
    {% endif %}

    {# ── Status Timeline ──────────────────────────────────────────── #}
    <div class="theme-card rounded-xl shadow-sm p-5 mb-6" style="border-color: var(--color-border);">
      <h2 class="text-sm font-semibold mb-4" style="color: var(--color-text-primary);">Historial del envio</h2>
      <div class="flow-root">
        <ul class="-mb-4">
          {% for event in events %}
          <li class="relative pb-4 {% if not loop.last %}border-l-2 ml-3{% else %}ml-3{% endif %}" {% if not loop.last %}style="border-color: var(--color-border);"{% endif %}>
            <div class="flex items-start gap-3 -ml-3">
              <div class="shrink-0 flex h-6 w-6 items-center justify-center rounded-full
                {% if event.eventType.value == 'DELIVERED' %}bg-green-500
                {% elseif event.eventType.value == 'EXCEPTION' %}bg-red-500
                {% elseif event.eventType.value == 'OUT_FOR_DELIVERY' %}bg-blue-500
                {% elseif event.eventType.value == 'IN_TRANSIT' %}bg-indigo-500
                {% else %}bg-gray-400{% endif %} ring-4" style="--tw-ring-color: var(--color-surface-elevated);">
                <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                  {% if event.eventType.value == 'DELIVERED' %}
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/>
                  {% else %}
                    <circle cx="10" cy="10" r="3"/>
                  {% endif %}
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium" style="color: var(--color-text-primary);">{{ event.eventType.value|replace({'_': ' '})|capitalize }}</p>
                <p class="text-xs" style="color: var(--color-text-secondary);">{{ event.createdAt|date('d/m/Y H:i') }}</p>
              </div>
            </div>
          </li>
          {% endfor %}
        </ul>
      </div>
    </div>

    {# ── Delivery Address ─────────────────────────────────────────── #}
    <div class="theme-card rounded-xl shadow-sm p-5 mb-6" style="border-color: var(--color-border);">
      <h2 class="text-sm font-semibold mb-2" style="color: var(--color-text-primary);">Direccion de entrega</h2>
      <p class="text-sm" style="color: var(--color-text-secondary);">{{ shipment.address }}</p>
    </div>

    {# ── Rating Section ──────────────────────────────────────────── #}
    {% if currentStatus == 'DELIVERED' %}
      {% if existingRating %}
        {# Show existing rating inline #}
        <div class="theme-card rounded-xl shadow-sm p-5" style="border-color: var(--color-border);">
          <h2 class="text-sm font-semibold mb-3" style="color: var(--color-text-primary);">Tu valoracion</h2>
          <div class="flex items-center gap-1 mb-2">
            {% for i in 1..5 %}
              <svg class="w-5 h-5 {{ i <= existingRating.score ? 'text-yellow-400' : 'text-gray-200' }}"
                   fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            {% endfor %}
            <span class="ml-1 text-sm font-medium" style="color: var(--color-text-secondary);">{{ existingRating.score }}/5</span>
          </div>
          {% if existingRating.tags is not empty %}
            <div class="flex flex-wrap gap-1.5 mb-2">
              {% for tag in existingRating.tags %}
                <span class="inline-flex items-center rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700 ring-1 ring-inset ring-brand-200">
                  {{ tag }}
                </span>
              {% endfor %}
            </div>
          {% endif %}
          {% if existingRating.comment %}
            <p class="text-sm mt-2" style="color: var(--color-text-secondary);">{{ existingRating.comment }}</p>
          {% endif %}
        </div>
      {% else %}
        {# Prompt to rate #}
        <div class="theme-card rounded-xl shadow-sm p-5" style="border-color: var(--color-border);">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-sm font-semibold" style="color: var(--color-text-primary);">Valora tu entrega</h2>
              <p class="text-xs mt-0.5" style="color: var(--color-text-secondary);">Tu opinion nos ayuda a mejorar</p>
            </div>
            <a href="{{ path('public_tracking_rate_page', {trackingToken: shipment.trackingToken}) }}"
               class="inline-flex items-center gap-1.5 rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700 transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
              Valorar
            </a>
          </div>
        </div>
      {% endif %}
    {% endif %}

  </main>

  <footer class="text-center py-6">
    <p class="text-xs" style="color: var(--color-text-muted);">MXO Track - Plataforma de seguimiento logistico</p>
  </footer>

</body>
</html>
