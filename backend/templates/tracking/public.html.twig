<!doctype html>
<html lang="es" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Seguimiento - {{ shipment.reference }} | MXO Track</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: { extend: { colors: { brand: { 500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8' } } } }
    }
  </script>
</head>
<body class="min-h-full bg-gray-50">

  {# ── Header ─────────────────────────────────────────────────────── #}
  <header class="bg-white border-b border-gray-200">
    <div class="mx-auto max-w-2xl px-4 py-4 flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-600">
        <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
        </svg>
      </div>
      <div>
        <h1 class="text-lg font-bold text-gray-900">MXO Track</h1>
        <p class="text-xs text-gray-500">Seguimiento de envio</p>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-2xl px-4 py-6">

    {# ── Shipment Reference Card ──────────────────────────────────── #}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 mb-6">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Referencia</p>
          <p class="mt-1 text-xl font-bold text-gray-900">{{ shipment.reference }}</p>
          <p class="mt-1 text-sm text-gray-500">{{ shipment.recipientName }}</p>
        </div>
        <div class="shrink-0">
          {% if currentStatus == 'DELIVERED' %}
            <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-3 py-1 text-sm font-semibold text-green-800">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
              Entregado
            </span>
          {% elseif currentStatus == 'EXCEPTION' %}
            <span class="inline-flex items-center gap-1 rounded-full bg-red-100 px-3 py-1 text-sm font-semibold text-red-800">
              Incidencia
            </span>
          {% elseif currentStatus == 'IN_TRANSIT' or currentStatus == 'OUT_FOR_DELIVERY' %}
            <span class="inline-flex items-center gap-1 rounded-full bg-blue-100 px-3 py-1 text-sm font-semibold text-blue-800">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-600"></span>
              </span>
              En camino
            </span>
          {% else %}
            <span class="inline-flex rounded-full bg-gray-100 px-3 py-1 text-sm font-semibold text-gray-700">
              {{ currentStatus }}
            </span>
          {% endif %}
        </div>
      </div>
    </div>

    {# ── Status Timeline ──────────────────────────────────────────── #}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 mb-6">
      <h2 class="text-sm font-semibold text-gray-900 mb-4">Historial del envio</h2>
      <div class="flow-root">
        <ul class="-mb-4">
          {% for event in events %}
          <li class="relative pb-4 {% if not loop.last %}border-l-2 border-gray-200 ml-3{% else %}ml-3{% endif %}">
            <div class="flex items-start gap-3 -ml-3">
              <div class="shrink-0 flex h-6 w-6 items-center justify-center rounded-full
                {% if event.eventType.value == 'DELIVERED' %}bg-green-500
                {% elseif event.eventType.value == 'EXCEPTION' %}bg-red-500
                {% elseif event.eventType.value == 'OUT_FOR_DELIVERY' %}bg-blue-500
                {% elseif event.eventType.value == 'IN_TRANSIT' %}bg-indigo-500
                {% else %}bg-gray-400{% endif %} ring-4 ring-white">
                <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                  {% if event.eventType.value == 'DELIVERED' %}
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/>
                  {% else %}
                    <circle cx="10" cy="10" r="3"/>
                  {% endif %}
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-gray-900">{{ event.eventType.value|replace({'_': ' '})|capitalize }}</p>
                <p class="text-xs text-gray-500">{{ event.createdAt|date('d/m/Y H:i') }}</p>
              </div>
            </div>
          </li>
          {% endfor %}
        </ul>
      </div>
    </div>

    {# ── Delivery Address ─────────────────────────────────────────── #}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
      <h2 class="text-sm font-semibold text-gray-900 mb-2">Direccion de entrega</h2>
      <p class="text-sm text-gray-600">{{ shipment.address }}</p>
    </div>

  </main>

  <footer class="text-center py-6">
    <p class="text-xs text-gray-400">MXO Track - Plataforma de seguimiento logistico</p>
  </footer>

</body>
</html>
