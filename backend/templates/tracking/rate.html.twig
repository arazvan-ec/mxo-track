<!doctype html>
<html lang="es" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Valorar entrega - {{ shipment.reference }} | MXO Track</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: { extend: { colors: { brand: { 500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8' } } } }
    }
  </script>
  <style>[x-cloak] { display: none !important; }</style>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
</head>
<body class="min-h-full" style="background: var(--color-surface);">

  {# ── Header ─────────────────────────────────────────────────────── #}
  <header style="background: var(--color-surface-elevated); border-color: var(--color-border);" class="border-b">
    <div class="mx-auto max-w-2xl px-4 py-4 flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-600">
        <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
        </svg>
      </div>
      <div>
        <h1 class="text-lg font-bold" style="color: var(--color-text-primary);">MXO Track</h1>
        <p class="text-xs" style="color: var(--color-text-secondary);">Valorar entrega</p>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-2xl px-4 py-6">

    {# ── Shipment info ──────────────────────────────────────────────── #}
    <div class="theme-card rounded-xl shadow-sm p-5 mb-6" style="border-color: var(--color-border);">
      <p class="text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Envio</p>
      <p class="mt-1 text-lg font-bold" style="color: var(--color-text-primary);">{{ shipment.reference }}</p>
      {% if shipment.recipientName %}
        <p class="mt-1 text-sm" style="color: var(--color-text-secondary);">{{ shipment.recipientName }}</p>
      {% endif %}
    </div>

    {% if existingRating %}
      {# ── Read-only existing rating ──────────────────────────────── #}
      <div class="theme-card rounded-xl shadow-sm p-5 mb-6" style="border-color: var(--color-border);">
        <h2 class="text-sm font-semibold mb-4" style="color: var(--color-text-primary);">Tu valoracion</h2>

        {# Stars (read-only) #}
        <div class="flex items-center gap-1 mb-3">
          {% for i in 1..5 %}
            <svg class="w-8 h-8 {{ i <= existingRating.score ? 'text-yellow-400' : 'text-gray-200' }}"
                 fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          {% endfor %}
          <span class="ml-2 text-sm font-medium" style="color: var(--color-text-secondary);">{{ existingRating.score }}/5</span>
        </div>

        {# Tags #}
        {% if existingRating.tags is not empty %}
          <div class="flex flex-wrap gap-2 mb-3">
            {% for tag in existingRating.tags %}
              <span class="inline-flex items-center rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700 ring-1 ring-inset ring-brand-200">
                {{ tag }}
              </span>
            {% endfor %}
          </div>
        {% endif %}

        {# Comment #}
        {% if existingRating.comment %}
          <div class="mt-3 rounded-lg p-3" style="background: var(--color-surface);">
            <p class="text-sm" style="color: var(--color-text-secondary);">{{ existingRating.comment }}</p>
          </div>
        {% endif %}

        <p class="mt-4 text-xs" style="color: var(--color-text-muted);">
          Enviada el {{ existingRating.createdAt|date('d/m/Y H:i') }}
        </p>
      </div>

      <div class="text-center">
        <a href="{{ path('public_tracking', {trackingToken: shipment.trackingToken}) }}"
           class="text-sm font-medium text-brand-600 hover:text-brand-700">
          Volver al seguimiento
        </a>
      </div>

    {% else %}
      {# ── Rating form ────────────────────────────────────────────── #}
      <div class="theme-card rounded-xl shadow-sm p-5 mb-6"
           style="border-color: var(--color-border);"
           x-data="ratingForm()" x-cloak>

        <h2 class="text-sm font-semibold mb-4" style="color: var(--color-text-primary);">Valora tu experiencia de entrega</h2>

        {# Star picker #}
        <div class="flex items-center gap-1 mb-5">
          <template x-for="star in [1, 2, 3, 4, 5]" :key="star">
            <button type="button"
                    @click="score = star"
                    @mouseenter="hovered = star"
                    @mouseleave="hovered = 0"
                    class="focus:outline-none transition-colors">
              <svg class="w-10 h-10 transition-colors"
                   :class="(hovered || score) >= star ? 'text-yellow-400' : 'text-gray-200'"
                   fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            </button>
          </template>
          <span class="ml-2 text-sm" style="color: var(--color-text-secondary);" x-show="score > 0" x-text="score + '/5'"></span>
        </div>

        {# Tag buttons #}
        <div class="mb-5">
          <p class="text-xs font-medium uppercase tracking-wider mb-2" style="color: var(--color-text-secondary);">Etiquetas (opcional)</p>
          <div class="flex flex-wrap gap-2">
            <template x-for="tag in availableTags" :key="tag">
              <button type="button"
                      @click="toggleTag(tag)"
                      :class="selectedTags.includes(tag)
                        ? 'bg-brand-600 text-white ring-brand-600'
                        : 'ring-1'"
                      :style="!selectedTags.includes(tag) ? 'background: var(--color-surface-elevated); color: var(--color-text-secondary); --tw-ring-color: var(--color-border);' : ''"
                      class="inline-flex items-center rounded-full px-3 py-1.5 text-sm font-medium ring-1 ring-inset transition-colors">
                <span x-text="tag"></span>
              </button>
            </template>
          </div>
        </div>

        {# Comment textarea #}
        <div class="mb-5">
          <label for="rating-comment" class="block text-xs font-medium uppercase tracking-wider mb-2" style="color: var(--color-text-secondary);">
            Comentario (opcional)
          </label>
          <textarea id="rating-comment"
                    x-model="comment"
                    rows="3"
                    maxlength="500"
                    placeholder="Cuentanos tu experiencia..."
                    class="block w-full rounded-lg border px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
                    style="background: var(--color-surface-elevated); color: var(--color-text-primary); border-color: var(--color-border);">
          </textarea>
        </div>

        {# Error message #}
        <div x-show="errorMessage" x-cloak class="mb-4 rounded-lg bg-red-50 p-3">
          <p class="text-sm text-red-700" x-text="errorMessage"></p>
        </div>

        {# Success message #}
        <div x-show="submitted" x-cloak class="mb-4 rounded-lg bg-green-50 p-4 text-center">
          <svg class="mx-auto h-8 w-8 text-green-500 mb-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <p class="text-sm font-medium text-green-800">Gracias por tu valoracion</p>
        </div>

        {# Submit button #}
        <button type="button"
                @click="submitRating()"
                :disabled="score === 0 || submitting || submitted"
                :class="score === 0 || submitting || submitted
                  ? 'bg-gray-300 cursor-not-allowed'
                  : 'bg-brand-600 hover:bg-brand-700'"
                class="w-full rounded-lg px-4 py-2.5 text-sm font-semibold text-white transition-colors focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2">
          <span x-show="!submitting && !submitted">Enviar valoracion</span>
          <span x-show="submitting" x-cloak>Enviando...</span>
          <span x-show="submitted" x-cloak>Valoracion enviada</span>
        </button>
      </div>

      <div class="text-center">
        <a href="{{ path('public_tracking', {trackingToken: shipment.trackingToken}) }}"
           class="text-sm font-medium text-brand-600 hover:text-brand-700">
          Volver al seguimiento
        </a>
      </div>
    {% endif %}

  </main>

  <footer class="text-center py-6">
    <p class="text-xs" style="color: var(--color-text-muted);">MXO Track - Plataforma de seguimiento logistico</p>
  </footer>

  <script>
    function ratingForm() {
      return {
        score: 0,
        hovered: 0,
        comment: '',
        selectedTags: [],
        availableTags: ['Puntual', 'Amable', 'Rapido', 'Cuidadoso'],
        submitting: false,
        submitted: false,
        errorMessage: '',

        toggleTag(tag) {
          const idx = this.selectedTags.indexOf(tag);
          if (idx === -1) {
            this.selectedTags.push(tag);
          } else {
            this.selectedTags.splice(idx, 1);
          }
        },

        async submitRating() {
          if (this.score === 0 || this.submitting || this.submitted) return;

          this.submitting = true;
          this.errorMessage = '';

          const payload = {
            score: this.score,
            comment: this.comment.trim() || null,
            tags: this.selectedTags.length > 0 ? this.selectedTags : null,
          };

          try {
            const resp = await fetch('{{ path('public_tracking_rate', {trackingToken: shipment.trackingToken}) }}', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });

            const data = await resp.json();

            if (!resp.ok) {
              this.errorMessage = data.error || 'Error al enviar la valoracion.';
              this.submitting = false;
              return;
            }

            this.submitted = true;
            this.submitting = false;
          } catch (e) {
            this.errorMessage = 'Error de conexion. Intentalo de nuevo.';
            this.submitting = false;
          }
        }
      };
    }
  </script>

</body>
</html>
