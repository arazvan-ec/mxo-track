{% extends 'base.html.twig' %}

{% block title %}Mis Rutas - MXO Track{% endblock %}

{% block breadcrumbs %}
  <li>
    <div class="flex items-center">
      <svg class="h-5 w-5 shrink-0" style="color: var(--color-text-muted);" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
      </svg>
      <span class="ml-2 text-sm font-medium" style="color: var(--color-text-secondary);">Mis Rutas</span>
    </div>
  </li>
{% endblock %}

{% block content %}
  {# ── Header ──────────────────────────────────────────────────────── #}
  <div class="mb-6">
    <h1 class="text-2xl font-bold" style="color: var(--color-text-primary);">Mis Rutas</h1>
    <p class="mt-1 text-sm" style="color: var(--color-text-secondary);">Hola, {{ app.user.email }}</p>
  </div>

  {# ── Summary pills ──────────────────────────────────────────────── #}
  {% set activeRoutes = routes|filter(r => r.status.value == 'ACTIVE') %}
  {% set doneRoutes = routes|filter(r => r.status.value == 'DONE') %}
  {% set plannedRoutes = routes|filter(r => r.status.value == 'PLANNED') %}
  {% set cancelledRoutes = routes|filter(r => r.status.value == 'CANCELLED') %}

  <div class="grid grid-cols-3 gap-3 mb-6">
    <div class="theme-card rounded-xl px-4 py-3 text-center">
      <p class="text-2xl font-bold" style="color: var(--color-text-primary);">{{ routes|length }}</p>
      <p class="text-xs mt-0.5" style="color: var(--color-text-secondary);">Total rutas</p>
    </div>
    <div class="rounded-xl shadow-sm border border-amber-200 px-4 py-3 text-center" style="background: var(--color-surface-elevated);">
      <p class="text-2xl font-bold text-amber-600">{{ activeRoutes|length }}</p>
      <p class="text-xs mt-0.5" style="color: var(--color-text-secondary);">Activas</p>
    </div>
    <div class="rounded-xl shadow-sm border border-green-200 px-4 py-3 text-center" style="background: var(--color-surface-elevated);">
      <p class="text-2xl font-bold text-green-600">{{ doneRoutes|length }}</p>
      <p class="text-xs mt-0.5" style="color: var(--color-text-secondary);">Completadas</p>
    </div>
  </div>

  {# ── Route cards ─────────────────────────────────────────────────── #}
  {% set sortedRoutes = activeRoutes|merge(plannedRoutes)|merge(doneRoutes)|merge(cancelledRoutes) %}

  {% if sortedRoutes|length == 0 %}
    <div class="theme-card rounded-xl px-6 py-12 text-center">
      <svg class="mx-auto h-12 w-12" style="color: var(--color-text-muted);" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/>
      </svg>
      <p class="mt-3 text-sm" style="color: var(--color-text-secondary);">No tienes rutas asignadas.</p>
    </div>
  {% else %}
    <div class="space-y-4">
      {% for route in sortedRoutes %}
        {% set counts = stopCounts[route.id] ?? {total: 0, delivered: 0, exceptions: 0} %}
        {% set pending = counts.total - counts.delivered - counts.exceptions %}

        <div x-data="{ loading: false }"
             class="rounded-xl shadow-sm border overflow-hidden
                    {% if route.status.value == 'ACTIVE' %}border-l-4 border-l-blue-500 border-t border-r border-b{% endif %}" style="background: var(--color-surface-elevated); border-color: var(--color-border);">

          <div class="px-4 py-4 sm:px-6">
            {# ── Card header: name + status ── #}
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0 flex-1">
                <h3 class="text-base font-semibold truncate" style="color: var(--color-text-primary);">{{ route.name }}</h3>
                <div class="mt-1 flex flex-wrap items-center gap-2 text-xs" style="color: var(--color-text-secondary);">
                  {% if route.customer %}
                    <span class="flex items-center gap-1">
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z"/>
                      </svg>
                      {{ route.customer.name|default('--') }}
                    </span>
                  {% endif %}
                  {% if route.vehicle %}
                    <span class="flex items-center gap-1">
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
                      </svg>
                      {{ route.vehicle.name }}
                    </span>
                  {% endif %}
                </div>
              </div>
              <div class="shrink-0">
                {% if route.status.value == 'PLANNED' %}
                  <span class="inline-flex rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-semibold text-blue-800">Planificada</span>
                {% elseif route.status.value == 'ACTIVE' %}
                  <span class="inline-flex rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-800">Activa</span>
                {% elseif route.status.value == 'DONE' %}
                  <span class="inline-flex rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-semibold text-green-800">Completada</span>
                {% elseif route.status.value == 'CANCELLED' %}
                  <span class="inline-flex rounded-full bg-red-100 px-2.5 py-0.5 text-xs font-semibold text-red-800">Cancelada</span>
                {% endif %}
              </div>
            </div>

            {# ── Progress bar ── #}
            {% if counts.total > 0 %}
              <div class="mt-3">
                <div class="flex items-center justify-between text-xs mb-1" style="color: var(--color-text-secondary);">
                  <span>Progreso</span>
                  <span>{{ counts.delivered }}/{{ counts.total }} entregas</span>
                </div>
                <div class="w-full rounded-full h-2 overflow-hidden" style="background: var(--color-surface);">
                  {% set deliveredPct = (counts.delivered / counts.total * 100)|round %}
                  {% set exceptionPct = (counts.exceptions / counts.total * 100)|round %}
                  <div class="h-2 rounded-full flex">
                    {% if deliveredPct > 0 %}
                      <div class="bg-green-500 h-2" style="width: {{ deliveredPct }}%"></div>
                    {% endif %}
                    {% if exceptionPct > 0 %}
                      <div class="bg-red-400 h-2" style="width: {{ exceptionPct }}%"></div>
                    {% endif %}
                  </div>
                </div>

                {# ── Stop count chips ── #}
                <div class="mt-2 flex flex-wrap gap-2">
                  {% if counts.delivered > 0 %}
                    <span class="inline-flex items-center gap-1 rounded-md bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700">
                      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
                      {{ counts.delivered }} entregadas
                    </span>
                  {% endif %}
                  {% if pending > 0 %}
                    <span class="inline-flex items-center gap-1 rounded-md bg-blue-50 px-2 py-0.5 text-xs font-medium text-blue-700">
                      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-13a.75.75 0 00-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 000-1.5h-3.25V5z" clip-rule="evenodd"/></svg>
                      {{ pending }} pendientes
                    </span>
                  {% endif %}
                  {% if counts.exceptions > 0 %}
                    <span class="inline-flex items-center gap-1 rounded-md bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700">
                      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/></svg>
                      {{ counts.exceptions }} excepciones
                    </span>
                  {% endif %}
                </div>
              </div>
            {% else %}
              <p class="mt-3 text-xs" style="color: var(--color-text-muted);">Sin paradas asignadas</p>
            {% endif %}

            {# ── Actions ── #}
            <div class="mt-4 flex flex-wrap gap-2">
              {% if route.status.value == 'PLANNED' %}
                <button
                  @click="if(!loading){ loading=true; fetch('/api/driver/routes/{{ route.publicIdString }}/start',{method:'POST',credentials:'include',headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'}}).then(r=>{if(r.ok){window.location.reload()}else{r.text().then(t=>{loading=false;alert('Error '+r.status+': '+t)})}}).catch(e=>{loading=false;alert('Error de conexion: '+e.message)}) }"
                  :disabled="loading"
                  class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                  <template x-if="loading">
                    <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                    </svg>
                  </template>
                  <template x-if="!loading">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 010 1.972l-11.54 6.347a1.125 1.125 0 01-1.667-.986V5.653z"/>
                    </svg>
                  </template>
                  Iniciar ruta
                </button>
              {% endif %}

              {% if route.status.value == 'ACTIVE' %}
                <button
                  @click="if(!loading && confirm('Seguro que quieres finalizar esta ruta?')){ loading=true; fetch('/api/driver/routes/{{ route.publicIdString }}/finish',{method:'POST',credentials:'include',headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'}}).then(r=>{if(r.ok){window.location.reload()}else{r.text().then(t=>{loading=false;alert('Error '+r.status+': '+t)})}}).catch(e=>{loading=false;alert('Error de conexion: '+e.message)}) }"
                  :disabled="loading"
                  class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                  <template x-if="loading">
                    <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                    </svg>
                  </template>
                  <template x-if="!loading">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  </template>
                  Finalizar ruta
                </button>
              {% endif %}

              <a href="{{ path('driver_routes_show', {publicId: route.publicIdString}) }}"
                 class="inline-flex items-center gap-1.5 rounded-lg px-4 py-2 text-sm font-semibold shadow-sm ring-1 ring-inset transition-colors" style="background: var(--color-surface-elevated); color: var(--color-text-secondary); --tw-ring-color: var(--color-border);">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                Ver ruta
              </a>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
{% endblock %}
