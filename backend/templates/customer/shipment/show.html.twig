{% extends 'base.html.twig' %}

{% block title %}Envio {{ shipment.reference }} - MXO Track{% endblock %}

{% block breadcrumbs %}
  <li>
    <div class="flex items-center">
      <svg class="h-5 w-5 shrink-0" style="color: var(--color-text-muted);" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
      </svg>
      <a href="{{ path('customer_dashboard') }}" class="ml-2 text-sm font-medium hover:opacity-80" style="color: var(--color-text-secondary);">Panel</a>
    </div>
  </li>
  <li>
    <div class="flex items-center">
      <svg class="h-5 w-5 shrink-0" style="color: var(--color-text-muted);" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
      </svg>
      <a href="{{ path('customer_shipments_index') }}" class="ml-2 text-sm font-medium hover:opacity-80" style="color: var(--color-text-secondary);">Envios</a>
    </div>
  </li>
  <li>
    <div class="flex items-center">
      <svg class="h-5 w-5 shrink-0" style="color: var(--color-text-muted);" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
      </svg>
      <span class="ml-2 text-sm font-medium" style="color: var(--color-text-secondary);">{{ shipment.reference }}</span>
    </div>
  </li>
{% endblock %}

{% block content %}
  {# ── Header ──────────────────────────────────────────────────────── #}
  <div class="mb-6">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold" style="color: var(--color-text-primary);">Envio {{ shipment.reference }}</h1>
      <a href="{{ path('customer_shipments_index') }}"
         class="inline-flex items-center rounded-md border px-3 py-2 text-sm font-medium" style="border-color: var(--color-border); background: var(--color-surface-elevated); color: var(--color-text-secondary);">
        Volver a envios
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    {# ── Info card ─────────────────────────────────────────────────── #}
    <div class="lg:col-span-1">
      <div class="theme-card rounded-xl overflow-hidden">
        <div class="px-5 py-4" style="border-bottom: 1px solid var(--color-border);">
          <h2 class="text-sm font-semibold" style="color: var(--color-text-primary);">Informacion del envio</h2>
        </div>
        <dl class="divide-y" style="border-color: var(--color-border);">
          <div class="px-5 py-3 flex justify-between">
            <dt class="text-sm" style="color: var(--color-text-secondary);">Referencia</dt>
            <dd class="text-sm font-medium" style="color: var(--color-text-primary);">{{ shipment.reference }}</dd>
          </div>
          <div class="px-5 py-3 flex justify-between">
            <dt class="text-sm" style="color: var(--color-text-secondary);">Destinatario</dt>
            <dd class="text-sm font-medium" style="color: var(--color-text-primary);">{{ shipment.recipientName ?? '-' }}</dd>
          </div>
          <div class="px-5 py-3 flex justify-between">
            <dt class="text-sm" style="color: var(--color-text-secondary);">Telefono</dt>
            <dd class="text-sm font-medium" style="color: var(--color-text-primary);">{{ shipment.recipientPhone ?? '-' }}</dd>
          </div>
          <div class="px-5 py-3">
            <dt class="text-sm mb-1" style="color: var(--color-text-secondary);">Direccion</dt>
            <dd class="text-sm font-medium" style="color: var(--color-text-primary);">{{ shipment.address ?? '-' }}</dd>
          </div>
          {% if shipment.latitude and shipment.longitude %}
            <div class="px-5 py-3 flex justify-between">
              <dt class="text-sm" style="color: var(--color-text-secondary);">Coordenadas</dt>
              <dd class="text-sm font-medium" style="color: var(--color-text-primary);">{{ shipment.latitude|number_format(5) }}, {{ shipment.longitude|number_format(5) }}</dd>
            </div>
          {% endif %}
          {% if shipment.notes %}
            <div class="px-5 py-3">
              <dt class="text-sm mb-1" style="color: var(--color-text-secondary);">Notas</dt>
              <dd class="text-sm" style="color: var(--color-text-secondary);">{{ shipment.notes }}</dd>
            </div>
          {% endif %}
          <div class="px-5 py-3 flex justify-between">
            <dt class="text-sm" style="color: var(--color-text-secondary);">Creado</dt>
            <dd class="text-sm font-medium" style="color: var(--color-text-primary);">{{ shipment.createdAt|date('d/m/Y H:i') }}</dd>
          </div>
        </dl>
      </div>
    </div>

    {# ── Timeline ──────────────────────────────────────────────────── #}
    <div class="lg:col-span-2">
      <div class="theme-card rounded-xl overflow-hidden">
        <div class="px-5 py-4" style="border-bottom: 1px solid var(--color-border);">
          <h2 class="text-sm font-semibold" style="color: var(--color-text-primary);">Historial de eventos</h2>
        </div>

        {% if events|length > 0 %}
          <div class="p-5">
            <div class="relative">
              {# Vertical line #}
              <div class="absolute left-4 top-0 bottom-0 w-0.5" style="background: var(--color-border);"></div>

              {% for event in events %}
                {# Determine color based on event type #}
                {% set event_bg = 'bg-gray-400' %}
                {% set event_ring = 'ring-gray-100' %}
                {% if event.eventType.value == 'CREATED' %}
                  {% set event_bg = 'bg-gray-500' %}
                  {% set event_ring = 'ring-gray-50' %}
                {% elseif event.eventType.value == 'PICKED_UP' %}
                  {% set event_bg = 'bg-blue-500' %}
                  {% set event_ring = 'ring-blue-50' %}
                {% elseif event.eventType.value == 'IN_HUB' %}
                  {% set event_bg = 'bg-indigo-500' %}
                  {% set event_ring = 'ring-indigo-50' %}
                {% elseif event.eventType.value == 'IN_TRANSIT' %}
                  {% set event_bg = 'bg-cyan-500' %}
                  {% set event_ring = 'ring-cyan-50' %}
                {% elseif event.eventType.value == 'OUT_FOR_DELIVERY' %}
                  {% set event_bg = 'bg-amber-500' %}
                  {% set event_ring = 'ring-amber-50' %}
                {% elseif event.eventType.value == 'DELIVERED' %}
                  {% set event_bg = 'bg-green-500' %}
                  {% set event_ring = 'ring-green-50' %}
                {% elseif event.eventType.value == 'EXCEPTION' %}
                  {% set event_bg = 'bg-red-500' %}
                  {% set event_ring = 'ring-red-50' %}
                {% endif %}

                {# Translate event type #}
                {% set event_label = event.eventType.value %}
                {% if event.eventType.value == 'CREATED' %}
                  {% set event_label = 'Creado' %}
                {% elseif event.eventType.value == 'PICKED_UP' %}
                  {% set event_label = 'Recogido' %}
                {% elseif event.eventType.value == 'IN_HUB' %}
                  {% set event_label = 'En centro' %}
                {% elseif event.eventType.value == 'IN_TRANSIT' %}
                  {% set event_label = 'En transito' %}
                {% elseif event.eventType.value == 'OUT_FOR_DELIVERY' %}
                  {% set event_label = 'En reparto' %}
                {% elseif event.eventType.value == 'DELIVERED' %}
                  {% set event_label = 'Entregado' %}
                {% elseif event.eventType.value == 'EXCEPTION' %}
                  {% set event_label = 'Excepcion' %}
                {% endif %}

                <div class="relative flex items-start mb-6 last:mb-0">
                  {# Circle indicator #}
                  <div class="absolute left-4 -translate-x-1/2 w-8 h-8 rounded-full {{ event_bg }} ring-4 {{ event_ring }} flex items-center justify-center z-10">
                    {% if event.eventType.value == 'CREATED' %}
                      <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                      </svg>
                    {% elseif event.eventType.value == 'PICKED_UP' %}
                      <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l7.5-7.5 7.5 7.5m-15 6l7.5-7.5 7.5 7.5"/>
                      </svg>
                    {% elseif event.eventType.value == 'IN_HUB' %}
                      <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z"/>
                      </svg>
                    {% elseif event.eventType.value == 'IN_TRANSIT' %}
                      <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
                      </svg>
                    {% elseif event.eventType.value == 'OUT_FOR_DELIVERY' %}
                      <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
                      </svg>
                    {% elseif event.eventType.value == 'DELIVERED' %}
                      <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                      </svg>
                    {% elseif event.eventType.value == 'EXCEPTION' %}
                      <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
                      </svg>
                    {% else %}
                      <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"/>
                      </svg>
                    {% endif %}
                  </div>

                  {# Event content #}
                  <div class="ml-12 rounded-lg border p-4 flex-1" style="background: var(--color-surface); border-color: var(--color-border);">
                    <div class="flex items-center justify-between">
                      <p class="text-sm font-semibold" style="color: var(--color-text-primary);">{{ event_label }}</p>
                      <p class="text-xs" style="color: var(--color-text-secondary);">{{ event.createdAt|date('d/m/Y H:i:s') }}</p>
                    </div>
                    {% if event.payload|length > 0 %}
                      <div class="mt-2 text-xs" style="color: var(--color-text-secondary);">
                        {% for key, value in event.payload %}
                          {% if key != 'ai_classification' %}
                            <span class="inline-block rounded px-2 py-0.5 border mr-1 mb-1" style="background: var(--color-surface-elevated); border-color: var(--color-border);">
                              <span style="color: var(--color-text-muted);">{{ key }}:</span> {{ value }}
                            </span>
                          {% endif %}
                        {% endfor %}
                      </div>
                    {% endif %}

                    {# AI Classification for exception events #}
                    {% if event.eventType.value == 'EXCEPTION' and event.payload.ai_classification is defined %}
                      {% set ai = event.payload.ai_classification %}
                      <div class="mt-3 bg-purple-50 border border-purple-200 rounded-lg p-3">
                        <div class="flex items-center gap-2 mb-2">
                          <svg class="w-4 h-4 text-purple-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z"/>
                          </svg>
                          <span class="text-xs font-semibold text-purple-700">Clasificacion IA</span>
                          {% if ai.confidence is defined %}
                            <span class="text-xs text-purple-500">({{ (ai.confidence * 100)|number_format(0) }}% confianza)</span>
                          {% endif %}
                        </div>
                        {% if ai.subcategory is defined %}
                          <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium
                            {% if ai.subcategory == 'ACCESO_EDIFICIO' %}bg-yellow-100 text-yellow-800
                            {% elseif ai.subcategory == 'DIRECCION_INCOMPLETA' %}bg-orange-100 text-orange-800
                            {% elseif ai.subcategory == 'AUSENCIA_RECURRENTE' %}bg-red-100 text-red-800
                            {% elseif ai.subcategory == 'RECHAZO_ESTADO' %}bg-pink-100 text-pink-800
                            {% elseif ai.subcategory == 'HORARIO_INCOMPATIBLE' %}bg-blue-100 text-blue-800
                            {% elseif ai.subcategory == 'PAQUETE_DANADO' %}bg-amber-100 text-amber-800
                            {% elseif ai.subcategory == 'DIRECCION_NO_ENCONTRADA' %}bg-gray-100 text-gray-800
                            {% elseif ai.subcategory == 'DESTINATARIO_DESCONOCIDO' %}bg-indigo-100 text-indigo-800
                            {% else %}bg-gray-100 text-gray-700
                            {% endif %}">
                            {{ ai.subcategory|replace({'_': ' '}) }}
                          </span>
                        {% endif %}
                        {% if ai.actionable_insight is defined and ai.actionable_insight %}
                          <p class="mt-2 text-xs text-purple-700">{{ ai.actionable_insight }}</p>
                        {% endif %}
                        {% if ai.suggested_action is defined and ai.suggested_action %}
                          <p class="mt-1 text-xs text-purple-600 italic">{{ ai.suggested_action }}</p>
                        {% endif %}
                      </div>
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        {% else %}
          <div class="px-5 py-8 text-center">
            <svg class="mx-auto h-10 w-10" style="color: var(--color-text-muted);" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <p class="mt-2 text-sm" style="color: var(--color-text-secondary);">No hay eventos registrados para este envio.</p>
          </div>
        {% endif %}
      </div>
    </div>

  </div>
{% endblock %}
