{% extends 'base.html.twig' %}

{% block title %}Mis envios - MXO Track{% endblock %}

{% block breadcrumbs %}
  <li>
    <div class="flex items-center">
      <svg class="h-5 w-5 shrink-0 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
      </svg>
      <a href="{{ path('customer_dashboard') }}" class="ml-2 text-sm font-medium text-gray-500 hover:text-gray-700">Panel</a>
    </div>
  </li>
  <li>
    <div class="flex items-center">
      <svg class="h-5 w-5 shrink-0 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
      </svg>
      <span class="ml-2 text-sm font-medium text-gray-500">Envios</span>
    </div>
  </li>
{% endblock %}

{% block content %}
  {# ── Header ──────────────────────────────────────────────────────── #}
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Mis envios</h1>
  </div>

  {# ── Filters ─────────────────────────────────────────────────────── #}
  <div class="mb-6 rounded-lg bg-white p-4 shadow ring-1 ring-gray-200">
    <form action="{{ path('customer_shipments_index') }}" method="GET" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {# Search #}
      <div>
        <label for="q" class="block text-xs font-medium text-gray-600 mb-1">Buscar</label>
        <input type="text" name="q" id="q" value="{{ searchQuery }}" placeholder="Referencia o destinatario..."
               class="block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500">
      </div>

      {# Status #}
      <div>
        <label for="status" class="block text-xs font-medium text-gray-600 mb-1">Estado</label>
        <select name="status" id="status"
                class="block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500">
          <option value="">Todos</option>
          <option value="CREATED" {% if statusFilter == 'CREATED' %}selected{% endif %}>Creado</option>
          <option value="PICKED_UP" {% if statusFilter == 'PICKED_UP' %}selected{% endif %}>Recogido</option>
          <option value="IN_HUB" {% if statusFilter == 'IN_HUB' %}selected{% endif %}>En centro</option>
          <option value="IN_TRANSIT" {% if statusFilter == 'IN_TRANSIT' %}selected{% endif %}>En transito</option>
          <option value="OUT_FOR_DELIVERY" {% if statusFilter == 'OUT_FOR_DELIVERY' %}selected{% endif %}>En reparto</option>
          <option value="DELIVERED" {% if statusFilter == 'DELIVERED' %}selected{% endif %}>Entregado</option>
          <option value="EXCEPTION" {% if statusFilter == 'EXCEPTION' %}selected{% endif %}>Excepcion</option>
        </select>
      </div>

      {# Date from #}
      <div>
        <label for="date_from" class="block text-xs font-medium text-gray-600 mb-1">Desde</label>
        <input type="date" name="date_from" id="date_from" value="{{ dateFrom }}"
               class="block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500">
      </div>

      {# Date to #}
      <div>
        <label for="date_to" class="block text-xs font-medium text-gray-600 mb-1">Hasta</label>
        <input type="date" name="date_to" id="date_to" value="{{ dateTo }}"
               class="block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500">
      </div>

      {# Buttons #}
      <div class="flex items-end gap-2">
        <button type="submit"
                class="inline-flex items-center rounded-md bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-500">
          Filtrar
        </button>
        <a href="{{ path('customer_shipments_index') }}"
           class="inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
          Limpiar
        </a>
      </div>
    </form>
  </div>

  {# ── Table ───────────────────────────────────────────────────────── #}
  <div class="bg-white shadow rounded-lg overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Referencia</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Destinatario</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Direccion</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Estado</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Fecha</th>
          <th scope="col" class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 bg-white">
        {% for shipment in shipments %}
          {% set latestEvent = latestEvents[shipment.id] ?? null %}
          <tr>
            <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900">
              {{ shipment.reference }}
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
              {{ shipment.recipientName ?? '-' }}
            </td>
            <td class="px-6 py-4 text-sm text-gray-500 max-w-xs truncate">
              {{ shipment.address ?? '-' }}
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm">
              {% if latestEvent is not null %}
                {% if latestEvent.value == 'CREATED' %}
                  <span class="inline-flex rounded-full bg-gray-100 px-2 text-xs font-semibold leading-5 text-gray-800">Creado</span>
                {% elseif latestEvent.value == 'PICKED_UP' %}
                  <span class="inline-flex rounded-full bg-blue-100 px-2 text-xs font-semibold leading-5 text-blue-800">Recogido</span>
                {% elseif latestEvent.value == 'IN_HUB' %}
                  <span class="inline-flex rounded-full bg-indigo-100 px-2 text-xs font-semibold leading-5 text-indigo-800">En centro</span>
                {% elseif latestEvent.value == 'IN_TRANSIT' %}
                  <span class="inline-flex rounded-full bg-cyan-100 px-2 text-xs font-semibold leading-5 text-cyan-800">En transito</span>
                {% elseif latestEvent.value == 'OUT_FOR_DELIVERY' %}
                  <span class="inline-flex rounded-full bg-amber-100 px-2 text-xs font-semibold leading-5 text-amber-800">En reparto</span>
                {% elseif latestEvent.value == 'DELIVERED' %}
                  <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Entregado</span>
                {% elseif latestEvent.value == 'EXCEPTION' %}
                  <span class="inline-flex rounded-full bg-red-100 px-2 text-xs font-semibold leading-5 text-red-800">Excepcion</span>
                {% endif %}
              {% else %}
                <span class="inline-flex rounded-full bg-gray-100 px-2 text-xs font-semibold leading-5 text-gray-500">Sin eventos</span>
              {% endif %}
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
              {{ shipment.createdAt|date('d/m/Y H:i') }}
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
              <a href="{{ path('customer_shipments_show', {publicId: shipment.publicIdString}) }}"
                 class="text-brand-600 hover:text-brand-500">Ver</a>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="6" class="px-6 py-8 text-center text-sm text-gray-500">
              No hay envios registrados.
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {# ── Pagination ──────────────────────────────────────────────────── #}
  {% if totalPages > 1 %}
    <nav class="mt-6 flex items-center justify-between">
      <div class="text-sm text-gray-700">
        Pagina {{ page }} de {{ totalPages }}
      </div>
      <div class="flex space-x-2">
        {% if page > 1 %}
          <a href="{{ path('customer_shipments_index', filterParams|merge({page: page - 1})) }}"
             class="inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
            Anterior
          </a>
        {% endif %}
        {% if page < totalPages %}
          <a href="{{ path('customer_shipments_index', filterParams|merge({page: page + 1})) }}"
             class="inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
            Siguiente
          </a>
        {% endif %}
      </div>
    </nav>
  {% endif %}
{% endblock %}
