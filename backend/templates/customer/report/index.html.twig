{% extends 'base.html.twig' %}

{% block title %}Mis Reportes - MXO Track{% endblock %}

{% block breadcrumbs %}
  <li>
    <div class="flex items-center">
      <svg class="h-5 w-5 shrink-0" style="color: var(--color-text-muted);" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
      </svg>
      <span class="ml-2 text-sm font-medium" style="color: var(--color-text-secondary);">Mis Reportes</span>
    </div>
  </li>
{% endblock %}

{% block content %}
<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h1 class="text-2xl font-bold tracking-tight" style="color: var(--color-text-primary);">Mis Reportes</h1>
    <p class="mt-1 text-sm" style="color: var(--color-text-secondary);">Resumen de entregas y envios de {{ customer.name }}.</p>
  </div>
  <div class="flex items-center gap-2">
    <a href="{{ path('customer_reports_export', {from: from|date('Y-m-d'), to: to|date('Y-m-d')}) }}"
       class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium shadow-sm ring-1 transition-colors" style="background: var(--color-surface-elevated); color: var(--color-text-secondary); --tw-ring-color: var(--color-border);">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/>
      </svg>
      Exportar CSV
    </a>
  </div>
</div>

{# Date filter #}
<form method="get" class="mb-8 flex flex-wrap items-end gap-3">
  <div>
    <label for="from" class="block text-xs font-medium mb-1" style="color: var(--color-text-secondary);">Desde</label>
    <input type="date" id="from" name="from" value="{{ from|date('Y-m-d') }}"
           class="rounded-lg px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500" style="border-color: var(--color-border);">
  </div>
  <div>
    <label for="to" class="block text-xs font-medium mb-1" style="color: var(--color-text-secondary);">Hasta</label>
    <input type="date" id="to" name="to" value="{{ to|date('Y-m-d') }}"
           class="rounded-lg px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500" style="border-color: var(--color-border);">
  </div>
  <button type="submit"
          class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-brand-500 transition-colors">
    Filtrar
  </button>
</form>

{# Summary cards #}
<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-5 mb-8">
  <div class="rounded-xl p-6 shadow-sm ring-1" style="background: var(--color-surface-elevated); --tw-ring-color: var(--color-border);">
    <p class="text-sm font-medium" style="color: var(--color-text-secondary);">Total envios</p>
    <p class="mt-2 text-3xl font-bold" style="color: var(--color-text-primary);">{{ report.total_shipments }}</p>
  </div>
  <div class="rounded-xl p-6 shadow-sm ring-1" style="background: var(--color-surface-elevated); --tw-ring-color: var(--color-border);">
    <p class="text-sm font-medium" style="color: var(--color-text-secondary);">Entregados</p>
    <p class="mt-2 text-3xl font-bold text-emerald-600">{{ report.delivered }}</p>
  </div>
  <div class="rounded-xl p-6 shadow-sm ring-1" style="background: var(--color-surface-elevated); --tw-ring-color: var(--color-border);">
    <p class="text-sm font-medium" style="color: var(--color-text-secondary);">Excepciones</p>
    <p class="mt-2 text-3xl font-bold text-red-600">{{ report.exceptions }}</p>
  </div>
  <div class="rounded-xl p-6 shadow-sm ring-1" style="background: var(--color-surface-elevated); --tw-ring-color: var(--color-border);">
    <p class="text-sm font-medium" style="color: var(--color-text-secondary);">Pendientes</p>
    <p class="mt-2 text-3xl font-bold text-amber-600">{{ report.pending }}</p>
  </div>
  <div class="rounded-xl p-6 shadow-sm ring-1" style="background: var(--color-surface-elevated); --tw-ring-color: var(--color-border);">
    <p class="text-sm font-medium" style="color: var(--color-text-secondary);">Completado</p>
    <p class="mt-2 text-3xl font-bold text-brand-600">{{ report.completion_rate }}%</p>
  </div>
</div>

{# Progress visualization #}
{% set total_stops = report.delivered + report.exceptions + report.pending %}
{% if total_stops > 0 %}
<div class="rounded-xl p-6 shadow-sm ring-1 mb-8" style="background: var(--color-surface-elevated); --tw-ring-color: var(--color-border);">
  <h3 class="text-base font-semibold mb-4" style="color: var(--color-text-primary);">Progreso general</h3>
  <div class="flex h-4 overflow-hidden rounded-full" style="background: var(--color-surface);">
    {% if report.delivered > 0 %}
      <div class="bg-emerald-500 transition-all" style="width: {{ (report.delivered / total_stops * 100)|round(1) }}%"></div>
    {% endif %}
    {% if report.exceptions > 0 %}
      <div class="bg-red-500 transition-all" style="width: {{ (report.exceptions / total_stops * 100)|round(1) }}%"></div>
    {% endif %}
    {% if report.pending > 0 %}
      <div class="bg-amber-400 transition-all" style="width: {{ (report.pending / total_stops * 100)|round(1) }}%"></div>
    {% endif %}
  </div>
  <div class="mt-3 flex flex-wrap gap-4 text-xs" style="color: var(--color-text-secondary);">
    <span class="flex items-center gap-1.5">
      <span class="inline-block h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
      Entregados ({{ report.delivered }})
    </span>
    <span class="flex items-center gap-1.5">
      <span class="inline-block h-2.5 w-2.5 rounded-full bg-red-500"></span>
      Excepciones ({{ report.exceptions }})
    </span>
    <span class="flex items-center gap-1.5">
      <span class="inline-block h-2.5 w-2.5 rounded-full bg-amber-400"></span>
      Pendientes ({{ report.pending }})
    </span>
  </div>
</div>
{% endif %}

{# Pie chart #}
{% if total_stops > 0 %}
<div class="grid grid-cols-1 gap-6 lg:grid-cols-2 mb-8">
  <div class="rounded-xl p-6 shadow-sm ring-1" style="background: var(--color-surface-elevated); --tw-ring-color: var(--color-border);">
    <h3 class="text-base font-semibold mb-4" style="color: var(--color-text-primary);">Distribucion de estados</h3>
    <div class="relative mx-auto" style="height: 280px; max-width: 320px;">
      <canvas id="customerPieChart"></canvas>
    </div>
  </div>

  {# By driver table #}
  <div class="rounded-xl shadow-sm ring-1 overflow-hidden" style="background: var(--color-surface-elevated); --tw-ring-color: var(--color-border);">
    <div class="px-6 py-4" style="border-bottom: 1px solid var(--color-border);">
      <h3 class="text-base font-semibold" style="color: var(--color-text-primary);">Por transportista</h3>
    </div>
    {% if delivery_report.by_driver|length > 0 %}
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y" style="border-color: var(--color-border);">
          <thead style="background: var(--color-surface);">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Transportista</th>
              <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Entregas</th>
              <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Excepciones</th>
            </tr>
          </thead>
          <tbody class="divide-y" style="border-color: var(--color-border);">
            {% for row in delivery_report.by_driver %}
              <tr class="transition-colors">
                <td class="whitespace-nowrap px-6 py-4 text-sm font-medium" style="color: var(--color-text-primary);">{{ row.driver_name }}</td>
                <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium text-emerald-600">{{ row.deliveries }}</td>
                <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium text-red-600">{{ row.exceptions }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      <div class="px-6 py-12 text-center text-sm" style="color: var(--color-text-secondary);">
        No hay datos de transportistas para el periodo seleccionado.
      </div>
    {% endif %}
  </div>
</div>
{% endif %}

{% if total_stops > 0 %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const ctx = document.getElementById('customerPieChart');
  if (ctx) {
    new Chart(ctx, {
      type: 'pie',
      data: {
        labels: ['Entregados', 'Excepciones', 'Pendientes'],
        datasets: [{
          data: [{{ report.delivered }}, {{ report.exceptions }}, {{ report.pending }}],
          backgroundColor: ['#10b981', '#ef4444', '#f59e0b'],
          borderWidth: 2,
          borderColor: '#fff',
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom' }
        }
      }
    });
  }
});
</script>
{% endif %}
{% endblock %}
