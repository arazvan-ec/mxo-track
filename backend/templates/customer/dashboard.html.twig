{% extends 'base.html.twig' %}

{% block title %}Panel de control - {{ customer.name }}{% endblock %}

{% block breadcrumbs %}
  <li>
    <div class="flex items-center">
      <svg class="h-5 w-5 shrink-0 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
      </svg>
      <span class="ml-2 text-sm font-medium text-gray-500">Panel de control</span>
    </div>
  </li>
{% endblock %}

{% block content %}
<div x-data="customerDashboard()" x-init="init()">

  {# ── Header ──────────────────────────────────────────────────────── #}
  <div class="mb-8 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Panel de control</h1>
      <p class="mt-1 text-sm text-gray-500">{{ customer.name }}</p>
    </div>
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-2 rounded-full bg-gray-50 px-3 py-1.5 ring-1 ring-gray-200">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full opacity-75"
                :class="sseConnected ? 'bg-emerald-400' : 'bg-gray-400'"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full"
                :class="sseConnected ? 'bg-emerald-500' : 'bg-gray-400'"></span>
        </span>
        <span class="text-xs font-medium text-gray-600" x-text="sseConnected ? 'En vivo' : 'Conectando...'"></span>
      </div>
      <span class="text-xs text-gray-400" x-text="lastRefresh ? 'Actualizado ' + lastRefresh : ''"></span>
    </div>
  </div>

  {# ── KPI Cards ───────────────────────────────────────────────────── #}
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 mb-8">

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">Envios totales</p>
          <p class="text-3xl font-bold text-gray-900 mt-1 transition-all duration-500" x-text="kpis.total_shipments"></p>
        </div>
        <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/>
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">Rutas activas</p>
          <p class="text-3xl font-bold text-gray-900 mt-1 transition-all duration-500" x-text="kpis.active_routes"></p>
        </div>
        <div class="w-12 h-12 bg-amber-50 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-amber-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">Entregas pendientes</p>
          <p class="text-3xl font-bold text-gray-900 mt-1 transition-all duration-500" x-text="kpis.pending_deliveries"></p>
        </div>
        <div class="w-12 h-12 bg-slate-50 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-slate-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">Completadas hoy</p>
          <p class="text-3xl font-bold text-gray-900 mt-1 transition-all duration-500" x-text="kpis.completed_today"></p>
        </div>
        <div class="w-12 h-12 bg-green-50 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">Excepciones</p>
          <p class="text-3xl font-bold text-gray-900 mt-1 transition-all duration-500" x-text="kpis.exceptions"></p>
        </div>
        <div class="w-12 h-12 bg-rose-50 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-rose-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
          </svg>
        </div>
      </div>
    </div>

  </div>

  {# ── Active Routes Section ───────────────────────────────────────── #}
  <div class="mb-8">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-gray-900">Rutas activas</h2>
      <a href="{{ path('customer_routes_index', {status: 'ACTIVE'}) }}"
         class="text-sm font-medium text-brand-600 hover:text-brand-500">
        Ver todas
      </a>
    </div>

    {% if activeRoutes|length > 0 %}
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {% for route in activeRoutes %}
          {% set progress = activeRouteProgress[route.id] ?? {total: 0, delivered: 0} %}
          <a href="{{ path('customer_routes_show', {publicId: route.publicIdString}) }}"
             class="block bg-white rounded-xl shadow-sm border border-gray-100 p-5 hover:shadow-md transition-shadow">
            <div class="flex items-start justify-between mb-3">
              <div>
                <h3 class="text-sm font-semibold text-gray-900">{{ route.name }}</h3>
                <p class="text-xs text-gray-500 mt-0.5">
                  {% if route.vehicle %}{{ route.vehicle.name }}{% else %}Sin vehiculo{% endif %}
                  {% if route.driver %} &middot; {{ route.driver.email }}{% endif %}
                </p>
              </div>
              <span class="inline-flex rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800">Activa</span>
            </div>

            {% if progress.total > 0 %}
              <div class="mt-3">
                <div class="flex items-center justify-between text-xs text-gray-500 mb-1">
                  <span>Progreso</span>
                  <span>{{ progress.delivered }}/{{ progress.total }} entregas</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                  <div class="bg-green-500 h-2 rounded-full transition-all" style="width: {{ (progress.delivered / progress.total * 100)|round }}%"></div>
                </div>
              </div>
            {% else %}
              <p class="mt-3 text-xs text-gray-400">Sin paradas asignadas</p>
            {% endif %}
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8 text-center">
        <svg class="mx-auto h-10 w-10 text-gray-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
        </svg>
        <p class="mt-2 text-sm text-gray-500">No hay rutas activas en este momento.</p>
      </div>
    {% endif %}
  </div>

  {# ── Quick Links ─────────────────────────────────────────────────── #}
  <div>
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Acceso rapido</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">

      <a href="{{ path('customer_routes_index') }}"
         class="flex items-center gap-4 bg-white rounded-xl shadow-sm border border-gray-100 p-5 hover:shadow-md transition-shadow">
        <div class="w-10 h-10 bg-amber-50 rounded-lg flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-gray-900">Ver rutas</p>
          <p class="text-xs text-gray-500">Todas las rutas asignadas</p>
        </div>
      </a>

      <a href="{{ path('customer_shipments_index') }}"
         class="flex items-center gap-4 bg-white rounded-xl shadow-sm border border-gray-100 p-5 hover:shadow-md transition-shadow">
        <div class="w-10 h-10 bg-blue-50 rounded-lg flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-gray-900">Ver envios</p>
          <p class="text-xs text-gray-500">Historial de envios</p>
        </div>
      </a>

      <a href="{{ path('fleet_map') }}"
         class="flex items-center gap-4 bg-white rounded-xl shadow-sm border border-gray-100 p-5 hover:shadow-md transition-shadow">
        <div class="w-10 h-10 bg-green-50 rounded-lg flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-gray-900">Mapa en vivo</p>
          <p class="text-xs text-gray-500">Posicion de vehiculos</p>
        </div>
      </a>

    </div>
  </div>

</div>

<script>
function customerDashboard() {
  return {
    kpis: {
      total_shipments: {{ kpis.total_shipments }},
      active_routes: {{ kpis.active_routes }},
      pending_deliveries: {{ kpis.pending_deliveries }},
      completed_today: {{ kpis.completed_today }},
      exceptions: {{ kpis.exceptions }},
    },
    sseConnected: false,
    lastRefresh: null,
    _refreshInterval: null,
    _eventSource: null,

    async init() {
      this._refreshInterval = setInterval(() => this._refreshKpis(), 30000);
      this._connectSSE();
      window.addEventListener('beforeunload', () => this._cleanup());
    },

    async _connectSSE() {
      try {
        await fetch('/api/mercure-token', { credentials: 'include' });
        const res = await fetch('/api/vehicles', { credentials: 'include' });
        if (!res.ok) return;

        const data = await res.json();
        const vehicles = data.items || [];
        if (vehicles.length === 0) return;

        const hub = new URL('{{ mercure_public_url }}');
        vehicles.forEach(v => {
          hub.searchParams.append('topic', '/vehicles/' + v.public_id + '/position');
        });

        this._eventSource = new EventSource(hub, { withCredentials: true });
        this._eventSource.onopen = () => { this.sseConnected = true; };
        this._eventSource.onerror = () => { this.sseConnected = false; };

        let debounce = null;
        this._eventSource.onmessage = () => {
          this.sseConnected = true;
          if (debounce) clearTimeout(debounce);
          debounce = setTimeout(() => this._refreshKpis(), 5000);
        };
      } catch (_) {}
    },

    async _refreshKpis() {
      try {
        const res = await fetch('/customer/dashboard/kpis', { credentials: 'include' });
        if (res.ok) {
          const data = await res.json();
          this.kpis.total_shipments = data.total_shipments ?? this.kpis.total_shipments;
          this.kpis.active_routes = data.active_routes ?? this.kpis.active_routes;
          this.kpis.pending_deliveries = data.pending_deliveries ?? this.kpis.pending_deliveries;
          this.kpis.completed_today = data.completed_today ?? this.kpis.completed_today;
          this.kpis.exceptions = data.exceptions ?? this.kpis.exceptions;
          const now = new Date();
          this.lastRefresh = now.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
        }
      } catch (_) {}
    },

    _cleanup() {
      if (this._eventSource) { this._eventSource.close(); }
      if (this._refreshInterval) { clearInterval(this._refreshInterval); }
    }
  };
}
</script>

{% endblock %}
