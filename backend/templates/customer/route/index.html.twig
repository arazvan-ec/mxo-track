{% extends 'base.html.twig' %}

{% block title %}Mis rutas - MXO Track{% endblock %}

{% block breadcrumbs %}
  <li>
    <div class="flex items-center">
      <svg class="h-5 w-5 shrink-0" style="color: var(--color-text-muted);" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
      </svg>
      <a href="{{ path('customer_dashboard') }}" class="ml-2 text-sm font-medium hover:opacity-80" style="color: var(--color-text-secondary);">Panel</a>
    </div>
  </li>
  <li>
    <div class="flex items-center">
      <svg class="h-5 w-5 shrink-0" style="color: var(--color-text-muted);" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
      </svg>
      <span class="ml-2 text-sm font-medium" style="color: var(--color-text-secondary);">Rutas</span>
    </div>
  </li>
{% endblock %}

{% block content %}
  {# ── Header ──────────────────────────────────────────────────────── #}
  <div class="mb-6">
    <h1 class="text-2xl font-bold" style="color: var(--color-text-primary);">Mis rutas</h1>
  </div>

  {# ── Status filter tabs ──────────────────────────────────────────── #}
  <div class="mb-6 border-b" style="border-color: var(--color-border);">
    <nav class="-mb-px flex space-x-6" aria-label="Filtros">
      <a href="{{ path('customer_routes_index') }}"
         class="whitespace-nowrap border-b-2 pb-3 px-1 text-sm font-medium {% if currentStatus == '' %}border-blue-500 text-blue-600{% else %}border-transparent hover:opacity-80{% endif %}" {% if currentStatus != '' %}style="color: var(--color-text-secondary);"{% endif %}>
        Todas
      </a>
      <a href="{{ path('customer_routes_index', {status: 'PLANNED'}) }}"
         class="whitespace-nowrap border-b-2 pb-3 px-1 text-sm font-medium {% if currentStatus == 'PLANNED' %}border-blue-500 text-blue-600{% else %}border-transparent hover:opacity-80{% endif %}" {% if currentStatus != 'PLANNED' %}style="color: var(--color-text-secondary);"{% endif %}>
        Planificadas
      </a>
      <a href="{{ path('customer_routes_index', {status: 'ACTIVE'}) }}"
         class="whitespace-nowrap border-b-2 pb-3 px-1 text-sm font-medium {% if currentStatus == 'ACTIVE' %}border-amber-500 text-amber-600{% else %}border-transparent hover:opacity-80{% endif %}" {% if currentStatus != 'ACTIVE' %}style="color: var(--color-text-secondary);"{% endif %}>
        Activas
      </a>
      <a href="{{ path('customer_routes_index', {status: 'DONE'}) }}"
         class="whitespace-nowrap border-b-2 pb-3 px-1 text-sm font-medium {% if currentStatus == 'DONE' %}border-green-500 text-green-600{% else %}border-transparent hover:opacity-80{% endif %}" {% if currentStatus != 'DONE' %}style="color: var(--color-text-secondary);"{% endif %}>
        Completadas
      </a>
      <a href="{{ path('customer_routes_index', {status: 'CANCELLED'}) }}"
         class="whitespace-nowrap border-b-2 pb-3 px-1 text-sm font-medium {% if currentStatus == 'CANCELLED' %}border-red-500 text-red-600{% else %}border-transparent hover:opacity-80{% endif %}" {% if currentStatus != 'CANCELLED' %}style="color: var(--color-text-secondary);"{% endif %}>
        Canceladas
      </a>
    </nav>
  </div>

  {# ── Table ───────────────────────────────────────────────────────── #}
  <div class="theme-card overflow-x-auto">
    <table class="min-w-full divide-y" style="border-color: var(--color-border);">
      <thead style="background: var(--color-surface);">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Nombre</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Vehiculo</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Transportista</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Estado</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Progreso</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Optimizacion</th>
          <th scope="col" class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y" style="border-color: var(--color-border); background: var(--color-surface-elevated);">
        {% for route in routes %}
          {% set counts = stopCounts[route.id] ?? {total: 0, delivered: 0} %}
          <tr>
            <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900">
              {{ route.name }}
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
              {{ route.vehicle ? route.vehicle.name : '-' }}
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
              {{ route.driver ? route.driver.email : '-' }}
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm">
              {% if route.status.value == 'PLANNED' %}
                <span class="inline-flex rounded-full bg-blue-100 px-2 text-xs font-semibold leading-5 text-blue-800">Planificada</span>
              {% elseif route.status.value == 'ACTIVE' %}
                <span class="inline-flex rounded-full bg-amber-100 px-2 text-xs font-semibold leading-5 text-amber-800">Activa</span>
              {% elseif route.status.value == 'DONE' %}
                <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Completada</span>
              {% elseif route.status.value == 'CANCELLED' %}
                <span class="inline-flex rounded-full bg-red-100 px-2 text-xs font-semibold leading-5 text-red-800">Cancelada</span>
              {% endif %}
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
              {% if counts.total > 0 %}
                <div class="flex items-center space-x-2">
                  <div class="w-24 bg-gray-200 rounded-full h-2">
                    <div class="bg-green-500 h-2 rounded-full" style="width: {{ (counts.delivered / counts.total * 100)|round }}%"></div>
                  </div>
                  <span class="text-xs text-gray-600">{{ counts.delivered }}/{{ counts.total }} entregas</span>
                </div>
              {% else %}
                <span class="text-xs text-gray-400">Sin paradas</span>
              {% endif %}
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
              {% set metric = routeMetrics[route.id] ?? null %}
              {% if metric %}
                <div class="flex flex-col space-y-1">
                  {% if metric.kmSaved is not null %}
                    <span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700">
                      {{ metric.kmSaved|number_format(1) }} km
                    </span>
                  {% endif %}
                  {% if metric.timeSavedMinutes is not null %}
                    <span class="inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-700">
                      {{ metric.timeSavedMinutes }} min
                    </span>
                  {% endif %}
                  {% if metric.deliverySuccessRate is not null %}
                    <span class="inline-flex items-center rounded-full bg-purple-100 px-2 py-0.5 text-xs font-medium text-purple-700">
                      {{ metric.deliverySuccessRate|number_format(0) }}% entrega
                    </span>
                  {% endif %}
                </div>
              {% else %}
                <span class="text-xs text-gray-400">-</span>
              {% endif %}
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
              <a href="{{ path('customer_routes_show', {publicId: route.publicIdString}) }}"
                 class="text-brand-600 hover:text-brand-500">Ver</a>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="7" class="px-6 py-8 text-center text-sm text-gray-500">
              No hay rutas registradas.
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {# ── Pagination ──────────────────────────────────────────────────── #}
  {% if totalPages > 1 %}
    <nav class="mt-6 flex items-center justify-between">
      <div class="text-sm text-gray-700">
        Pagina {{ page }} de {{ totalPages }}
      </div>
      <div class="flex space-x-2">
        {% if page > 1 %}
          <a href="{{ path('customer_routes_index', {page: page - 1, status: currentStatus}) }}"
             class="inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
            Anterior
          </a>
        {% endif %}
        {% if page < totalPages %}
          <a href="{{ path('customer_routes_index', {page: page + 1, status: currentStatus}) }}"
             class="inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
            Siguiente
          </a>
        {% endif %}
      </div>
    </nav>
  {% endif %}
{% endblock %}
