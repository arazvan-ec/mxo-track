{% extends 'base.html.twig' %}

{% block title %}Planificador de Rutas - Admin{% endblock %}

{% block styles %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
{% endblock %}

{% block content %}
<div x-data="routePlannerClustering()" x-init="init()">

    {# Header #}
    <div class="mb-6 flex items-center justify-between">
        <h1 class="text-2xl font-bold text-gray-900">Planificador de Rutas</h1>
    </div>

    {# Step 1: Select shipments and cluster #}
    <div class="mb-6 rounded-lg bg-white p-6 shadow">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold text-gray-800">Paso 1: Seleccionar envios y agrupar por zona</h2>
            <div class="flex items-center gap-3">
                <label for="numClusters" class="text-sm text-gray-600">Num. zonas:</label>
                <input type="number" id="numClusters" x-model.number="numClusters" min="1" max="10"
                       class="w-20 rounded-md border border-gray-300 px-3 py-1.5 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
                <button @click="clusterShipments()"
                        :disabled="selectedShipmentIds.length === 0 || loading"
                        class="inline-flex items-center rounded-md bg-purple-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-purple-500 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                    <svg class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/>
                    </svg>
                    <span x-text="loading ? 'Agrupando...' : 'Agrupar por zona'"></span>
                </button>
            </div>
        </div>

        {# Shipment selection area #}
        <div class="mb-4">
            <p class="text-sm text-gray-500 mb-2">
                Selecciona los envios en el mapa o utiliza la lista. Luego agrupa por zona para visualizar clusters geograficos.
            </p>
            <div class="flex items-center gap-2 text-sm text-gray-600">
                <span class="font-medium" x-text="selectedShipmentIds.length"></span> envios seleccionados
                <template x-if="clusters.length > 0">
                    <span class="ml-2 text-purple-600 font-medium">
                        | <span x-text="clusters.length"></span> zonas detectadas
                    </span>
                </template>
            </div>
        </div>

        {# Map #}
        <div id="clusterMap" class="h-96 rounded-lg border border-gray-200 mb-4"></div>

        {# Cluster summary #}
        <template x-if="clusters.length > 0">
            <div class="mt-4">
                <h3 class="text-sm font-semibold text-gray-700 mb-3">Resumen de zonas</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-3">
                    <template x-for="(cluster, idx) in clusters" :key="idx">
                        <div class="rounded-lg border-2 p-3" :style="'border-color: ' + cluster.color">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="h-3 w-3 rounded-full" :style="'background-color: ' + cluster.color"></span>
                                <span class="text-sm font-semibold text-gray-800" x-text="'Zona ' + (idx + 1)"></span>
                            </div>
                            <p class="text-xs text-gray-500">
                                <span x-text="cluster.shipmentIds.length"></span> envios
                            </p>
                            <p class="text-xs text-gray-400">
                                Centro: <span x-text="cluster.centroid.lat.toFixed(4)"></span>,
                                <span x-text="cluster.centroid.lng.toFixed(4)"></span>
                            </p>
                        </div>
                    </template>
                </div>
            </div>
        </template>

        {# Error message #}
        <template x-if="errorMessage">
            <div class="mt-4 rounded-md bg-red-50 p-3">
                <p class="text-sm text-red-700" x-text="errorMessage"></p>
            </div>
        </template>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
function routePlannerClustering() {
    return {
        map: null,
        markers: [],
        clusterLayers: [],
        selectedShipmentIds: [],
        numClusters: 3,
        clusters: [],
        loading: false,
        errorMessage: '',
        // Shipment data keyed by publicId for quick lookup
        shipmentData: {},

        init() {
            this.$nextTick(() => {
                this.map = L.map('clusterMap').setView([40.4168, -3.7038], 12);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; OpenStreetMap contributors',
                    maxZoom: 19
                }).addTo(this.map);

                // Load shipments from the API (pending shipments with coordinates)
                this.loadShipments();
            });
        },

        async loadShipments() {
            try {
                const resp = await fetch('/api/shipments?status=PENDING&limit=500');
                if (!resp.ok) return;
                const data = await resp.json();
                const shipments = data.shipments || data.data || data || [];

                if (!Array.isArray(shipments)) return;

                const bounds = [];
                shipments.forEach(s => {
                    const id = s.public_id || s.publicId || s.id;
                    const lat = parseFloat(s.latitude || s.lat);
                    const lng = parseFloat(s.longitude || s.lng);
                    if (!id || isNaN(lat) || isNaN(lng)) return;

                    this.shipmentData[id] = { id, lat, lng, address: s.address || '' };
                    this.selectedShipmentIds.push(id);

                    const marker = L.circleMarker([lat, lng], {
                        radius: 7,
                        fillColor: '#3b82f6',
                        color: '#1d4ed8',
                        weight: 1,
                        fillOpacity: 0.8
                    }).addTo(this.map);

                    marker._shipmentId = id;
                    marker.bindTooltip(s.address || id, { direction: 'top' });
                    this.markers.push(marker);
                    bounds.push([lat, lng]);
                });

                if (bounds.length > 0) {
                    this.map.fitBounds(bounds, { padding: [30, 30] });
                }
            } catch (e) {
                // Silently fail — user can still input IDs manually
            }
        },

        async clusterShipments() {
            if (this.selectedShipmentIds.length === 0) return;

            this.loading = true;
            this.errorMessage = '';
            this.clusters = [];

            try {
                const resp = await fetch('{{ path("admin_route_planner_cluster") }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        shipment_ids: this.selectedShipmentIds,
                        num_clusters: this.numClusters
                    })
                });

                const data = await resp.json();

                if (!resp.ok || !data.ok) {
                    this.errorMessage = data.error || 'Error al agrupar envios.';
                    return;
                }

                this.clusters = data.clusters || [];
                this.colorMarkersByClusters();
            } catch (e) {
                this.errorMessage = 'Error de red al agrupar envios.';
            } finally {
                this.loading = false;
            }
        },

        colorMarkersByClusters() {
            // Clear old cluster layers
            this.clusterLayers.forEach(l => this.map.removeLayer(l));
            this.clusterLayers = [];

            // Build a map: shipmentId -> cluster color
            const colorMap = {};
            this.clusters.forEach(cluster => {
                cluster.shipmentIds.forEach(id => {
                    colorMap[id] = cluster.color;
                });
            });

            // Update marker colors
            this.markers.forEach(marker => {
                const color = colorMap[marker._shipmentId] || '#3b82f6';
                marker.setStyle({
                    fillColor: color,
                    color: color,
                    fillOpacity: 0.85
                });
            });

            // Add centroid markers
            this.clusters.forEach((cluster, idx) => {
                const centroidMarker = L.circleMarker(
                    [cluster.centroid.lat, cluster.centroid.lng],
                    {
                        radius: 12,
                        fillColor: cluster.color,
                        color: '#ffffff',
                        weight: 3,
                        fillOpacity: 0.9
                    }
                ).addTo(this.map);

                centroidMarker.bindTooltip('Zona ' + (idx + 1) + ' (' + cluster.shipmentIds.length + ' envios)', {
                    permanent: false,
                    direction: 'top'
                });

                this.clusterLayers.push(centroidMarker);
            });
        }
    };
}
</script>
{% endblock %}
