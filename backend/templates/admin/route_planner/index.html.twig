{% extends 'base.html.twig' %}

{% block title %}Planificador de rutas - MXO Track{% endblock %}

{% block breadcrumbs %}
  <li>
    <div class="flex items-center">
      <svg class="h-5 w-5 shrink-0 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
      </svg>
      <span class="ml-2 text-sm font-medium text-gray-900">Planificador de rutas</span>
    </div>
  </li>
{% endblock %}

{% block content %}
<div x-data="routePlanner()" class="space-y-8">

  {# ── Page header ────────────────────────────────────────────────────── #}
  <div>
    <h1 class="text-2xl font-bold tracking-tight text-gray-900">Planificador de rutas</h1>
    <p class="mt-1 text-sm text-gray-500">
      Crea rutas optimizadas seleccionando envios y vehiculos, y asigna conductores recomendados.
    </p>
  </div>

  {# ── Step indicator ─────────────────────────────────────────────────── #}
  <nav aria-label="Progress">
    <ol class="flex items-center space-x-5">
      <template x-for="(stepLabel, idx) in ['Seleccionar envios', 'Seleccionar vehiculos', 'Vista previa y asignacion']" :key="idx">
        <li class="flex items-center">
          <span
            class="flex h-8 w-8 items-center justify-center rounded-full text-sm font-medium"
            :class="step > idx + 1 ? 'bg-blue-600 text-white' : (step === idx + 1 ? 'border-2 border-blue-600 text-blue-600' : 'border-2 border-gray-300 text-gray-500')"
            x-text="idx + 1"></span>
          <span class="ml-2 text-sm font-medium"
                :class="step === idx + 1 ? 'text-blue-600' : 'text-gray-500'"
                x-text="stepLabel"></span>
          <svg x-show="idx < 2" class="ml-5 h-5 w-5 text-gray-300" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
          </svg>
        </li>
      </template>
    </ol>
  </nav>

  {# ── Step 1: Select shipments ───────────────────────────────────────── #}
  <div x-show="step === 1" class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Paso 1: Seleccionar envios</h2>
    <p class="text-sm text-gray-500 mb-4">Selecciona los envios que quieres incluir en las rutas.</p>
    <div class="text-sm text-gray-400 italic">
      (Utiliza la API <code>POST /api/routes/build</code> para construir rutas a partir de envios y vehiculos seleccionados.)
    </div>
    <div class="mt-6 flex justify-end">
      <button @click="step = 2" type="button"
              class="rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
        Siguiente
      </button>
    </div>
  </div>

  {# ── Step 2: Select vehicles ────────────────────────────────────────── #}
  <div x-show="step === 2" class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Paso 2: Seleccionar vehiculos</h2>
    <p class="text-sm text-gray-500 mb-4">Selecciona los vehiculos disponibles para las rutas.</p>
    <div class="mt-6 flex justify-between">
      <button @click="step = 1" type="button"
              class="rounded-md bg-gray-200 px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-300">
        Anterior
      </button>
      <button @click="step = 3; loadDriverSuggestions()" type="button"
              class="rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
        Siguiente
      </button>
    </div>
  </div>

  {# ── Step 3: Preview & Driver Assignment ────────────────────────────── #}
  <div x-show="step === 3" class="space-y-6">
    <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Paso 3: Vista previa y asignacion de conductores</h2>
      <p class="text-sm text-gray-500 mb-6">
        Revisa las rutas generadas y asigna un conductor a cada una. El sistema sugiere el conductor mas adecuado
        basandose en zona, valoracion, disponibilidad y habilidades del vehiculo.
      </p>

      {# Loading state #}
      <div x-show="loadingDrivers" class="flex items-center justify-center py-8">
        <svg class="animate-spin h-6 w-6 text-blue-600 mr-3" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
        <span class="text-sm text-gray-500">Calculando sugerencias de conductores...</span>
      </div>

      {# Route cards with driver suggestions #}
      <div x-show="!loadingDrivers" class="space-y-4">
        <template x-for="(routeData, routeIdx) in routes" :key="routeIdx">
          <div class="border border-gray-200 rounded-lg p-5 bg-gray-50">
            {# Route header #}
            <div class="flex items-center justify-between mb-4">
              <div>
                <h3 class="text-base font-semibold text-gray-900" x-text="routeData.route.name"></h3>
                <p class="text-sm text-gray-500">
                  <span x-text="routeData.stopsCount"></span> paradas
                  <span x-show="routeData.route.totalDistanceKm"> &middot;
                    <span x-text="routeData.route.totalDistanceKm?.toFixed(1)"></span> km
                  </span>
                  <span x-show="routeData.route.estimatedDurationMinutes"> &middot;
                    <span x-text="routeData.route.estimatedDurationMinutes"></span> min
                  </span>
                  <span x-show="routeData.route.vehicle"> &middot; Vehiculo:
                    <span class="font-medium" x-text="routeData.route.vehicle"></span>
                  </span>
                </p>
              </div>
            </div>

            {# Driver suggestion #}
            <div class="bg-white rounded-md border border-gray-200 p-4">
              <label class="block text-sm font-medium text-gray-700 mb-2">Conductor sugerido</label>

              {# Suggested driver badge #}
              <div x-show="driverSuggestions[routeData.route.publicId]?.length > 0" class="mb-3">
                <div class="inline-flex items-center gap-2 rounded-full bg-green-50 border border-green-200 px-3 py-1.5">
                  <svg class="h-4 w-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <span class="text-sm font-medium text-green-800"
                        x-text="driverSuggestions[routeData.route.publicId]?.[0]?.driver_name"></span>
                  <span class="text-xs text-green-600"
                        x-text="driverSuggestions[routeData.route.publicId]?.[0]?.score + ' pts'"></span>
                  <span class="inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-700"
                        x-text="driverSuggestions[routeData.route.publicId]?.[0]?.top_criterion"></span>
                </div>
              </div>

              {# Driver dropdown sorted by score #}
              <select
                class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm"
                x-model="driverAssignments[routeData.route.publicId]"
                :name="'driver_assignments[' + routeData.route.publicId + ']'">
                <option value="">-- Seleccionar conductor --</option>
                <template x-for="suggestion in (driverSuggestions[routeData.route.publicId] || [])" :key="suggestion.driver_public_id">
                  <option :value="suggestion.driver_public_id"
                          x-text="suggestion.driver_name + ' (' + suggestion.score + ' pts - ' + suggestion.top_criterion + ')'">
                  </option>
                </template>
              </select>

              {# Score breakdown for selected driver #}
              <div x-show="driverAssignments[routeData.route.publicId]" class="mt-3">
                <template x-if="getSelectedDriverBreakdown(routeData.route.publicId)">
                  <div class="grid grid-cols-4 gap-2">
                    <div class="text-center p-2 rounded bg-gray-50">
                      <div class="text-xs text-gray-500">Zona</div>
                      <div class="text-sm font-semibold" x-text="getSelectedDriverBreakdown(routeData.route.publicId)?.zone"></div>
                    </div>
                    <div class="text-center p-2 rounded bg-gray-50">
                      <div class="text-xs text-gray-500">Valoracion</div>
                      <div class="text-sm font-semibold" x-text="getSelectedDriverBreakdown(routeData.route.publicId)?.rating"></div>
                    </div>
                    <div class="text-center p-2 rounded bg-gray-50">
                      <div class="text-xs text-gray-500">Disponibilidad</div>
                      <div class="text-sm font-semibold" x-text="getSelectedDriverBreakdown(routeData.route.publicId)?.workload"></div>
                    </div>
                    <div class="text-center p-2 rounded bg-gray-50">
                      <div class="text-xs text-gray-500">Habilidades</div>
                      <div class="text-sm font-semibold" x-text="getSelectedDriverBreakdown(routeData.route.publicId)?.skills"></div>
                    </div>
                  </div>
                </template>
              </div>
            </div>
          </div>
        </template>

        {# Empty state #}
        <div x-show="routes.length === 0 && !loadingDrivers" class="text-center py-8">
          <p class="text-sm text-gray-500">No hay rutas generadas. Vuelve al paso anterior para configurar la planificacion.</p>
        </div>
      </div>

      {# Navigation buttons #}
      <div class="mt-6 flex justify-between">
        <button @click="step = 2" type="button"
                class="rounded-md bg-gray-200 px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-300">
          Anterior
        </button>
        <button @click="confirmRoutes()" type="button"
                :disabled="confirming"
                class="rounded-md bg-green-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-500 disabled:opacity-50">
          <span x-show="!confirming">Confirmar rutas</span>
          <span x-show="confirming">Confirmando...</span>
        </button>
      </div>
    </div>
  </div>

</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function routePlanner() {
  return {
    step: 1,
    routes: [],
    driverSuggestions: {},
    driverAssignments: {},
    loadingDrivers: false,
    confirming: false,

    async loadDriverSuggestions() {
      if (this.routes.length === 0) {
        return;
      }

      this.loadingDrivers = true;

      for (const routeData of this.routes) {
        const routePublicId = routeData.route.publicId;
        try {
          const response = await fetch(
            '{{ path("admin_route_planner_suggest_drivers") }}?route_id=' + encodeURIComponent(routePublicId)
          );
          if (response.ok) {
            const suggestions = await response.json();
            this.driverSuggestions[routePublicId] = suggestions;

            // Auto-select the top-scored driver
            if (suggestions.length > 0 && !this.driverAssignments[routePublicId]) {
              this.driverAssignments[routePublicId] = suggestions[0].driver_public_id;
            }
          }
        } catch (err) {
          console.error('Error loading driver suggestions for route ' + routePublicId, err);
        }
      }

      this.loadingDrivers = false;
    },

    getSelectedDriverBreakdown(routePublicId) {
      const selectedId = this.driverAssignments[routePublicId];
      if (!selectedId) return null;
      const suggestions = this.driverSuggestions[routePublicId] || [];
      const match = suggestions.find(s => s.driver_public_id === selectedId);
      return match ? match.breakdown : null;
    },

    async confirmRoutes() {
      this.confirming = true;
      try {
        const response = await fetch('{{ path("admin_route_planner_confirm") }}', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': '{{ csrf_token("route-planner-confirm") }}',
          },
          body: JSON.stringify({
            driver_assignments: this.driverAssignments,
          }),
        });

        if (response.ok) {
          window.location.href = '{{ path("admin_routes_index") }}';
        } else {
          const data = await response.json();
          alert(data.error || 'Error al confirmar las rutas.');
        }
      } catch (err) {
        console.error('Error confirming routes', err);
        alert('Error al confirmar las rutas.');
      } finally {
        this.confirming = false;
      }
    },
  };
}
</script>
{% endblock %}
