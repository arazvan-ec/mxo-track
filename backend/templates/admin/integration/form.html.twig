{% extends 'base.html.twig' %}

{% block title %}{{ integration ? 'Editar integracion' : 'Nueva integracion' }} - Admin{% endblock %}

{% block content %}
    <div class="mb-6">
      <a href="{{ path('admin_integrations_index') }}" class="text-sm text-blue-600 hover:text-blue-800 hover:underline">
        &larr; Volver a integraciones
      </a>
    </div>

    <h1 class="text-2xl font-bold text-gray-900 mb-6">
      {{ integration ? 'Editar integracion' : 'Nueva integracion' }}
    </h1>

    {% if integration %}
      <div class="mb-4 rounded-md bg-gray-50 p-4 text-sm text-gray-600">
        <strong>Cliente:</strong> {{ integration.customer.name }} &middot;
        <strong>Servicio:</strong> {{ integration.serviceType.value }} &middot;
        <strong>Proveedor:</strong> {{ integration.providerType }}
      </div>
    {% endif %}

    <div class="bg-white shadow sm:rounded-lg">
      {{ form_start(form, {attr: {class: 'space-y-6 p-6'}}) }}

        {% if not integration %}
          <div>
            {{ form_label(form.customer, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.customer) }}
            {{ form_errors(form.customer) }}
          </div>

          <div>
            {{ form_label(form.serviceType, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.serviceType) }}
            {{ form_errors(form.serviceType) }}
          </div>

          <div>
            {{ form_label(form.providerType, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.providerType) }}
            {{ form_errors(form.providerType) }}
          </div>
        {% endif %}

        <div>
          {{ form_label(form.configJson, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
          {{ form_widget(form.configJson) }}
          {{ form_errors(form.configJson) }}
          <p class="mt-1 text-xs text-gray-500">Configuracion especifica del proveedor en formato JSON (ej: {"url": "http://...", "api_key": "..."})</p>
        </div>

        <div>
          {{ form_label(form.priority, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
          {{ form_widget(form.priority) }}
          {{ form_errors(form.priority) }}
          <p class="mt-1 text-xs text-gray-500">0 = proveedor primario, 1+ = fallbacks en orden</p>
        </div>

        <div class="flex items-center">
          {{ form_widget(form.enabled) }}
          {{ form_label(form.enabled, null, {label_attr: {class: 'ml-2 block text-sm text-gray-700'}}) }}
          {{ form_errors(form.enabled) }}
        </div>

        <div class="flex items-center justify-end space-x-3 pt-4 border-t border-gray-200">
          <a href="{{ path('admin_integrations_index') }}"
             class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
            Cancelar
          </a>
          <button type="submit"
                  class="rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
            {{ integration ? 'Guardar cambios' : 'Crear integracion' }}
          </button>
        </div>

      {{ form_end(form) }}
    </div>
{% endblock %}
