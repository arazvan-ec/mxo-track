{% extends 'base.html.twig' %}

{% block title %}Integraciones - Admin{% endblock %}

{% block content %}
    <div class="sm:flex sm:items-center sm:justify-between mb-6">
      <h1 class="text-2xl font-bold" style="color: var(--color-text-primary);">Integraciones de proveedores</h1>
      <a href="{{ path('admin_integrations_new') }}"
         class="inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
        Nueva integracion
      </a>
    </div>

    <div class="overflow-x-auto shadow ring-1 sm:rounded-lg" style="background: var(--color-surface-elevated); border-color: var(--color-border);">
      <table class="min-w-full divide-y" style="border-color: var(--color-border);">
        <thead style="background: var(--color-surface);">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Cliente</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Servicio</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Proveedor</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Prioridad</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Estado</th>
            <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y" style="border-color: var(--color-border); background: var(--color-surface-elevated);">
          {% for integration in integrations %}
            <tr>
              <td class="whitespace-nowrap px-6 py-4 text-sm font-medium" style="color: var(--color-text-primary);">
                {{ integration.customer.name }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm" style="color: var(--color-text-secondary);">
                {{ integration.serviceType.value }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm" style="color: var(--color-text-secondary);">
                {{ integration.providerType }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm" style="color: var(--color-text-secondary);">
                {{ integration.priority }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm">
                {% if integration.enabled %}
                  <span class="inline-flex rounded-full badge-green px-2 text-xs font-semibold leading-5">Activo</span>
                {% else %}
                  <span class="inline-flex rounded-full badge-red px-2 text-xs font-semibold leading-5">Inactivo</span>
                {% endif %}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                <a href="{{ path('admin_integrations_edit', {publicId: integration.publicIdString}) }}"
                   class="text-blue-600 hover:opacity-80 mr-3">Editar</a>
                <form method="post" action="{{ path('admin_integrations_delete', {publicId: integration.publicIdString}) }}"
                      class="inline"
                      onsubmit="return confirm('Eliminar esta integracion?');">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete-integration-' ~ integration.publicIdString) }}">
                  <button type="submit" class="text-red-600 hover:opacity-80">Eliminar</button>
                </form>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="6" class="px-6 py-4 text-center text-sm" style="color: var(--color-text-secondary);">
                No hay integraciones configuradas.
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
{% endblock %}
