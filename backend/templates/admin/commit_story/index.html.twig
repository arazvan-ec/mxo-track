{% extends 'base.html.twig' %}

{% block title %}Commit Story - MXO Track{% endblock %}

{% block breadcrumbs %}
  <li>
    <div class="flex items-center">
      <svg class="h-5 w-5 shrink-0" style="color: var(--color-text-muted);" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
      </svg>
      <span class="ml-2 text-sm font-medium" style="color: var(--color-text-secondary);">Commit Story</span>
    </div>
  </li>
{% endblock %}

{% block content %}
<div class="mb-8">
  <h1 class="text-2xl font-bold tracking-tight" style="color: var(--color-text-primary);">Commit Story</h1>
  <p class="mt-1 text-sm" style="color: var(--color-text-secondary);">Visualiza el proceso de desarrollo paso a paso de cada rama.</p>
</div>

{% if unavailable|default(false) %}
<div class="rounded-xl bg-amber-50 p-6 shadow-sm ring-1 ring-amber-200">
  <div class="flex items-center gap-3">
    <svg class="h-6 w-6 text-amber-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/>
    </svg>
    <div>
      <p class="text-sm font-medium text-amber-800">Historial Git no disponible</p>
      <p class="mt-1 text-sm text-amber-600">Este entorno no tiene repositorio Git. El Commit Story solo funciona en entornos de desarrollo local.</p>
    </div>
  </div>
</div>
{% else %}
<div class="rounded-xl p-6 shadow-sm ring-1 ring-gray-900/5" style="background: var(--color-surface-elevated);">
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {% for branch in branches %}
      <a href="{{ path('admin_commit_story', {branch: branch}) }}"
         class="group flex items-center gap-3 rounded-lg border p-4 transition-all hover:border-brand-300 hover:bg-brand-50/50 hover:shadow-sm" style="border-color: var(--color-border);">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-indigo-50 group-hover:bg-indigo-100 transition-colors">
          <svg class="h-5 w-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/>
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-sm font-medium group-hover:text-brand-700 truncate" style="color: var(--color-text-primary);">{{ branch }}</p>
        </div>
        <svg class="h-4 w-4 group-hover:text-brand-500 transition-colors" style="color: var(--color-text-muted);" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
        </svg>
      </a>
    {% else %}
      <p class="text-sm col-span-full" style="color: var(--color-text-secondary);">No se encontraron ramas.</p>
    {% endfor %}
  </div>
</div>
{% endif %}
{% endblock %}
