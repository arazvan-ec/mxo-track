{% extends 'base.html.twig' %}

{% block title %}Logs de optimizacion - Admin{% endblock %}

{% block breadcrumbs %}
  <li>
    <div class="flex items-center">
      <svg class="h-5 w-5 shrink-0" style="color: var(--color-text-muted);" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
      </svg>
      <span class="ml-2 text-sm font-medium" style="color: var(--color-text-primary);">Logs de optimizacion</span>
    </div>
  </li>
{% endblock %}

{% block content %}
<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold tracking-tight" style="color: var(--color-text-primary);">Logs de optimizacion</h1>
      <p class="mt-1 text-sm" style="color: var(--color-text-secondary);">Historial de decisiones tomadas en cada planificacion y optimizacion de rutas.</p>
    </div>
  </div>

  {# Filters #}
  <div class="flex items-center gap-3">
    <a href="{{ path('admin_optimization_logs_index') }}"
       class="inline-flex items-center rounded-md px-3 py-1.5 text-sm font-medium {{ currentOperation == '' ? 'badge-indigo' : 'theme-card' }}"
       {% if currentOperation != '' %}style="color: var(--color-text-secondary); border-color: var(--color-border);"{% endif %}>
      Todos
    </a>
    {% for op in operations %}
      <a href="{{ path('admin_optimization_logs_index', { operation: op.value }) }}"
         class="inline-flex items-center rounded-md px-3 py-1.5 text-sm font-medium {{ currentOperation == op.value ? 'badge-indigo' : 'theme-card' }}"
         {% if currentOperation != op.value %}style="color: var(--color-text-secondary); border-color: var(--color-border);"{% endif %}>
        {{ op.label }}
      </a>
    {% endfor %}
  </div>

  {# Table #}
  <div class="theme-card overflow-hidden">
    <table class="min-w-full divide-y" style="border-color: var(--color-border);">
      <thead style="background: var(--color-surface);">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase" style="color: var(--color-text-secondary);">Fecha</th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase" style="color: var(--color-text-secondary);">Operacion</th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase" style="color: var(--color-text-secondary);">Optimizador</th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase" style="color: var(--color-text-secondary);">Pasos</th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase" style="color: var(--color-text-secondary);">Duracion</th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase" style="color: var(--color-text-secondary);">Mejora</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y" style="border-color: var(--color-border);">
        {% for log in logs %}
        <tr>
          <td class="px-4 py-3 text-sm whitespace-nowrap" style="color: var(--color-text-secondary);">
            {{ log.createdAt|date('d/m/Y H:i') }}
          </td>
          <td class="px-4 py-3 text-sm">
            <span class="inline-flex rounded-full badge-indigo px-2.5 py-0.5 text-xs font-semibold">
              {{ log.operation.label }}
            </span>
          </td>
          <td class="px-4 py-3 text-sm" style="color: var(--color-text-primary);">{{ log.optimizerUsed }}</td>
          <td class="px-4 py-3 text-sm" style="color: var(--color-text-secondary);">{{ log.steps|length }}</td>
          <td class="px-4 py-3 text-sm" style="color: var(--color-text-secondary);">{{ log.durationMs }} ms</td>
          <td class="px-4 py-3 text-sm">
            {% set result = log.resultSummary %}
            {% if result.improvementPercent is defined and result.improvementPercent %}
              <span class="font-medium text-green-600">{{ result.improvementPercent }}%</span>
            {% elseif result.routesCreated is defined %}
              <span style="color: var(--color-text-secondary);">{{ result.routesCreated }} rutas</span>
            {% else %}
              <span style="color: var(--color-text-muted);">-</span>
            {% endif %}
          </td>
          <td class="px-4 py-3 text-right">
            <a href="{{ path('admin_optimization_logs_show', { publicId: log.publicIdString }) }}"
               class="text-indigo-600 hover:text-indigo-500 text-sm font-medium">Ver</a>
          </td>
        </tr>
        {% else %}
        <tr>
          <td colspan="7" class="px-4 py-8 text-center text-sm" style="color: var(--color-text-secondary);">
            No hay logs de optimizacion registrados.
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
