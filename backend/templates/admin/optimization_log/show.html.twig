{% extends 'base.html.twig' %}

{% block title %}Log {{ log.publicIdString|slice(0, 8) }} - Optimizacion{% endblock %}

{% block breadcrumbs %}
  <li>
    <div class="flex items-center">
      <svg class="h-5 w-5 shrink-0" style="color: var(--color-text-muted);" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
      </svg>
      <a href="{{ path('admin_optimization_logs_index') }}" class="ml-2 text-sm font-medium hover:opacity-80" style="color: var(--color-text-secondary);">Logs</a>
    </div>
  </li>
  <li>
    <div class="flex items-center">
      <svg class="h-5 w-5 shrink-0" style="color: var(--color-text-muted);" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
      </svg>
      <span class="ml-2 text-sm font-medium" style="color: var(--color-text-primary);">{{ log.publicIdString|slice(0, 8) }}</span>
    </div>
  </li>
{% endblock %}

{% block styles %}
{{ parent() }}
<style>
  .log-timeline { position: relative; padding-left: 28px; }
  .log-timeline-item { position: relative; padding-bottom: 20px; border-left: 2px solid #e5e7eb; padding-left: 20px; }
  .log-timeline-item:last-child { border-left-color: transparent; }
  .log-timeline-dot {
    position: absolute; left: -8px; top: 4px;
    width: 14px; height: 14px; border-radius: 50%;
    border: 2px solid #fff; box-shadow: 0 0 0 1px #d1d5db;
  }
  .log-data-block {
    margin-top: 6px; font-size: 12px; color: #6b7280;
    background: #f9fafb; border-radius: 6px; padding: 8px 12px;
    font-family: ui-monospace, monospace; white-space: pre-wrap; word-break: break-all;
    max-height: 300px; overflow-y: auto;
  }
  .dot-blue { background: #3b82f6; } .dot-indigo { background: #6366f1; }
  .dot-purple { background: #8b5cf6; } .dot-yellow { background: #eab308; }
  .dot-orange { background: #f97316; } .dot-cyan { background: #06b6d4; }
  .dot-green { background: #22c55e; } .dot-red { background: #ef4444; }
  .dot-teal { background: #14b8a6; } .dot-emerald { background: #10b981; }
  .dot-gray { background: #6b7280; } .dot-violet { background: #8b5cf6; }
</style>
{% endblock %}

{% block content %}
<div class="space-y-6">
  {# Header #}
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-4">
      <a href="{{ path('admin_optimization_logs_index') }}"
         class="inline-flex items-center rounded-md theme-card px-3 py-2 text-sm font-medium" style="color: var(--color-text-secondary); border-color: var(--color-border);">
        <svg class="mr-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
        </svg>
        Volver
      </a>
      <div>
        <h1 class="text-2xl font-bold" style="color: var(--color-text-primary);">Log de {{ log.operation.label }}</h1>
        <p class="text-sm" style="color: var(--color-text-secondary);">{{ log.createdAt|date('d/m/Y H:i:s') }} — {{ log.optimizerUsed }} — {{ log.durationMs }} ms</p>
      </div>
    </div>
    <span class="inline-flex rounded-full badge-indigo px-3 py-1 text-xs font-semibold">
      {{ log.steps|length }} pasos
    </span>
  </div>

  {# Summary cards #}
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="theme-card p-5">
      <h3 class="text-xs font-medium uppercase mb-2" style="color: var(--color-text-secondary);">Input</h3>
      <div class="text-sm space-y-1" style="color: var(--color-text-primary);">
        {% for key, val in log.inputSummary %}
          <div class="flex justify-between">
            <span style="color: var(--color-text-secondary);">{{ key }}</span>
            <span class="font-medium">{{ val is iterable ? val|json_encode : val }}</span>
          </div>
        {% endfor %}
      </div>
    </div>
    <div class="theme-card p-5">
      <h3 class="text-xs font-medium uppercase mb-2" style="color: var(--color-text-secondary);">Resultado</h3>
      <div class="text-sm space-y-1" style="color: var(--color-text-primary);">
        {% for key, val in log.resultSummary %}
          <div class="flex justify-between">
            <span style="color: var(--color-text-secondary);">{{ key }}</span>
            <span class="font-medium {% if key == 'improvementPercent' and val > 0 %}text-green-600{% endif %}">
              {{ val is iterable ? val|json_encode : val }}{% if key == 'improvementPercent' %}%{% endif %}
            </span>
          </div>
        {% endfor %}
      </div>
    </div>
    <div class="theme-card p-5">
      <h3 class="text-xs font-medium uppercase mb-2" style="color: var(--color-text-secondary);">Metadata</h3>
      <div class="text-sm space-y-1" style="color: var(--color-text-primary);">
        <div class="flex justify-between">
          <span style="color: var(--color-text-secondary);">Operacion</span>
          <span class="font-medium">{{ log.operation.label }}</span>
        </div>
        <div class="flex justify-between">
          <span style="color: var(--color-text-secondary);">Optimizador</span>
          <span class="font-medium">{{ log.optimizerUsed }}</span>
        </div>
        <div class="flex justify-between">
          <span style="color: var(--color-text-secondary);">Duracion</span>
          <span class="font-medium">{{ log.durationMs }} ms</span>
        </div>
        {% if log.route %}
        <div class="flex justify-between">
          <span style="color: var(--color-text-secondary);">Ruta</span>
          <span class="font-medium">{{ log.route.name }}</span>
        </div>
        {% endif %}
        {% if log.customer %}
        <div class="flex justify-between">
          <span style="color: var(--color-text-secondary);">Cliente</span>
          <span class="font-medium">{{ log.customer.name }}</span>
        </div>
        {% endif %}
      </div>
    </div>
  </div>

  {# Timeline #}
  <div class="theme-card overflow-hidden">
    <div class="px-4 py-3 border-b" style="border-color: var(--color-border);">
      <h2 class="text-lg font-semibold" style="color: var(--color-text-primary);">Timeline de pasos</h2>
    </div>
    <div class="px-6 py-4">
      <div class="log-timeline">
        {% for step in log.steps %}
        <div class="log-timeline-item" x-data="{ open: false }">
          <div class="log-timeline-dot dot-{{ step.color|default('gray') }}"></div>
          <div class="flex items-center gap-2">
            <span class="text-xs font-mono" style="color: var(--color-text-muted);">+{{ step.elapsed_ms|default(0) }}ms</span>
            <span class="text-xs font-semibold uppercase tracking-wide" style="color: var(--cat-color, #6b7280);">
              {{ step.categoryLabel|default(step.category) }}
            </span>
          </div>
          <p class="text-sm mt-1" style="color: var(--color-text-primary);">{{ step.message }}</p>
          {% if step.data is defined and step.data is not empty %}
            <button @click="open = !open" class="text-xs text-indigo-600 hover:underline mt-1">
              <span x-text="open ? 'ocultar datos' : 'ver datos'"></span>
            </button>
            <div x-show="open" x-cloak class="log-data-block">{{ step.data|json_encode(constant('JSON_PRETTY_PRINT') + constant('JSON_UNESCAPED_UNICODE')) }}</div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
{% endblock %}
