{% extends 'base.html.twig' %}

{% block title %}Almacenes - Admin{% endblock %}

{% block content %}
<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    {% for type, messages in app.flashes %}
      {% for message in messages %}
        <div class="mb-4 rounded-md p-4 {{ type == 'success' ? 'bg-green-50 text-green-800' : 'bg-red-50 text-red-800' }}">
          {{ message }}
        </div>
      {% endfor %}
    {% endfor %}

    <div class="sm:flex sm:items-center sm:justify-between mb-6">
      <h1 class="text-2xl font-bold text-gray-900">Almacenes</h1>
      <a href="{{ path('admin_customers_new') }}"
         class="inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
        Nuevo almacen
      </a>
    </div>

    <div class="overflow-hidden bg-white shadow ring-1 ring-gray-200 sm:rounded-lg">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Nombre</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Direccion</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Email</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Telefono</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Estado</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Vehiculos</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Usuarios</th>
            <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          {% for customer in customers %}
            <tr>
              <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900">
                {{ customer.name }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                {{ customer.address ?? '-' }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                {{ customer.contactEmail ?? '-' }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                {{ customer.contactPhone ?? '-' }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm">
                {% if customer.active %}
                  <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Activo</span>
                {% else %}
                  <span class="inline-flex rounded-full bg-red-100 px-2 text-xs font-semibold leading-5 text-red-800">Inactivo</span>
                {% endif %}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                <a href="{{ path('admin_customers_vehicles', {publicId: customer.publicIdString}) }}"
                   class="text-blue-600 hover:text-blue-800 hover:underline">
                  {{ vehicleCounts[customer.id] is defined ? vehicleCounts[customer.id] : 0 }} vehiculo(s)
                </a>
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                {{ userCounts[customer.id] is defined ? userCounts[customer.id] : 0 }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                <a href="{{ path('admin_customers_edit', {publicId: customer.publicIdString}) }}"
                   class="text-blue-600 hover:text-blue-800 mr-3">Editar</a>
                <a href="{{ path('admin_customers_vehicles', {publicId: customer.publicIdString}) }}"
                   class="text-teal-600 hover:text-teal-800 mr-3">Vehiculos</a>
                <form method="post" action="{{ path('admin_customers_delete', {publicId: customer.publicIdString}) }}"
                      class="inline"
                      onsubmit="return confirm('Desactivar este almacen?');">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete-customer-' ~ customer.publicIdString) }}">
                  <button type="submit" class="text-red-600 hover:text-red-800">Eliminar</button>
                </form>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="8" class="px-6 py-4 text-center text-sm text-gray-500">
                No hay almacenes registrados.
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    {% if totalPages > 1 %}
      <nav class="mt-6 flex items-center justify-between">
        <div class="flex flex-1 justify-between sm:justify-end space-x-2">
          {% if page > 1 %}
            <a href="{{ path('admin_customers_index', {page: page - 1}) }}"
               class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
              Anterior
            </a>
          {% endif %}
          <span class="inline-flex items-center px-4 py-2 text-sm text-gray-700">
            Pagina {{ page }} de {{ totalPages }}
          </span>
          {% if page < totalPages %}
            <a href="{{ path('admin_customers_index', {page: page + 1}) }}"
               class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
              Siguiente
            </a>
          {% endif %}
        </div>
      </nav>
    {% endif %}
{% endblock %}
