{% extends 'base.html.twig' %}

{% block title %}Vehiculos de {{ customer.name }} - Admin{% endblock %}

{% block content %}
    <div class="mb-6">
      <a href="{{ path('admin_customers_index') }}" class="text-sm text-blue-600 hover:text-blue-800 hover:underline">
        &larr; Volver a clientes
      </a>
    </div>

    <div class="sm:flex sm:items-center sm:justify-between mb-6">
      <h1 class="text-2xl font-bold" style="color: var(--color-text-primary);">Vehiculos de {{ customer.name }}</h1>
    </div>

    <form method="post" action="{{ path('admin_customers_vehicles', {publicId: customer.publicIdString}) }}">
      <input type="hidden" name="_token" value="{{ csrf_token('vehicles-customer-' ~ customer.publicIdString) }}">

      {% if vehicles|length > 0 %}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 mb-6">
          {% for vehicle in vehicles %}
            <label class="relative flex items-start rounded-lg border p-4 shadow-sm cursor-pointer hover:border-blue-400 transition-colors
                          {{ vehicle.id in assignedIds ? 'border-blue-500 ring-2 ring-blue-200' : '' }}" style="background: var(--color-surface-elevated); {{ vehicle.id not in assignedIds ? 'border-color: var(--color-border);' : '' }}">
              <div class="flex h-5 items-center">
                <input type="checkbox"
                       name="vehicle_ids[]"
                       value="{{ vehicle.publicIdString }}"
                       {{ vehicle.id in assignedIds ? 'checked' : '' }}
                       class="h-4 w-4 rounded text-blue-600 focus:ring-blue-500" style="border-color: var(--color-border);">
              </div>
              <div class="ml-3 text-sm">
                <span class="font-medium" style="color: var(--color-text-primary);">{{ vehicle.name }}</span>
                <div class="mt-1" style="color: var(--color-text-secondary);">
                  {% if vehicle.traccarDeviceId %}
                    <span class="text-xs">Traccar ID: {{ vehicle.traccarDeviceId }}</span>
                  {% else %}
                    <span class="text-xs" style="color: var(--color-text-muted);">Sin dispositivo Traccar</span>
                  {% endif %}
                </div>
                <div class="mt-1">
                  {% if vehicle.active %}
                    <span class="inline-flex rounded-full badge-green px-2 text-xs font-semibold leading-5">Activo</span>
                  {% else %}
                    <span class="inline-flex rounded-full badge-red px-2 text-xs font-semibold leading-5">Inactivo</span>
                  {% endif %}
                </div>
              </div>
            </label>
          {% endfor %}
        </div>
      {% else %}
        <div class="rounded-md p-6 text-center text-sm mb-6" style="background: var(--color-surface); color: var(--color-text-secondary);">
          No hay vehiculos activos disponibles.
        </div>
      {% endif %}

      <div class="flex items-center justify-end space-x-3 pt-4 border-t" style="border-color: var(--color-border);">
        <a href="{{ path('admin_customers_index') }}"
           class="rounded-md px-4 py-2 text-sm font-medium" style="border: 1px solid var(--color-border); background: var(--color-surface-elevated); color: var(--color-text-secondary);">
          Cancelar
        </a>
        <button type="submit"
                class="rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
          Guardar asignacion
        </button>
      </div>
    </form>
{% endblock %}
