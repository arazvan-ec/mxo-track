{% extends 'base.html.twig' %}

{% block title %}Rendimiento de Transportistas - MXO Track{% endblock %}

{% block breadcrumbs %}
  <li>
    <div class="flex items-center">
      <svg class="h-5 w-5 shrink-0" style="color: var(--color-text-muted);" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
      </svg>
      <a href="{{ path('admin_reports_index') }}" class="ml-2 text-sm font-medium hover:opacity-80" style="color: var(--color-text-secondary);">Reportes</a>
    </div>
  </li>
  <li>
    <div class="flex items-center">
      <svg class="h-5 w-5 shrink-0" style="color: var(--color-text-muted);" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
      </svg>
      <span class="ml-2 text-sm font-medium" style="color: var(--color-text-secondary);">Transportistas</span>
    </div>
  </li>
{% endblock %}

{% block content %}
<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h1 class="text-2xl font-bold tracking-tight" style="color: var(--color-text-primary);">Rendimiento de Transportistas</h1>
    <p class="mt-1 text-sm" style="color: var(--color-text-secondary);">Ranking y metricas de rendimiento por conductor.</p>
  </div>
  <div class="flex items-center gap-2">
    <a href="{{ path('admin_reports_export_drivers', {from: from|date('Y-m-d'), to: to|date('Y-m-d')}) }}"
       class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium shadow-sm ring-1 ring-gray-300 transition-colors" style="background: var(--color-surface-elevated); color: var(--color-text-secondary); border-color: var(--color-border);">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/>
      </svg>
      Exportar CSV
    </a>
  </div>
</div>

{# Date filter #}
<form method="get" class="mb-8 flex flex-wrap items-end gap-3">
  <div>
    <label for="from" class="block text-xs font-medium mb-1" style="color: var(--color-text-secondary);">Desde</label>
    <input type="date" id="from" name="from" value="{{ from|date('Y-m-d') }}"
           class="rounded-lg px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500" style="border-color: var(--color-border);">
  </div>
  <div>
    <label for="to" class="block text-xs font-medium mb-1" style="color: var(--color-text-secondary);">Hasta</label>
    <input type="date" id="to" name="to" value="{{ to|date('Y-m-d') }}"
           class="rounded-lg px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500" style="border-color: var(--color-border);">
  </div>
  <button type="submit"
          class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-brand-500 transition-colors">
    Filtrar
  </button>
</form>

{# Bar chart: Deliveries vs Exceptions by driver #}
{% if ranking|length > 0 %}
<div class="rounded-xl p-6 shadow-sm ring-1 ring-gray-900/5 mb-8" style="background: var(--color-surface-elevated);">
  <h3 class="text-base font-semibold mb-4" style="color: var(--color-text-primary);">Entregas vs Excepciones por transportista</h3>
  <div class="relative" style="height: 320px;">
    <canvas id="driverBarChart"></canvas>
  </div>
</div>
{% endif %}

{# Ranking table #}
<div class="rounded-xl shadow-sm ring-1 ring-gray-900/5 overflow-hidden" style="background: var(--color-surface-elevated);">
  <div class="px-6 py-4" style="border-bottom: 1px solid var(--color-border);">
    <h3 class="text-base font-semibold" style="color: var(--color-text-primary);">Ranking de transportistas</h3>
  </div>
  {% if ranking|length > 0 %}
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y" style="border-color: var(--color-border);">
        <thead style="background: var(--color-surface);">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">#</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Transportista</th>
            <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Rutas</th>
            <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Entregas</th>
            <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Excepciones</th>
            <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Tasa exito</th>
          </tr>
        </thead>
        <tbody class="divide-y" style="border-color: var(--color-border);">
          {% for row in ranking %}
            <tr class="transition-colors">
              <td class="whitespace-nowrap px-6 py-4">
                {% if loop.index <= 3 %}
                  <span class="inline-flex h-7 w-7 items-center justify-center rounded-full text-sm font-bold
                    {% if loop.index == 1 %}badge-amber{% elseif loop.index == 2 %}badge-gray{% else %}badge-orange{% endif %}">
                    {{ loop.index }}
                  </span>
                {% else %}
                  <span class="text-sm pl-2" style="color: var(--color-text-secondary);">{{ loop.index }}</span>
                {% endif %}
              </td>
              <td class="whitespace-nowrap px-6 py-4">
                <div class="text-sm font-medium" style="color: var(--color-text-primary);">{{ row.driver_name }}</div>
                <div class="text-xs" style="color: var(--color-text-secondary);">{{ row.driver_email }}</div>
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm" style="color: var(--color-text-secondary);">{{ row.routes_completed }}</td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium text-emerald-600">{{ row.deliveries }}</td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium text-red-600">{{ row.exceptions }}</td>
              <td class="whitespace-nowrap px-6 py-4 text-right">
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium
                  {% if row.success_rate >= 90 %}badge-emerald
                  {% elseif row.success_rate >= 70 %}badge-amber
                  {% else %}badge-red{% endif %}">
                  {{ row.success_rate }}%
                </span>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <div class="px-6 py-12 text-center text-sm" style="color: var(--color-text-secondary);">
      No hay datos de transportistas para el periodo seleccionado.
    </div>
  {% endif %}
</div>

{% if ranking|length > 0 %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const ranking = {{ ranking|json_encode|raw }};
  const ctx = document.getElementById('driverBarChart');
  if (ctx && ranking.length > 0) {
    // Show top 10 at most in the chart
    const top = ranking.slice(0, 10);
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: top.map(d => d.driver_name),
        datasets: [
          {
            label: 'Entregas',
            data: top.map(d => d.deliveries),
            backgroundColor: '#10b981',
            borderRadius: 4,
          },
          {
            label: 'Excepciones',
            data: top.map(d => d.exceptions),
            backgroundColor: '#ef4444',
            borderRadius: 4,
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom' }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: { precision: 0 }
          },
          x: {
            ticks: {
              maxRotation: 45,
              minRotation: 0,
            }
          }
        }
      }
    });
  }
});
</script>
{% endif %}
{% endblock %}
