{% extends 'base.html.twig' %}

{% block title %}Reporte de Entregas - MXO Track{% endblock %}

{% block breadcrumbs %}
  <li>
    <div class="flex items-center">
      <svg class="h-5 w-5 shrink-0" style="color: var(--color-text-muted);" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
      </svg>
      <a href="{{ path('admin_reports_index') }}" class="ml-2 text-sm font-medium hover:opacity-80" style="color: var(--color-text-secondary);">Reportes</a>
    </div>
  </li>
  <li>
    <div class="flex items-center">
      <svg class="h-5 w-5 shrink-0" style="color: var(--color-text-muted);" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
      </svg>
      <span class="ml-2 text-sm font-medium" style="color: var(--color-text-secondary);">Entregas</span>
    </div>
  </li>
{% endblock %}

{% block content %}
<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h1 class="text-2xl font-bold tracking-tight" style="color: var(--color-text-primary);">Reporte de Entregas</h1>
    <p class="mt-1 text-sm" style="color: var(--color-text-secondary);">Estadisticas generales de entregas y excepciones.</p>
  </div>
  <div class="flex items-center gap-2">
    <a href="{{ path('admin_reports_export_deliveries', {from: from ? from|date('Y-m-d') : '', to: to ? to|date('Y-m-d') : ''}) }}"
       class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium shadow-sm ring-1 ring-gray-300 transition-colors" style="background: var(--color-surface-elevated); color: var(--color-text-secondary); border-color: var(--color-border);">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/>
      </svg>
      Exportar CSV
    </a>
  </div>
</div>

{# Date filter #}
<form method="get" class="mb-8 flex flex-wrap items-end gap-3">
  <div>
    <label for="from" class="block text-xs font-medium mb-1" style="color: var(--color-text-secondary);">Desde</label>
    <input type="date" id="from" name="from" value="{{ from ? from|date('Y-m-d') : '' }}"
           class="rounded-lg px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500" style="border-color: var(--color-border);">
  </div>
  <div>
    <label for="to" class="block text-xs font-medium mb-1" style="color: var(--color-text-secondary);">Hasta</label>
    <input type="date" id="to" name="to" value="{{ to ? to|date('Y-m-d') : '' }}"
           class="rounded-lg px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500" style="border-color: var(--color-border);">
  </div>
  <div>
    <label for="period" class="block text-xs font-medium mb-1" style="color: var(--color-text-secondary);">Periodo tendencia</label>
    <select id="period" name="period"
            class="rounded-lg px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500" style="border-color: var(--color-border);">
      <option value="week" {{ period == 'week' ? 'selected' : '' }}>Semanal</option>
      <option value="month" {{ period == 'month' ? 'selected' : '' }}>Mensual</option>
    </select>
  </div>
  <button type="submit"
          class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-brand-500 transition-colors">
    Filtrar
  </button>
  {% if from or to %}
    <a href="{{ path('admin_reports_deliveries') }}" class="text-sm hover:opacity-80 underline" style="color: var(--color-text-secondary);">Limpiar</a>
  {% endif %}
</form>

{# Summary cards #}
<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 mb-8">
  <div class="rounded-xl p-6 shadow-sm ring-1 ring-gray-900/5" style="background: var(--color-surface-elevated);">
    <p class="text-sm font-medium" style="color: var(--color-text-secondary);">Total entregas</p>
    <p class="mt-2 text-3xl font-bold text-emerald-600">{{ report.total_deliveries }}</p>
  </div>
  <div class="rounded-xl p-6 shadow-sm ring-1 ring-gray-900/5" style="background: var(--color-surface-elevated);">
    <p class="text-sm font-medium" style="color: var(--color-text-secondary);">Total excepciones</p>
    <p class="mt-2 text-3xl font-bold text-red-600">{{ report.total_exceptions }}</p>
  </div>
  <div class="rounded-xl p-6 shadow-sm ring-1 ring-gray-900/5" style="background: var(--color-surface-elevated);">
    <p class="text-sm font-medium" style="color: var(--color-text-secondary);">Tasa de exito</p>
    <p class="mt-2 text-3xl font-bold text-brand-600">{{ report.success_rate }}%</p>
  </div>
  <div class="rounded-xl p-6 shadow-sm ring-1 ring-gray-900/5" style="background: var(--color-surface-elevated);">
    <p class="text-sm font-medium" style="color: var(--color-text-secondary);">Prom. entregas/ruta</p>
    <p class="mt-2 text-3xl font-bold" style="color: var(--color-text-primary);">{{ report.avg_deliveries_per_route }}</p>
  </div>
</div>

{# Charts row #}
<div class="grid grid-cols-1 gap-6 lg:grid-cols-2 mb-8">
  {# Trend line chart #}
  <div class="rounded-xl p-6 shadow-sm ring-1 ring-gray-900/5" style="background: var(--color-surface-elevated);">
    <h3 class="text-base font-semibold mb-4" style="color: var(--color-text-primary);">Tendencia de entregas</h3>
    <div class="relative" style="height: 280px;">
      <canvas id="trendChart"></canvas>
    </div>
  </div>

  {# Stop status pie chart #}
  <div class="rounded-xl p-6 shadow-sm ring-1 ring-gray-900/5" style="background: var(--color-surface-elevated);">
    <h3 class="text-base font-semibold mb-4" style="color: var(--color-text-primary);">Distribucion de estados</h3>
    <div class="relative mx-auto" style="height: 280px; max-width: 320px;">
      <canvas id="statusPieChart"></canvas>
    </div>
  </div>
</div>

{# By driver table #}
<div class="rounded-xl shadow-sm ring-1 ring-gray-900/5 overflow-hidden mb-8" style="background: var(--color-surface-elevated);">
  <div class="px-6 py-4" style="border-bottom: 1px solid var(--color-border);">
    <h3 class="text-base font-semibold" style="color: var(--color-text-primary);">Por transportista</h3>
  </div>
  {% if report.by_driver|length > 0 %}
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y" style="border-color: var(--color-border);">
        <thead style="background: var(--color-surface);">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Transportista</th>
            <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Entregas</th>
            <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Excepciones</th>
            <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Rutas</th>
            <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Tasa exito</th>
          </tr>
        </thead>
        <tbody class="divide-y" style="border-color: var(--color-border);">
          {% for row in report.by_driver %}
            <tr class="transition-colors">
              <td class="whitespace-nowrap px-6 py-4">
                <div class="text-sm font-medium" style="color: var(--color-text-primary);">{{ row.driver_name }}</div>
                <div class="text-xs" style="color: var(--color-text-secondary);">{{ row.driver_email }}</div>
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium text-emerald-600">{{ row.deliveries }}</td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium text-red-600">{{ row.exceptions }}</td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm" style="color: var(--color-text-secondary);">{{ row.routes }}</td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm" style="color: var(--color-text-secondary);">
                {% set total = row.deliveries + row.exceptions %}
                {{ total > 0 ? ((row.deliveries / total) * 100)|number_format(1) ~ '%' : '-' }}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <div class="px-6 py-12 text-center text-sm" style="color: var(--color-text-secondary);">
      No hay datos de transportistas para el periodo seleccionado.
    </div>
  {% endif %}
</div>

{# By customer table #}
<div class="rounded-xl shadow-sm ring-1 ring-gray-900/5 overflow-hidden" style="background: var(--color-surface-elevated);">
  <div class="px-6 py-4" style="border-bottom: 1px solid var(--color-border);">
    <h3 class="text-base font-semibold" style="color: var(--color-text-primary);">Por cliente</h3>
  </div>
  {% if report.by_customer|length > 0 %}
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y" style="border-color: var(--color-border);">
        <thead style="background: var(--color-surface);">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Cliente</th>
            <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Entregas</th>
            <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Excepciones</th>
            <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Rutas</th>
          </tr>
        </thead>
        <tbody class="divide-y" style="border-color: var(--color-border);">
          {% for row in report.by_customer %}
            <tr class="transition-colors">
              <td class="whitespace-nowrap px-6 py-4 text-sm font-medium" style="color: var(--color-text-primary);">{{ row.customer_name }}</td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium text-emerald-600">{{ row.deliveries }}</td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium text-red-600">{{ row.exceptions }}</td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm" style="color: var(--color-text-secondary);">{{ row.routes }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <div class="px-6 py-12 text-center text-sm" style="color: var(--color-text-secondary);">
      No hay datos de clientes para el periodo seleccionado.
    </div>
  {% endif %}
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Trend line chart
  const trendData = {{ trend_data|json_encode|raw }};
  const trendCtx = document.getElementById('trendChart');
  if (trendCtx) {
    new Chart(trendCtx, {
      type: 'line',
      data: {
        labels: trendData.map(d => d.period_label),
        datasets: [
          {
            label: 'Entregas',
            data: trendData.map(d => d.deliveries),
            borderColor: '#10b981',
            backgroundColor: 'rgba(16, 185, 129, 0.1)',
            fill: true,
            tension: 0.3,
            pointRadius: 4,
            pointHoverRadius: 6,
          },
          {
            label: 'Excepciones',
            data: trendData.map(d => d.exceptions),
            borderColor: '#ef4444',
            backgroundColor: 'rgba(239, 68, 68, 0.1)',
            fill: true,
            tension: 0.3,
            pointRadius: 4,
            pointHoverRadius: 6,
          },
          {
            label: 'Rutas completadas',
            data: trendData.map(d => d.routes_completed),
            borderColor: '#6366f1',
            backgroundColor: 'rgba(99, 102, 241, 0.1)',
            fill: false,
            tension: 0.3,
            pointRadius: 4,
            pointHoverRadius: 6,
            borderDash: [5, 5],
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom' }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: { precision: 0 }
          }
        }
      }
    });
  }

  // Status pie chart
  const statusData = {{ status_distribution|json_encode|raw }};
  const pieCtx = document.getElementById('statusPieChart');
  if (pieCtx) {
    const total = statusData.delivered + statusData.exception + statusData.pending + statusData.skipped;
    if (total > 0) {
      new Chart(pieCtx, {
        type: 'pie',
        data: {
          labels: ['Entregadas', 'Excepciones', 'Pendientes', 'Omitidas'],
          datasets: [{
            data: [statusData.delivered, statusData.exception, statusData.pending, statusData.skipped],
            backgroundColor: ['#10b981', '#ef4444', '#f59e0b', '#94a3b8'],
            borderWidth: 2,
            borderColor: '#fff',
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom' }
          }
        }
      });
    } else {
      pieCtx.parentElement.innerHTML = '<div class="flex items-center justify-center h-full text-sm" style="color: var(--color-text-muted);">Sin datos disponibles</div>';
    }
  }
});
</script>
{% endblock %}
