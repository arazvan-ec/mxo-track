{% extends 'base.html.twig' %}

{% block title %}Plantillas de Ruta - MXO Track{% endblock %}

{% block content %}
<div class="space-y-6">

  {# Header #}
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold" style="color: var(--color-text-primary);">Plantillas de Ruta</h1>
      <p class="mt-1 text-sm" style="color: var(--color-text-secondary);">Gestiona plantillas reutilizables para la planificacion de rutas.</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <a href="{{ path('admin_route_planner_index') }}"
         class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 transition-colors">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3"/>
        </svg>
        Ir al Planificador
      </a>
    </div>
  </div>

  {# Templates table #}
  <div class="overflow-x-auto rounded-xl shadow-sm" style="border: 1px solid var(--color-border); background: var(--color-surface-elevated);">
    {% if templates|length > 0 %}
    <table class="min-w-full divide-y" style="border-color: var(--color-border);">
      <thead style="background: var(--color-surface);">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-secondary);">Nombre</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-secondary);">Paradas</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-secondary);">Creada</th>
          <th scope="col" class="px-6 py-3 text-right text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-secondary);">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y" style="border-color: var(--color-border);">
        {% for template in templates %}
        <tr class="transition-colors" id="row-{{ template.publicIdString }}">
          <td class="whitespace-nowrap px-6 py-4 text-sm font-medium" style="color: var(--color-text-primary);">{{ template.name }}</td>
          <td class="whitespace-nowrap px-6 py-4 text-sm" style="color: var(--color-text-secondary);">
            <span class="inline-flex items-center rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-medium text-blue-700">
              {{ template.templateData|length }} paradas
            </span>
          </td>
          <td class="whitespace-nowrap px-6 py-4 text-sm" style="color: var(--color-text-secondary);">{{ template.createdAt|date('d/m/Y H:i') }}</td>
          <td class="whitespace-nowrap px-6 py-4 text-right text-sm">
            <div class="flex items-center justify-end gap-2">
              <a href="{{ path('admin_route_planner_index') }}?template={{ template.publicIdString }}"
                 class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-medium shadow-sm transition-colors" style="border: 1px solid var(--color-border); background: var(--color-surface-elevated); color: var(--color-text-secondary);">
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/>
                </svg>
                Cargar
              </a>
              <button type="button"
                      onclick="confirmDelete('{{ template.publicIdString }}', '{{ template.name|e('js') }}')"
                      class="inline-flex items-center gap-1.5 rounded-lg border border-red-200 px-3 py-1.5 text-xs font-medium text-red-600 shadow-sm hover:bg-red-50 transition-colors" style="background: var(--color-surface-elevated);">
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/>
                </svg>
                Eliminar
              </button>
            </div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <div class="px-6 py-12 text-center">
      <svg class="mx-auto h-12 w-12" style="color: var(--color-text-muted);" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
      </svg>
      <h3 class="mt-3 text-sm font-semibold" style="color: var(--color-text-primary);">Sin plantillas</h3>
      <p class="mt-1 text-sm" style="color: var(--color-text-secondary);">Crea plantillas desde el planificador de rutas para reutilizarlas.</p>
      <div class="mt-6">
        <a href="{{ path('admin_route_planner_index') }}"
           class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 transition-colors">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
          </svg>
          Ir al Planificador
        </a>
      </div>
    </div>
    {% endif %}
  </div>
</div>

{# Delete confirmation modal #}
<div id="deleteModal" class="fixed inset-0 z-50 hidden" x-data="{ show: false }" x-show="show" x-cloak>
  <div class="fixed inset-0 bg-gray-500/75 transition-opacity" @click="show = false; document.getElementById('deleteModal').classList.add('hidden')"></div>
  <div class="fixed inset-0 z-10 flex items-center justify-center p-4">
    <div class="relative w-full max-w-md rounded-xl p-6 shadow-xl" style="background: var(--color-surface-elevated);">
      <div class="flex items-start gap-4">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-red-100">
          <svg class="h-5 w-5 text-red-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
          </svg>
        </div>
        <div class="flex-1">
          <h3 class="text-base font-semibold text-gray-900">Eliminar plantilla</h3>
          <p class="mt-2 text-sm text-gray-500">
            Estas seguro de que deseas eliminar la plantilla <strong id="deleteTemplateName"></strong>? Esta accion no se puede deshacer.
          </p>
        </div>
      </div>
      <div class="mt-6 flex justify-end gap-3">
        <button type="button"
                onclick="closeDeleteModal()"
                class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 transition-colors">
          Cancelar
        </button>
        <button type="button"
                id="confirmDeleteBtn"
                class="rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-700 transition-colors">
          Eliminar
        </button>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
  let deletePublicId = null;

  function confirmDelete(publicId, name) {
    deletePublicId = publicId;
    document.getElementById('deleteTemplateName').textContent = name;
    const modal = document.getElementById('deleteModal');
    modal.classList.remove('hidden');
    modal.__x.$data.show = true;
  }

  function closeDeleteModal() {
    const modal = document.getElementById('deleteModal');
    modal.__x.$data.show = false;
    setTimeout(function() { modal.classList.add('hidden'); }, 200);
    deletePublicId = null;
  }

  document.getElementById('confirmDeleteBtn').addEventListener('click', async function() {
    if (!deletePublicId) return;

    try {
      const response = await fetch('{{ path("admin_route_templates_list") }}/' + encodeURIComponent(deletePublicId), {
        method: 'DELETE',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      });

      if (response.ok) {
        const row = document.getElementById('row-' + deletePublicId);
        if (row) row.remove();

        const tbody = document.querySelector('tbody');
        if (tbody && tbody.children.length === 0) {
          window.location.reload();
        }
      } else {
        const data = await response.json();
        alert(data.error || 'Error al eliminar la plantilla.');
      }
    } catch (e) {
      alert('Error de conexion.');
    }

    closeDeleteModal();
  });
</script>
{% endblock %}
