{% extends 'base.html.twig' %}

{% block title %}{{ shipment.id ? 'Editar envio' : 'Nuevo envio' }} - Admin{% endblock %}

{% block content %}
<div class="mx-auto max-w-2xl">
    {# Header #}
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-900">
        {{ shipment.id ? 'Editar envio' : 'Nuevo envio' }}
      </h1>
    </div>

    {# Form #}
    <div class="bg-white shadow rounded-lg p-6">
      {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

        {# Basic info #}
        <div class="mb-6 rounded-lg border border-gray-200 p-4">
          <h3 class="mb-3 text-sm font-semibold text-gray-800">Datos basicos</h3>
          <div class="grid grid-cols-2 gap-4">
            <div>
              {{ form_label(form.reference, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
              {{ form_widget(form.reference) }}
              {{ form_errors(form.reference) }}
            </div>
            <div>
              {{ form_label(form.customer, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
              {{ form_widget(form.customer) }}
              {{ form_errors(form.customer) }}
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4 mt-4">
            <div>
              {{ form_label(form.serviceType, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
              {{ form_widget(form.serviceType) }}
              {{ form_errors(form.serviceType) }}
            </div>
            <div>
              {{ form_label(form.priority, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
              {{ form_widget(form.priority) }}
              {{ form_errors(form.priority) }}
            </div>
          </div>
        </div>

        {# Recipient #}
        <div class="mb-6 rounded-lg border border-gray-200 p-4">
          <h3 class="mb-3 text-sm font-semibold text-gray-800">Destinatario</h3>
          <div class="grid grid-cols-2 gap-4">
            <div>
              {{ form_label(form.recipientName, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
              {{ form_widget(form.recipientName) }}
              {{ form_errors(form.recipientName) }}
            </div>
            <div>
              {{ form_label(form.recipientPhone, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
              {{ form_widget(form.recipientPhone) }}
              {{ form_errors(form.recipientPhone) }}
            </div>
          </div>
        </div>

        {# Location #}
        <div class="mb-6 rounded-lg border border-gray-200 p-4">
          <h3 class="mb-3 text-sm font-semibold text-gray-800">Ubicacion</h3>
          <div class="mb-4">
            {{ form_label(form.address, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.address) }}
            {{ form_errors(form.address) }}
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              {{ form_label(form.latitude, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
              {{ form_widget(form.latitude) }}
              {{ form_errors(form.latitude) }}
            </div>
            <div>
              {{ form_label(form.longitude, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
              {{ form_widget(form.longitude) }}
              {{ form_errors(form.longitude) }}
            </div>
          </div>
        </div>

        {# Cargo #}
        <div class="mb-6 rounded-lg border border-gray-200 p-4">
          <h3 class="mb-3 text-sm font-semibold text-gray-800">Carga</h3>
          <div class="grid grid-cols-3 gap-4">
            <div>
              {{ form_label(form.totalWeightKg, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
              {{ form_widget(form.totalWeightKg) }}
              {{ form_errors(form.totalWeightKg) }}
            </div>
            <div>
              {{ form_label(form.totalVolumeM3, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
              {{ form_widget(form.totalVolumeM3) }}
              {{ form_errors(form.totalVolumeM3) }}
            </div>
            <div>
              {{ form_label(form.totalParcels, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
              {{ form_widget(form.totalParcels) }}
              {{ form_errors(form.totalParcels) }}
            </div>
          </div>
        </div>

        {# Scheduling #}
        <div class="mb-6 rounded-lg border border-gray-200 p-4">
          <h3 class="mb-3 text-sm font-semibold text-gray-800">Programacion</h3>
          <div class="grid grid-cols-2 gap-4">
            <div>
              {{ form_label(form.estimatedDeliveryDate, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
              {{ form_widget(form.estimatedDeliveryDate) }}
              {{ form_errors(form.estimatedDeliveryDate) }}
            </div>
            <div>
              {{ form_label(form.serviceTimeSeconds, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
              {{ form_widget(form.serviceTimeSeconds) }}
              {{ form_errors(form.serviceTimeSeconds) }}
            </div>
          </div>
        </div>

        {# Skills #}
        <div class="mb-6 rounded-lg border border-gray-200 p-4">
          <h3 class="mb-3 text-sm font-semibold text-gray-800">Skills requeridos</h3>
          <p class="mb-3 text-xs text-gray-500">Selecciona las capacidades especiales necesarias para este envio.</p>
          <div class="space-y-2">
            {% for child in form.requiredSkills %}
              <div class="flex items-center">
                {{ form_widget(child, {'attr': {'class': 'h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500'}}) }}
                {{ form_label(child, null, {'label_attr': {'class': 'ml-2 block text-sm text-gray-700'}}) }}
              </div>
            {% endfor %}
          </div>
          {{ form_errors(form.requiredSkills) }}
        </div>

        {# Notes #}
        <div class="mb-6">
          {{ form_label(form.notes, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
          {{ form_widget(form.notes) }}
          {{ form_errors(form.notes) }}
        </div>

        {# Actions #}
        <div class="flex items-center justify-between pt-4 border-t border-gray-200">
          <a href="{{ path('admin_shipments_index') }}"
             class="text-sm font-medium text-gray-600 hover:text-gray-900">
            Cancelar
          </a>
          <button type="submit"
                  class="inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
            {{ shipment.id ? 'Guardar cambios' : 'Crear envio' }}
          </button>
        </div>

      {{ form_end(form) }}
    </div>

</div>
{% endblock %}
