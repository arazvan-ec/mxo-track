{% extends 'base.html.twig' %}

{% block title %}Dashboard - MXO Track{% endblock %}

{% block breadcrumbs %}
  <li>
    <div class="flex items-center">
      <svg class="h-5 w-5 shrink-0 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
      </svg>
      <span class="ml-2 text-sm font-medium text-gray-500">Dashboard</span>
    </div>
  </li>
{% endblock %}

{% block content %}
<div x-data="adminDashboard()" x-init="init()">

{# ── Page header ──────────────────────────────────────────────────── #}
<div class="mb-8 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold tracking-tight text-gray-900">Dashboard</h1>
    <p class="mt-1 text-sm text-gray-500">
      Vista general del sistema de seguimiento logistico
    </p>
  </div>
  <div class="flex items-center gap-3">
    {# Live indicator #}
    <div class="flex items-center gap-2 rounded-full bg-gray-50 px-3 py-1.5 ring-1 ring-gray-200">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full opacity-75"
              :class="sseConnected ? 'bg-emerald-400' : 'bg-red-400'"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full"
              :class="sseConnected ? 'bg-emerald-500' : 'bg-red-500'"></span>
      </span>
      <span class="text-xs font-medium text-gray-600" x-text="sseConnected ? 'En vivo' : 'Desconectado'"></span>
    </div>
    {# Last refresh #}
    <span class="text-xs text-gray-400" x-text="lastRefresh ? 'Actualizado ' + lastRefresh : ''"></span>
  </div>
</div>

{# ── System Health Status Cards ───────────────────────────────────── #}
<div class="mb-8">
  <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Estado del sistema</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

    {# Database #}
    <div class="rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5 p-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg"
               :class="health.db_ok ? 'bg-emerald-50' : 'bg-red-50'">
            <svg class="h-5 w-5" :class="health.db_ok ? 'text-emerald-600' : 'text-red-600'" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-900">PostgreSQL</p>
            <p class="text-xs" :class="health.db_ok ? 'text-emerald-600' : 'text-red-600'" x-text="health.db_ok ? 'Conectado' : 'Sin conexion'"></p>
          </div>
        </div>
        <span class="text-xs font-mono tabular-nums"
              :class="liveData.database.latency_ms > 100 ? 'text-amber-600' : 'text-gray-400'"
              x-text="liveData.database.latency_ms + 'ms'"></span>
      </div>
    </div>

    {# Redis #}
    <div class="rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5 p-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg"
               :class="health.redis_ok ? 'bg-emerald-50' : 'bg-red-50'">
            <svg class="h-5 w-5" :class="health.redis_ok ? 'text-emerald-600' : 'text-red-600'" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-900">Redis</p>
            <p class="text-xs" :class="health.redis_ok ? 'text-emerald-600' : 'text-red-600'" x-text="health.redis_ok ? 'Conectado' : 'Sin conexion'"></p>
          </div>
        </div>
        <span class="text-xs font-mono tabular-nums"
              :class="liveData.redis.latency_ms > 50 ? 'text-amber-600' : 'text-gray-400'"
              x-text="liveData.redis.latency_ms + 'ms'"></span>
      </div>
    </div>

    {# Traccar #}
    <div class="rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5 p-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg"
               :class="health.traccar_ok ? 'bg-emerald-50' : 'bg-red-50'">
            <svg class="h-5 w-5" :class="health.traccar_ok ? 'text-emerald-600' : 'text-red-600'" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 011.06 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-900">Traccar API</p>
            <p class="text-xs" :class="health.traccar_ok ? 'text-emerald-600' : 'text-red-600'" x-text="health.traccar_ok ? 'Conectado' : 'Sin conexion'"></p>
          </div>
        </div>
        <span class="text-xs font-mono tabular-nums"
              :class="liveData.traccar.latency_ms > 500 ? 'text-amber-600' : 'text-gray-400'"
              x-text="liveData.traccar.latency_ms + 'ms'"></span>
      </div>
    </div>

    {# Mercure #}
    <div class="rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5 p-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg"
               :class="health.mercure_ok ? 'bg-emerald-50' : 'bg-red-50'">
            <svg class="h-5 w-5" :class="health.mercure_ok ? 'text-emerald-600' : 'text-red-600'" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-900">Mercure Hub</p>
            <p class="text-xs" :class="health.mercure_ok ? 'text-emerald-600' : 'text-red-600'" x-text="health.mercure_ok ? 'Conectado' : 'Sin conexion'"></p>
          </div>
        </div>
        <span class="text-xs font-mono tabular-nums"
              :class="liveData.mercure.latency_ms > 500 ? 'text-amber-600' : 'text-gray-400'"
              x-text="liveData.mercure.latency_ms + 'ms'"></span>
      </div>
    </div>

    {# OSRM #}
    <div class="rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5 p-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg"
               :class="health.osrm_ok ? 'bg-emerald-50' : 'bg-red-50'">
            <svg class="h-5 w-5" :class="health.osrm_ok ? 'text-emerald-600' : 'text-red-600'" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-900">OSRM (Routing)</p>
            <p class="text-xs" :class="health.osrm_ok ? 'text-emerald-600' : 'text-red-600'" x-text="health.osrm_ok ? 'Conectado' : 'Sin conexion'"></p>
          </div>
        </div>
        <span class="text-xs font-mono tabular-nums"
              :class="liveData.osrm.latency_ms > 500 ? 'text-amber-600' : 'text-gray-400'"
              x-text="liveData.osrm.latency_ms + 'ms'"></span>
      </div>
    </div>

    {# VROOM #}
    <div class="rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5 p-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg"
               :class="health.vroom_ok ? 'bg-emerald-50' : 'bg-red-50'">
            <svg class="h-5 w-5" :class="health.vroom_ok ? 'text-emerald-600' : 'text-red-600'" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-900">VROOM (Optimizer)</p>
            <p class="text-xs" :class="health.vroom_ok ? 'text-emerald-600' : 'text-red-600'" x-text="health.vroom_ok ? 'Conectado' : 'Sin conexion'"></p>
          </div>
        </div>
        <span class="text-xs font-mono tabular-nums"
              :class="liveData.vroom.latency_ms > 500 ? 'text-amber-600' : 'text-gray-400'"
              x-text="liveData.vroom.latency_ms + 'ms'"></span>
      </div>
    </div>

  </div>
</div>

{# ── Infrastructure Metrics ──────────────────────────────────────── #}
<div class="mb-8">
  <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Infraestructura</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">

    {# Positions table #}
    <div class="rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5 p-4">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg"
             :class="liveData.positions.warning ? 'bg-amber-50' : 'bg-blue-50'">
          <svg class="h-5 w-5" :class="liveData.positions.warning ? 'text-amber-600' : 'text-blue-600'" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-900">Posiciones (tabla)</p>
          <p class="text-lg font-bold tabular-nums" :class="liveData.positions.warning ? 'text-amber-600' : 'text-gray-900'" x-text="Number(liveData.positions.row_count).toLocaleString('es-ES')"></p>
          <p class="text-xs text-amber-600" x-show="liveData.positions.warning">Excede 1M filas - considerar purge</p>
        </div>
      </div>
    </div>

    {# DB size #}
    <div class="rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5 p-4">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-purple-50">
          <svg class="h-5 w-5 text-purple-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 17.25v-.228a4.5 4.5 0 00-.12-1.03l-2.268-9.64a3.375 3.375 0 00-3.285-2.602H7.923a3.375 3.375 0 00-3.285 2.602l-2.268 9.64a4.5 4.5 0 00-.12 1.03v.228m19.5 0a3 3 0 01-3 3H5.25a3 3 0 01-3-3m19.5 0a3 3 0 00-3-3H5.25a3 3 0 00-3 3m16.5 0h.008v.008h-.008v-.008zm-3 0h.008v.008h-.008v-.008z"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-900">Base de datos</p>
          <p class="text-lg font-bold tabular-nums text-gray-900" x-text="liveData.disk.db_size_mb + ' MB'"></p>
        </div>
      </div>
    </div>

    {# Last ingestion #}
    <div class="rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5 p-4">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg"
             :class="liveData.last_ingestion.seconds_ago !== null && liveData.last_ingestion.seconds_ago > 1800 ? 'bg-amber-50' : 'bg-teal-50'">
          <svg class="h-5 w-5" :class="liveData.last_ingestion.seconds_ago !== null && liveData.last_ingestion.seconds_ago > 1800 ? 'text-amber-600' : 'text-teal-600'" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-900">Ultima ingestion</p>
          <template x-if="liveData.last_ingestion.timestamp !== null">
            <div>
              <p class="text-sm font-bold tabular-nums text-gray-900" x-text="formatSecondsAgo(liveData.last_ingestion.seconds_ago)"></p>
              <p class="text-xs text-gray-400" x-text="liveData.last_ingestion.timestamp ? new Date(liveData.last_ingestion.timestamp).toLocaleString('es-ES') : ''"></p>
            </div>
          </template>
          <template x-if="liveData.last_ingestion.timestamp === null">
            <p class="text-sm text-gray-400">Sin datos</p>
          </template>
        </div>
      </div>
    </div>

  </div>
</div>

{# ── Health pills (legacy compact view) ──────────────────────────── #}
<div class="mb-8 flex flex-wrap gap-4">
  {# Live position counter #}
  <div class="inline-flex items-center gap-2 rounded-full bg-cyan-50 px-4 py-2 text-sm font-medium text-cyan-700 shadow-sm ring-1 ring-inset ring-cyan-200"
       x-show="livePositionCount > 0"
       x-transition>
    <svg class="h-4 w-4 animate-pulse" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l8.735 8.735m0 0a.374.374 0 11.53.53m-.53-.53l.53.53m0 0L21 21M14.652 9.348a3.75 3.75 0 010 5.304m2.121-7.425a6.75 6.75 0 010 9.546m2.121-11.667c3.808 3.807 3.808 9.98 0 13.788"/>
    </svg>
    <span x-text="livePositionCount + ' posiciones recibidas'"></span>
  </div>
</div>

{# ── KPI cards grid ───────────────────────────────────────────────── #}
<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">

  {# ── Rutas activas ──────────────────────────────────────────────── #}
  <div class="relative overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5">
    <div class="p-6">
      <div class="flex items-center gap-4">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-indigo-50">
          <svg class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/>
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-sm font-medium text-gray-500 truncate">Rutas activas</p>
          <p class="mt-1 text-2xl font-bold tracking-tight text-gray-900 transition-all duration-500" x-text="kpis.active_routes"></p>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-1 bg-indigo-400"></div>
  </div>

  {# ── Paradas pendientes ─────────────────────────────────────────── #}
  <div class="relative overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5">
    <div class="p-6">
      <div class="flex items-center gap-4">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-orange-50">
          <svg class="h-6 w-6 text-orange-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-sm font-medium text-gray-500 truncate">Paradas pendientes</p>
          <p class="mt-1 text-2xl font-bold tracking-tight text-gray-900 transition-all duration-500" x-text="kpis.pending_stops"></p>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-1 bg-orange-400"></div>
  </div>

  {# ── Imports CSV hoy ────────────────────────────────────────────── #}
  <div class="relative overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5">
    <div class="p-6">
      <div class="flex items-center gap-4">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-violet-50">
          <svg class="h-6 w-6 text-violet-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/>
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-sm font-medium text-gray-500 truncate">Imports CSV hoy</p>
          <p class="mt-1 text-2xl font-bold tracking-tight text-gray-900 transition-all duration-500" x-text="kpis.import_runs_today"></p>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-1 bg-violet-400"></div>
  </div>

  {# ── Posiciones ingeridas (ultima hora) ─────────────────────────── #}
  <div class="relative overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5">
    <div class="p-6">
      <div class="flex items-center gap-4">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-cyan-50">
          <svg class="h-6 w-6 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 7.5h-.75A2.25 2.25 0 004.5 9.75v7.5a2.25 2.25 0 002.25 2.25h7.5a2.25 2.25 0 002.25-2.25v-7.5a2.25 2.25 0 00-2.25-2.25h-.75m0-3l-3-3m0 0l-3 3m3-3v11.25m6-2.25h.75a2.25 2.25 0 012.25 2.25v7.5a2.25 2.25 0 01-2.25 2.25h-7.5a2.25 2.25 0 01-2.25-2.25v-.75"/>
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-sm font-medium text-gray-500 truncate">Posiciones (ultima hora)</p>
          <p class="mt-1 text-2xl font-bold tracking-tight text-gray-900 transition-all duration-500" x-text="kpis.positions_ingested_last_hour"></p>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-1 bg-cyan-400"></div>
  </div>

</div>

{# ── Mini Reports Section ───────────────────────────────────────── #}
