{# ── Live Activity Feed ──────────────────────────────────────────── #}
<div class="mt-8">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-semibold text-gray-900">Actividad en vivo</h2>
    <div class="flex items-center gap-2">
      <a href="{{ path('fleet_map') }}"
         class="inline-flex items-center gap-1.5 rounded-lg bg-brand-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-brand-500 transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
        </svg>
        Abrir mapa
      </a>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm ring-1 ring-gray-900/5 overflow-hidden">
    <div class="max-h-80 overflow-y-auto divide-y divide-gray-100">
      <template x-if="activityFeed.length === 0">
        <div class="px-6 py-8 text-center">
          <svg class="mx-auto h-10 w-10 text-gray-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l8.735 8.735m0 0a.374.374 0 11.53.53m-.53-.53l.53.53m0 0L21 21M14.652 9.348a3.75 3.75 0 010 5.304m2.121-7.425a6.75 6.75 0 010 9.546m2.121-11.667c3.808 3.807 3.808 9.98 0 13.788"/>
          </svg>
          <p class="mt-2 text-sm text-gray-500">Esperando actividad en tiempo real...</p>
          <p class="mt-1 text-xs text-gray-400">Las posiciones de vehiculos apareceran aqui</p>
        </div>
      </template>

      <template x-for="event in activityFeed" :key="event.id">
        <div class="flex items-center gap-4 px-6 py-3 hover:bg-gray-50 transition-colors"
             x-transition:enter="transition ease-out duration-300"
             x-transition:enter-start="opacity-0 -translate-y-2"
             x-transition:enter-end="opacity-100 translate-y-0">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-cyan-100">
            <svg class="h-4 w-4 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <p class="text-sm text-gray-900">
              <span class="font-medium" x-text="event.vehicleName"></span>
              <span class="text-gray-500"> reporto posicion</span>
            </p>
            <p class="text-xs text-gray-400" x-text="event.coords + (event.speed ? ' · ' + event.speed + ' km/h' : '')"></p>
          </div>
          <span class="text-xs text-gray-400 shrink-0" x-text="event.time"></span>
        </div>
      </template>
    </div>
  </div>
</div>

</div>

<script>
function adminDashboard() {
  return {
    kpis: {
      active_routes: {{ kpis.active_routes }},
      pending_stops: {{ kpis.pending_stops }},
      import_runs_today: {{ kpis.import_runs_today }},
      positions_ingested_last_hour: {{ kpis.positions_ingested_last_hour }},
    },
    health: {
      traccar_ok: {{ health.traccar_ok ? 'true' : 'false' }},
      mercure_ok: {{ health.mercure_ok ? 'true' : 'false' }},
      db_ok: {{ health.db_ok ? 'true' : 'false' }},
      redis_ok: {{ health.redis_ok ? 'true' : 'false' }},
      osrm_ok: {{ health.osrm_ok ? 'true' : 'false' }},
      vroom_ok: {{ health.vroom_ok ? 'true' : 'false' }},
    },
    liveData: {
      database: { ok: {{ live.database.ok ? 'true' : 'false' }}, latency_ms: {{ live.database.latency_ms }} },
      redis: { ok: {{ live.redis.ok ? 'true' : 'false' }}, latency_ms: {{ live.redis.latency_ms }} },
      traccar: { ok: {{ live.traccar.ok ? 'true' : 'false' }}, latency_ms: {{ live.traccar.latency_ms }} },
      mercure: { ok: {{ live.mercure.ok ? 'true' : 'false' }}, latency_ms: {{ live.mercure.latency_ms }} },
      osrm: { ok: {{ live.osrm.ok ? 'true' : 'false' }}, latency_ms: {{ live.osrm.latency_ms }} },
      vroom: { ok: {{ live.vroom.ok ? 'true' : 'false' }}, latency_ms: {{ live.vroom.latency_ms }} },
      positions: { row_count: {{ live.positions.row_count }}, warning: {{ live.positions.warning ? 'true' : 'false' }} },
      disk: { db_size_mb: {{ live.disk.db_size_mb }} },
      last_ingestion: {
        timestamp: {{ live.last_ingestion.timestamp ? ("'" ~ live.last_ingestion.timestamp ~ "'")|raw : 'null' }},
        seconds_ago: {{ live.last_ingestion.seconds_ago ?? 'null' }},
      },
    },
    sseConnected: false,
    livePositionCount: 0,
    lastRefresh: null,
    activityFeed: [],
    _eventSource: null,
    _refreshInterval: null,
    _vehicleNames: {},

    formatSecondsAgo(seconds) {
      if (seconds === null) return 'Sin datos';
      if (seconds < 60) return 'hace ' + seconds + 's';
      if (seconds < 3600) return 'hace ' + Math.floor(seconds / 60) + 'min';
      if (seconds < 86400) return 'hace ' + Math.floor(seconds / 3600) + 'h';
      return 'hace ' + Math.floor(seconds / 86400) + 'd';
    },

    async init() {
      // Load vehicle names and Mercure token for the activity feed
      try {
        const tokenRes = await fetch('/api/mercure-token', { credentials: 'include' });
        if (tokenRes.ok) {
          const tokenData = await tokenRes.json();
          this._mercureToken = tokenData.token;
        }
        const res = await fetch('/api/vehicles', { credentials: 'include' });
        if (res.ok) {
          const data = await res.json();
          (data.items || []).forEach(v => {
            this._vehicleNames[v.public_id] = v.name;
          });
        }
      } catch (_) {}

      // Start SSE for live position updates
      this._connectSSE();

      // Auto-refresh KPIs every 30 seconds
      this._refreshInterval = setInterval(() => this._refreshKpis(), 30000);
      this._refreshKpis();

      // Cleanup on navigation
      window.addEventListener('beforeunload', () => this._cleanup());
    },

    _connectSSE() {
      try {
        const hub = new URL('{{ mercure_public_url }}');
        // Subscribe to all vehicle topics by listing them
        Object.keys(this._vehicleNames).forEach(id => {
          hub.searchParams.append('topic', '/map/vehicles/' + id + '/position');
        });

        if (Object.keys(this._vehicleNames).length === 0) {
          // No vehicles, skip SSE
          return;
        }

        if (this._mercureToken) {
          hub.searchParams.set('authorization', this._mercureToken);
        }

        this._eventSource = new EventSource(hub);

        this._eventSource.onopen = () => {
          this.sseConnected = true;
        };

        this._eventSource.onmessage = (event) => {
          try {
            const d = JSON.parse(event.data);
            this.livePositionCount++;

            // Add to activity feed (max 50 entries)
            const vehicleName = this._vehicleNames[d.vehicleId] || d.vehicleId || 'Vehiculo';
            const now = new Date();
            this.activityFeed.unshift({
              id: Date.now() + '-' + Math.random(),
              vehicleName: vehicleName,
              coords: (d.lat ? d.lat.toFixed(4) : '?') + ', ' + (d.lng ? d.lng.toFixed(4) : '?'),
              speed: d.speed ? Math.round(d.speed) : null,
              time: now.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit', second: '2-digit' }),
            });

            if (this.activityFeed.length > 50) {
              this.activityFeed = this.activityFeed.slice(0, 50);
            }
          } catch (_) {}
        };

        this._eventSource.onerror = () => {
          this.sseConnected = false;
        };
      } catch (_) {
        this.sseConnected = false;
      }
    },

    async _refreshKpis() {
      try {
        const res = await fetch('/admin/health', { credentials: 'include' });
        if (res.ok) {
          const data = await res.json();
          if (data.metrics) {
            this.kpis.active_routes = data.metrics.active_routes ?? this.kpis.active_routes;
            this.kpis.pending_stops = data.metrics.pending_stops ?? this.kpis.pending_stops;
            this.kpis.import_runs_today = data.metrics.import_runs_today ?? this.kpis.import_runs_today;
            this.kpis.positions_ingested_last_hour = data.metrics.positions_ingested_last_hour ?? this.kpis.positions_ingested_last_hour;
          }
          if (data.health) {
            this.health.traccar_ok = data.health.traccar_ok ?? this.health.traccar_ok;
            this.health.mercure_ok = data.health.mercure_ok ?? this.health.mercure_ok;
            this.health.db_ok = data.health.db_ok ?? this.health.db_ok;
            this.health.redis_ok = data.health.redis_ok ?? this.health.redis_ok;
            this.health.osrm_ok = data.health.osrm_ok ?? this.health.osrm_ok;
            this.health.vroom_ok = data.health.vroom_ok ?? this.health.vroom_ok;
          }
          if (data.live) {
            this.liveData.database = data.live.database ?? this.liveData.database;
            this.liveData.redis = data.live.redis ?? this.liveData.redis;
            this.liveData.traccar = data.live.traccar ?? this.liveData.traccar;
            this.liveData.mercure = data.live.mercure ?? this.liveData.mercure;
            this.liveData.osrm = data.live.osrm ?? this.liveData.osrm;
            this.liveData.vroom = data.live.vroom ?? this.liveData.vroom;
            this.liveData.positions = data.live.positions ?? this.liveData.positions;
            this.liveData.disk = data.live.disk ?? this.liveData.disk;
            this.liveData.last_ingestion = data.live.last_ingestion ?? this.liveData.last_ingestion;
          }
          const now = new Date();
          this.lastRefresh = now.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
        }
      } catch (_) {}
    },

    _cleanup() {
      if (this._eventSource) { this._eventSource.close(); }
      if (this._refreshInterval) { clearInterval(this._refreshInterval); }
    }
  };
}
</script>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const dailyData = {{ daily_deliveries|json_encode|raw }};
  const ctx = document.getElementById('miniTrendChart');
  if (ctx && dailyData.length > 0) {
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: dailyData.map(d => d.date),
        datasets: [{
          label: 'Entregas',
          data: dailyData.map(d => d.deliveries),
          borderColor: '#10b981',
          backgroundColor: 'rgba(16, 185, 129, 0.1)',
          fill: true,
          tension: 0.4,
          pointRadius: 3,
          pointHoverRadius: 5,
          borderWidth: 2,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: { precision: 0, font: { size: 11 } },
            grid: { color: 'rgba(0,0,0,0.04)' },
          },
          x: {
            ticks: { font: { size: 11 } },
            grid: { display: false },
          }
        }
      }
    });
  }
});
</script>

{% endblock %}
