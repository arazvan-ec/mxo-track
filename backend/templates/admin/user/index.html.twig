{% extends 'base.html.twig' %}

{% block title %}Usuarios - Admin{% endblock %}

{% block content %}
    <div class="sm:flex sm:items-center sm:justify-between mb-6">
      <h1 class="text-2xl font-bold text-gray-900">Usuarios</h1>
      <a href="{{ path('admin_users_new') }}"
         class="inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
        Nuevo usuario
      </a>
    </div>

    <div class="overflow-hidden bg-white shadow ring-1 ring-gray-200 sm:rounded-lg">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Email</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Nombre</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Rol</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Cliente</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Estado</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Creado</th>
            <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          {% for u in users %}
            <tr>
              <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900">
                {{ u.email }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                {{ u.name ?? '-' }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm">
                {% if u.hasRole('ROLE_ADMIN') %}
                  <span class="inline-flex rounded-full bg-purple-100 px-2 text-xs font-semibold leading-5 text-purple-800">Administrador</span>
                {% elseif u.hasRole('ROLE_CUSTOMER') %}
                  <span class="inline-flex rounded-full bg-teal-100 px-2 text-xs font-semibold leading-5 text-teal-800">Cliente</span>
                {% elseif u.hasRole('ROLE_DRIVER') %}
                  <span class="inline-flex rounded-full bg-amber-100 px-2 text-xs font-semibold leading-5 text-amber-800">Transportista</span>
                {% else %}
                  <span class="inline-flex rounded-full bg-gray-100 px-2 text-xs font-semibold leading-5 text-gray-800">Usuario</span>
                {% endif %}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                {{ u.customer ? u.customer.name : '-' }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm">
                {% if u.active %}
                  <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Activo</span>
                {% else %}
                  <span class="inline-flex rounded-full bg-red-100 px-2 text-xs font-semibold leading-5 text-red-800">Inactivo</span>
                {% endif %}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                {{ u.createdAt|date('d/m/Y H:i') }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                <a href="{{ path('admin_users_edit', {publicId: u.publicIdString}) }}"
                   class="text-blue-600 hover:text-blue-800 mr-3">Editar</a>
                <form method="post" action="{{ path('admin_users_delete', {publicId: u.publicIdString}) }}"
                      class="inline"
                      onsubmit="return confirm('Desactivar este usuario?');">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ u.publicIdString) }}">
                  <button type="submit" class="text-red-600 hover:text-red-800">Eliminar</button>
                </form>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="7" class="px-6 py-4 text-center text-sm text-gray-500">
                No hay usuarios registrados.
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    {% if totalPages > 1 %}
      <nav class="mt-6 flex items-center justify-between">
        <div class="flex flex-1 justify-between sm:justify-end space-x-2">
          {% if page > 1 %}
            <a href="{{ path('admin_users_index', {page: page - 1}) }}"
               class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
              Anterior
            </a>
          {% endif %}
          <span class="inline-flex items-center px-4 py-2 text-sm text-gray-700">
            Pagina {{ page }} de {{ totalPages }}
          </span>
          {% if page < totalPages %}
            <a href="{{ path('admin_users_index', {page: page + 1}) }}"
               class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
              Siguiente
            </a>
          {% endif %}
        </div>
      </nav>
    {% endif %}
{% endblock %}
