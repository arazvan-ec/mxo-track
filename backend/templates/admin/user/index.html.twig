{% extends 'base.html.twig' %}

{% block title %}Usuarios - Admin{% endblock %}

{% block content %}
    <div class="sm:flex sm:items-center sm:justify-between mb-6">
      <h1 class="text-2xl font-bold" style="color: var(--color-text-primary);">Usuarios</h1>
      <a href="{{ path('admin_users_new') }}"
         class="inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
        Nuevo usuario
      </a>
    </div>

    <div class="theme-card overflow-x-auto">
      <table class="min-w-full divide-y" style="border-color: var(--color-border);">
        <thead style="background: var(--color-surface);">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Email</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Nombre</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Rol</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Cliente</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Estado</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Creado</th>
            <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y" style="border-color: var(--color-border); background: var(--color-surface-elevated);">
          {% for u in users %}
            <tr>
              <td class="whitespace-nowrap px-6 py-4 text-sm font-medium" style="color: var(--color-text-primary);">
                {{ u.email }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm" style="color: var(--color-text-secondary);">
                {{ u.name ?? '-' }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm">
                {% if u.hasRole('ROLE_ADMIN') %}
                  <span class="inline-flex rounded-full badge-purple px-2 text-xs font-semibold leading-5">Administrador</span>
                {% elseif u.hasRole('ROLE_CUSTOMER') %}
                  <span class="inline-flex rounded-full bg-teal-100 px-2 text-xs font-semibold leading-5 text-teal-800">Cliente</span>
                {% elseif u.hasRole('ROLE_DRIVER') %}
                  <span class="inline-flex rounded-full badge-amber px-2 text-xs font-semibold leading-5">Transportista</span>
                {% else %}
                  <span class="inline-flex rounded-full badge-gray px-2 text-xs font-semibold leading-5">Usuario</span>
                {% endif %}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm" style="color: var(--color-text-secondary);">
                {{ u.customer ? u.customer.name : '-' }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm">
                {% if u.active %}
                  <span class="inline-flex rounded-full badge-green px-2 text-xs font-semibold leading-5">Activo</span>
                {% else %}
                  <span class="inline-flex rounded-full badge-red px-2 text-xs font-semibold leading-5">Inactivo</span>
                {% endif %}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm" style="color: var(--color-text-secondary);">
                {{ u.createdAt|date('d/m/Y H:i') }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                <a href="{{ path('admin_users_edit', {publicId: u.publicIdString}) }}"
                   class="text-blue-600 hover:opacity-80 mr-3">Editar</a>
                <form method="post" action="{{ path('admin_users_delete', {publicId: u.publicIdString}) }}"
                      class="inline"
                      onsubmit="return confirm('Desactivar este usuario?');">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ u.publicIdString) }}">
                  <button type="submit" class="text-red-600 hover:opacity-80">Eliminar</button>
                </form>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="7" class="px-6 py-4 text-center text-sm" style="color: var(--color-text-secondary);">
                No hay usuarios registrados.
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    {% if totalPages > 1 %}
      <nav class="mt-6 flex items-center justify-between">
        <div class="flex flex-1 justify-between sm:justify-end space-x-2">
          {% if page > 1 %}
            <a href="{{ path('admin_users_index', {page: page - 1}) }}"
               class="theme-card rounded-md px-4 py-2 text-sm font-medium" style="color: var(--color-text-secondary);">
              Anterior
            </a>
          {% endif %}
          <span class="inline-flex items-center px-4 py-2 text-sm" style="color: var(--color-text-secondary);">
            Pagina {{ page }} de {{ totalPages }}
          </span>
          {% if page < totalPages %}
            <a href="{{ path('admin_users_index', {page: page + 1}) }}"
               class="theme-card rounded-md px-4 py-2 text-sm font-medium" style="color: var(--color-text-secondary);">
              Siguiente
            </a>
          {% endif %}
        </div>
      </nav>
    {% endif %}
{% endblock %}
