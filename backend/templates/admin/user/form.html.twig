{% extends 'base.html.twig' %}

{% block title %}{{ editedUser.id ? 'Editar usuario' : 'Nuevo usuario' }} - Admin{% endblock %}

{% block content %}
    <div class="mb-6">
      <a href="{{ path('admin_users_index') }}" class="text-sm text-blue-600 hover:text-blue-800 hover:underline">
        &larr; Volver a usuarios
      </a>
    </div>

    <h1 class="text-2xl font-bold text-gray-900 mb-6">
      {{ editedUser.id ? 'Editar usuario' : 'Nuevo usuario' }}
    </h1>

    <div class="bg-white shadow sm:rounded-lg">
      {{ form_start(form, {attr: {class: 'space-y-6 p-6'}}) }}

        <div>
          {{ form_label(form.email, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
          {{ form_widget(form.email) }}
          {{ form_errors(form.email) }}
        </div>

        <div>
          {{ form_label(form.plainPassword, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
          {{ form_widget(form.plainPassword) }}
          {{ form_errors(form.plainPassword) }}
          {% if editedUser.id %}
            <p class="mt-1 text-xs text-gray-500">Dejar vacio para mantener la contrasena actual.</p>
          {% endif %}
        </div>

        <div>
          {{ form_label(form.role, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
          {{ form_widget(form.role) }}
          {{ form_errors(form.role) }}
        </div>

        <div>
          {{ form_label(form.customer, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
          {{ form_widget(form.customer) }}
          {{ form_errors(form.customer) }}
        </div>

        <div class="flex items-center">
          {{ form_widget(form.isActive, {attr: {class: 'h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500'}}) }}
          {{ form_label(form.isActive, null, {label_attr: {class: 'ml-2 block text-sm text-gray-700'}}) }}
          {{ form_errors(form.isActive) }}
        </div>

        <div class="flex items-center justify-end space-x-3 pt-4 border-t border-gray-200">
          <a href="{{ path('admin_users_index') }}"
             class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
            Cancelar
          </a>
          <button type="submit"
                  class="rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
            {{ editedUser.id ? 'Guardar cambios' : 'Crear usuario' }}
          </button>
        </div>

      {{ form_end(form) }}
    </div>
{% endblock %}
