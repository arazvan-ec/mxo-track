{% extends 'base.html.twig' %}

{% block title %}Conductores - Admin{% endblock %}

{% block content %}
    {# Header #}
    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-gray-900">Conductores</h1>
      <a href="{{ path('admin_drivers_new') }}"
         class="inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
        Nuevo conductor
      </a>
    </div>

    {# Table #}
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Email</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Almacen</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Estado</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Creado</th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          {% for driver in drivers %}
            <tr>
              <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900">
                {{ driver.email }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                {{ driver.customer ? driver.customer.name : '-' }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm">
                {% if driver.active %}
                  <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Activo</span>
                {% else %}
                  <span class="inline-flex rounded-full bg-red-100 px-2 text-xs font-semibold leading-5 text-red-800">Inactivo</span>
                {% endif %}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                {{ driver.createdAt|date('d/m/Y H:i') }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                <a href="{{ path('admin_drivers_edit', {publicId: driver.publicIdString}) }}"
                   class="text-blue-600 hover:text-blue-900 mr-3">Editar</a>
                {% if driver.active %}
                  <form method="post" action="{{ path('admin_drivers_delete', {publicId: driver.publicIdString}) }}" class="inline"
                        onsubmit="return confirm('Desactivar este conductor?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-driver-' ~ driver.publicIdString) }}">
                    <button type="submit" class="text-red-600 hover:text-red-900">Desactivar</button>
                  </form>
                {% endif %}
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="5" class="px-6 py-8 text-center text-sm text-gray-500">
                No hay conductores registrados.
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    {# Pagination #}
    {% if totalPages > 1 %}
      <nav class="mt-6 flex items-center justify-between">
        <div class="text-sm text-gray-700">
          Pagina {{ page }} de {{ totalPages }}
        </div>
        <div class="flex space-x-2">
          {% if page > 1 %}
            <a href="{{ path('admin_drivers_index', {page: page - 1}) }}"
               class="inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
              Anterior
            </a>
          {% endif %}
          {% if page < totalPages %}
            <a href="{{ path('admin_drivers_index', {page: page + 1}) }}"
               class="inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
              Siguiente
            </a>
          {% endif %}
        </div>
      </nav>
    {% endif %}

{% endblock %}
