{% extends 'base.html.twig' %}

{% block title %}{{ driver.id ? 'Editar conductor' : 'Nuevo conductor' }} - Admin{% endblock %}

{% block content %}
<div class="mx-auto max-w-2xl">
    {# Header #}
    <div class="mb-6">
      <h1 class="text-2xl font-bold" style="color: var(--color-text-primary);">
        {{ driver.id ? 'Editar conductor' : 'Nuevo conductor' }}
      </h1>
    </div>

    {# Form #}
    <div class="theme-card p-6">
      {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

        <div class="mb-4">
          {{ form_label(form.name, null, {'label_attr': {'class': 'block text-sm font-medium mb-1', 'style': 'color: var(--color-text-secondary);'}}) }}
          {{ form_widget(form.name, {'attr': {'class': 'w-full rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', 'style': 'border-color: var(--color-border); background: var(--color-surface-elevated); color: var(--color-text-primary);'}}) }}
          {{ form_errors(form.name) }}
        </div>

        <div class="mb-4">
          {{ form_label(form.email, null, {'label_attr': {'class': 'block text-sm font-medium mb-1', 'style': 'color: var(--color-text-secondary);'}}) }}
          {{ form_widget(form.email, {'attr': {'class': 'w-full rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', 'style': 'border-color: var(--color-border); background: var(--color-surface-elevated); color: var(--color-text-primary);'}}) }}
          {{ form_errors(form.email) }}
        </div>

        <div class="mb-4">
          {{ form_label(form.plainPassword, null, {'label_attr': {'class': 'block text-sm font-medium mb-1', 'style': 'color: var(--color-text-secondary);'}}) }}
          {{ form_widget(form.plainPassword, {'attr': {'class': 'w-full rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', 'style': 'border-color: var(--color-border); background: var(--color-surface-elevated); color: var(--color-text-primary);'}}) }}
          {% if driver.id %}
            <p class="mt-1 text-xs" style="color: var(--color-text-secondary);">Dejar vacio para mantener la contrasena actual.</p>
          {% endif %}
          {{ form_errors(form.plainPassword) }}
        </div>

        <div class="flex items-center mb-4">
          {{ form_widget(form.isActive, {'attr': {'class': 'h-4 w-4 rounded text-blue-600 focus:ring-blue-500', 'style': 'border-color: var(--color-border);'}}) }}
          {{ form_label(form.isActive, null, {'label_attr': {'class': 'ml-2 block text-sm', 'style': 'color: var(--color-text-secondary);'}}) }}
        </div>

        <div class="flex items-center justify-between pt-4 border-t" style="border-color: var(--color-border);">
          <a href="{{ path('admin_drivers_index') }}"
             class="text-sm font-medium" style="color: var(--color-text-secondary);">
            Cancelar
          </a>
          <button type="submit"
                  class="inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
            {{ driver.id ? 'Guardar cambios' : 'Crear conductor' }}
          </button>
        </div>

      {{ form_end(form) }}
    </div>

</div>
{% endblock %}
