{% extends 'base.html.twig' %}

{% block title %}Facturacion{% endblock %}

{% block content %}
<div class="mb-6 flex items-start justify-between">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Facturacion</h1>
    <p class="mt-1 text-sm text-gray-500">Resumen de entregas por cliente y periodo.</p>
  </div>
  <a href="{{ path('admin_billing_export', {from: from|date('Y-m-d'), to: to|date('Y-m-d')}) }}"
     class="inline-flex items-center gap-2 rounded-lg bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm border border-gray-300 hover:bg-gray-50">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/>
    </svg>
    Exportar CSV
  </a>
</div>

{# ── Date Filter ──────────────────────────────────────────────────── #}
<form method="get" class="mb-6 flex flex-wrap items-end gap-4 bg-white rounded-xl shadow-sm border border-gray-200 p-4">
  <div>
    <label class="block text-xs font-medium text-gray-500 mb-1">Desde</label>
    <input type="date" name="from" value="{{ from|date('Y-m-d') }}" class="rounded-lg border-gray-300 text-sm px-3 py-2 border">
  </div>
  <div>
    <label class="block text-xs font-medium text-gray-500 mb-1">Hasta</label>
    <input type="date" name="to" value="{{ to|date('Y-m-d') }}" class="rounded-lg border-gray-300 text-sm px-3 py-2 border">
  </div>
  <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-500">Filtrar</button>
</form>

{# ── Table ────────────────────────────────────────────────────────── #}
<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Cliente</th>
        <th class="px-4 py-3 text-right text-xs font-semibold text-gray-600 uppercase">Envios</th>
        <th class="px-4 py-3 text-right text-xs font-semibold text-gray-600 uppercase">Entregados</th>
        <th class="px-4 py-3 text-right text-xs font-semibold text-gray-600 uppercase">Excepciones</th>
        <th class="px-4 py-3 text-right text-xs font-semibold text-gray-600 uppercase">Facturables</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      {% for row in rows %}
      <tr class="hover:bg-gray-50">
        <td class="px-4 py-3 text-sm font-medium text-gray-900">{{ row.customer.name }}</td>
        <td class="px-4 py-3 text-sm text-right text-gray-700">{{ row.total_shipments }}</td>
        <td class="px-4 py-3 text-sm text-right text-green-700 font-medium">{{ row.total_delivered }}</td>
        <td class="px-4 py-3 text-sm text-right text-red-700">{{ row.total_exceptions }}</td>
        <td class="px-4 py-3 text-sm text-right font-bold text-gray-900">{{ row.billable_deliveries }}</td>
      </tr>
      {% else %}
      <tr>
        <td colspan="5" class="px-4 py-8 text-center text-sm text-gray-500">No hay datos para este periodo.</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
