{% extends 'base.html.twig' %}

{% block title %}Asistente IA - MXO Track{% endblock %}

{% block content %}
<div x-data="aiAssistant()">

{# ── Page header ──────────────────────────────────────────────────── #}
<div class="mb-6">
  <h1 class="text-2xl font-bold tracking-tight" style="color: var(--color-text-primary);">Asistente IA</h1>
  <p class="mt-1 text-sm" style="color: var(--color-text-secondary);">
    Pregunta sobre envios, rutas, alertas y reportes en lenguaje natural.
  </p>
</div>

{# ── Chat container ──────────────────────────────────────────────── #}
<div class="rounded-xl shadow-sm ring-1 ring-gray-900/5 flex flex-col" style="background: var(--color-surface-elevated); height: calc(100vh - 220px); min-height: 400px;">

  {# ── Messages area ─────────────────────────────────────────────── #}
  <div class="flex-1 overflow-y-auto p-6 space-y-4" id="chat-messages" x-ref="messagesContainer">

    {# Welcome message #}
    <template x-if="messages.length === 0">
      <div class="flex flex-col items-center justify-center h-full text-center">
        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-brand-50 mb-4">
          <svg class="h-8 w-8 text-brand-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z"/>
          </svg>
        </div>
        <h3 class="text-lg font-semibold mb-2" style="color: var(--color-text-primary);">Hola, soy tu asistente de logistica</h3>
        <p class="text-sm max-w-md mb-6" style="color: var(--color-text-secondary);">
          Puedo ayudarte a consultar envios, ver reportes de entregas, detectar alertas y analizar excepciones.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 max-w-lg">
          <button @click="sendSuggestion('Cuantas entregas hubo esta semana?')"
                  class="text-left rounded-lg border px-4 py-3 text-sm transition-colors" style="border-color: var(--color-border); color: var(--color-text-secondary);">
            Cuantas entregas hubo esta semana?
          </button>
          <button @click="sendSuggestion('Hay vehiculos offline?')"
                  class="text-left rounded-lg border px-4 py-3 text-sm transition-colors" style="border-color: var(--color-border); color: var(--color-text-secondary);">
            Hay vehiculos offline?
          </button>
          <button @click="sendSuggestion('Cuales son las excepciones mas comunes?')"
                  class="text-left rounded-lg border px-4 py-3 text-sm transition-colors" style="border-color: var(--color-border); color: var(--color-text-secondary);">
            Cuales son las excepciones mas comunes?
          </button>
          <button @click="sendSuggestion('Dame el reporte de entregas del ultimo mes')"
                  class="text-left rounded-lg border px-4 py-3 text-sm transition-colors" style="border-color: var(--color-border); color: var(--color-text-secondary);">
            Reporte de entregas del ultimo mes
          </button>
        </div>
      </div>
    </template>

    {# Message list #}
    <template x-for="(msg, idx) in messages" :key="idx">
      <div :class="msg.role === 'user' ? 'flex justify-end' : 'flex justify-start'">
        <div :class="msg.role === 'user'
              ? 'max-w-[75%] rounded-2xl rounded-br-md bg-brand-600 px-4 py-3 text-white'
              : 'max-w-[85%] rounded-2xl rounded-bl-md px-4 py-3'"
              :style="msg.role !== 'user' ? 'background: var(--color-surface); color: var(--color-text-primary);' : ''"

          {# Message text #}
          <div class="text-sm whitespace-pre-wrap leading-relaxed" x-html="formatMessage(msg.content)"></div>

          {# Tool badges #}
          <template x-if="msg.tools_used && msg.tools_used.length > 0">
            <div class="mt-2 flex flex-wrap gap-1.5">
              <template x-for="tool in msg.tools_used" :key="tool">
                <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-medium"
                      :class="msg.role === 'user' ? 'bg-white/20 text-white' : ''"
                      :style="msg.role !== 'user' ? 'background: var(--color-surface-elevated); color: var(--color-text-secondary);' : ''"
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.384-3.19m0 0l-.002-.003m.002.003L6 12m5.42 3.17l5.384-3.19m0 0l.002-.003m-.002.003L17 12m-5.58 3.17V21M7.504 4.883L12 2.25l4.496 2.633m-8.992 0L12 7.516m-4.496-2.633L3 7.516m4.504-2.633L12 7.516m0 0l4.496-2.633M12 7.516L12 2.25m0 5.266L17 4.883m0 0L21 7.516"/>
                  </svg>
                  <span x-text="formatToolName(tool)"></span>
                </span>
              </template>
            </div>
          </template>
        </div>
      </div>
    </template>

    {# Loading indicator #}
    <template x-if="loading">
      <div class="flex justify-start">
        <div class="rounded-2xl rounded-bl-md px-4 py-3" style="background: var(--color-surface);">
          <div class="flex items-center gap-2">
            <div class="flex space-x-1">
              <div class="h-2 w-2 rounded-full animate-bounce" style="background: var(--color-text-muted); animation-delay: 0ms;"></div>
              <div class="h-2 w-2 rounded-full animate-bounce" style="background: var(--color-text-muted); animation-delay: 150ms;"></div>
              <div class="h-2 w-2 rounded-full animate-bounce" style="background: var(--color-text-muted); animation-delay: 300ms;"></div>
            </div>
            <span class="text-xs" style="color: var(--color-text-secondary);">Procesando...</span>
          </div>
        </div>
      </div>
    </template>
  </div>

  {# ── Input area ────────────────────────────────────────────────── #}
  <div class="border-t p-4" style="border-color: var(--color-border);">
    <form @submit.prevent="sendMessage()" class="flex items-end gap-3">
      <div class="flex-1">
        <textarea x-ref="messageInput"
                  x-model="inputMessage"
                  @keydown.enter.prevent="if (!$event.shiftKey) sendMessage()"
                  placeholder="Escribe tu pregunta..."
                  rows="1"
                  class="block w-full resize-none rounded-xl border px-4 py-3 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
                  style="border-color: var(--color-border); background: var(--color-surface-elevated); color: var(--color-text-primary);"
                  :disabled="loading"
                  style="max-height: 120px; overflow-y: auto;"
                  @input="$el.style.height = 'auto'; $el.style.height = Math.min($el.scrollHeight, 120) + 'px'"></textarea>
      </div>
      <button type="submit"
              :disabled="loading || !inputMessage.trim()"
              class="inline-flex items-center justify-center rounded-xl bg-brand-600 px-4 py-3 text-sm font-medium text-white shadow-sm transition-all hover:bg-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"/>
        </svg>
      </button>
    </form>
  </div>
</div>

</div>

<script>
function aiAssistant() {
  return {
    messages: [],
    inputMessage: '',
    loading: false,

    sendSuggestion(text) {
      this.inputMessage = text;
      this.sendMessage();
    },

    async sendMessage() {
      const text = this.inputMessage.trim();
      if (!text || this.loading) return;

      this.messages.push({ role: 'user', content: text, tools_used: [] });
      this.inputMessage = '';
      this.loading = true;

      // Reset textarea height
      if (this.$refs.messageInput) {
        this.$refs.messageInput.style.height = 'auto';
      }

      this.$nextTick(() => this.scrollToBottom());

      try {
        const resp = await fetch('{{ path("admin_ai_assistant_message") }}', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ message: text }),
        });

        const data = await resp.json();

        if (resp.ok) {
          this.messages.push({
            role: 'assistant',
            content: data.response || 'Sin respuesta.',
            tools_used: data.tools_used || [],
          });
        } else {
          this.messages.push({
            role: 'assistant',
            content: data.error || 'Error al procesar la solicitud.',
            tools_used: [],
          });
        }
      } catch (err) {
        this.messages.push({
          role: 'assistant',
          content: 'Error de conexion. Verifica tu red e intentalo de nuevo.',
          tools_used: [],
        });
      }

      this.loading = false;
      this.$nextTick(() => {
        this.scrollToBottom();
        if (this.$refs.messageInput) this.$refs.messageInput.focus();
      });
    },

    scrollToBottom() {
      const container = this.$refs.messagesContainer;
      if (container) {
        container.scrollTop = container.scrollHeight;
      }
    },

    formatMessage(text) {
      if (!text) return '';
      // Basic markdown-like formatting
      let html = text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.+?)\*/g, '<em>$1</em>')
        .replace(/`(.+?)`/g, '<code class="rounded px-1 py-0.5 text-xs font-mono" style="background: var(--color-surface);">$1</code>');
      return html;
    },

    formatToolName(name) {
      const names = {
        'search_shipments': 'Busqueda',
        'get_delivery_report': 'Reporte',
        'get_route_details': 'Ruta',
        'get_active_alerts': 'Alertas',
        'get_exception_patterns': 'Excepciones',
      };
      return names[name] || name;
    },
  };
}
</script>
{% endblock %}
