{% extends 'base.html.twig' %}

{% block title %}Mapa de Excepciones - MXO Track{% endblock %}
{% block body_attrs %}data-turbo="false"{% endblock %}

{% block body %}
{# ── Leaflet CSS ─────────────────────────────────────────────────── #}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">

<style>
  html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; }
  #exception-map { width: 100%; height: 100vh; z-index: 1; }

  .leaflet-top.leaflet-right { top: 60px; }
  .leaflet-control-zoom a {
    background: rgba(15,23,42,0.85) !important;
    color: #e2e8f0 !important;
    border-color: rgba(51,65,85,0.6) !important;
    width: 36px !important; height: 36px !important;
    line-height: 36px !important; font-size: 18px !important;
  }
  .leaflet-control-zoom a:hover {
    background: rgba(30,58,138,0.9) !important;
    color: #fff !important;
  }

  .panel-scroll::-webkit-scrollbar { width: 4px; }
  .panel-scroll::-webkit-scrollbar-track { background: transparent; }
  .panel-scroll::-webkit-scrollbar-thumb { background: rgba(148,163,184,0.3); border-radius: 2px; }
</style>

<div x-data="exceptionMap()" x-init="init()" class="relative w-full h-screen overflow-hidden">

  {# ── Top header bar ──────────────────────────────────────────────── #}
  <div class="absolute top-0 left-80 right-0 z-[1000] h-14 flex items-center justify-between px-6"
       style="background: linear-gradient(to bottom, rgba(15,23,42,0.85) 0%, rgba(15,23,42,0.4) 70%, transparent 100%);">
    <h2 class="text-white font-semibold text-sm">Mapa de Excepciones</h2>
    <div class="flex items-center gap-3">
      <span class="text-slate-400 text-xs" x-text="totalPoints + ' puntos'"></span>
      <span class="text-slate-500 text-xs">|</span>
      <span class="text-slate-400 text-xs" x-text="totalExceptions + ' excepciones'"></span>
    </div>
  </div>

  {# ── Left side panel ──────────────────────────────────────────────── #}
  <div class="absolute top-0 left-0 bottom-0 z-[999] w-80 flex flex-col bg-slate-900/95 backdrop-blur-xl border-r border-slate-700/50">

    {# Back to dashboard #}
    <a href="{{ path('admin_dashboard') }}"
       class="flex-shrink-0 flex items-center gap-2 px-5 pt-4 pb-2 text-slate-400 hover:text-white transition-colors text-sm font-medium">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
      </svg>
      Volver al Dashboard
    </a>

    {# Brand header #}
    <div class="flex-shrink-0 px-5 pt-2 pb-3">
      <div class="flex items-center gap-2.5 mb-4">
        <div class="w-8 h-8 rounded-lg bg-red-600 flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
          </svg>
        </div>
        <div>
          <h1 class="text-white font-bold text-base tracking-tight">Excepciones</h1>
          <p class="text-slate-500 text-[10px] uppercase tracking-widest">Heatmap</p>
        </div>
      </div>
    </div>

    {# ── Filters ─────────────────────────────────────────────────────── #}
    <div class="flex-1 overflow-y-auto panel-scroll px-5 pb-4">

      {# Exception type #}
      <div class="mb-4">
        <label class="block text-xs font-medium text-slate-400 mb-1.5">Tipo de excepcion</label>
        <select x-model="filters.exceptionCode" @change="applyFilters()"
                class="w-full bg-slate-800/80 border border-slate-700/50 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-red-500/50 focus:ring-1 focus:ring-red-500/30">
          <option value="">Todos</option>
          {% for code in exception_codes %}
            <option value="{{ code.value }}">{{ code.label }}</option>
          {% endfor %}
        </select>
      </div>

      {# Date range #}
      <div class="mb-4">
        <label class="block text-xs font-medium text-slate-400 mb-1.5">Desde</label>
        <input type="date" x-model="filters.from" @change="applyFilters()"
               class="w-full bg-slate-800/80 border border-slate-700/50 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-red-500/50 focus:ring-1 focus:ring-red-500/30">
      </div>

      <div class="mb-4">
        <label class="block text-xs font-medium text-slate-400 mb-1.5">Hasta</label>
        <input type="date" x-model="filters.to" @change="applyFilters()"
               class="w-full bg-slate-800/80 border border-slate-700/50 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-red-500/50 focus:ring-1 focus:ring-red-500/30">
      </div>

      {# Customer #}
      <div class="mb-4">
        <label class="block text-xs font-medium text-slate-400 mb-1.5">Cliente</label>
        <select x-model="filters.customerId" @change="applyFilters()"
                class="w-full bg-slate-800/80 border border-slate-700/50 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-red-500/50 focus:ring-1 focus:ring-red-500/30">
          <option value="">Todos</option>
          {% for customer in customers %}
            <option value="{{ customer.id }}">{{ customer.name }}</option>
          {% endfor %}
        </select>
      </div>

      {# Reset button #}
      <button @click="resetFilters()"
              class="w-full bg-slate-800/60 hover:bg-slate-700/60 text-slate-400 hover:text-white text-xs font-medium py-2 px-3 rounded-lg transition-colors border border-slate-700/30">
        Limpiar filtros
      </button>

      {# Legend #}
      <div class="mt-6 pt-4 border-t border-slate-700/50">
        <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-500 mb-3">Intensidad</p>
        <div class="flex items-center gap-2">
          <div class="flex-1 h-3 rounded-full" style="background: linear-gradient(to right, #3b82f6, #22c55e, #eab308, #ef4444);"></div>
        </div>
        <div class="flex justify-between mt-1">
          <span class="text-[10px] text-slate-500">Baja</span>
          <span class="text-[10px] text-slate-500">Alta</span>
        </div>
      </div>
    </div>
  </div>

  {# ── Map container ──────────────────────────────────────────────── #}
  <div id="exception-map" class="absolute inset-0"></div>
</div>

{# ── Leaflet JS ──────────────────────────────────────────────────── #}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="https://unpkg.com/leaflet.heat/dist/leaflet-heat.js"></script>

<script>
function exceptionMap() {
  return {
    map: null,
    heatLayer: null,
    points: [],
    totalPoints: 0,
    totalExceptions: 0,

    filters: {
      exceptionCode: '',
      from: '',
      to: '',
      customerId: '',
    },

    init() {
      this.initMap();
      this.loadData();
    },

    initMap() {
      this.map = L.map('exception-map', {
        zoomControl: false,
        attributionControl: false,
      }).setView([40.4168, -3.7038], 6);

      L.control.zoom({ position: 'topright' }).addTo(this.map);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap contributors'
      }).addTo(this.map);
    },

    buildQueryString() {
      const params = new URLSearchParams();
      if (this.filters.exceptionCode) params.set('exception_code', this.filters.exceptionCode);
      if (this.filters.from) params.set('from', this.filters.from);
      if (this.filters.to) params.set('to', this.filters.to);
      if (this.filters.customerId) params.set('customer_id', this.filters.customerId);
      return params.toString();
    },

    async loadData() {
      try {
        const qs = this.buildQueryString();
        const url = '{{ path("admin_reports_exception_map_data") }}' + (qs ? '?' + qs : '');
        const res = await fetch(url, { credentials: 'include' });
        if (!res.ok) return;
        this.points = await res.json();
        this.totalPoints = this.points.length;
        this.totalExceptions = this.points.reduce((sum, p) => sum + p.weight, 0);
        this.renderHeatmap();
        this.fitBounds();
      } catch (_) { /* silent */ }
    },

    renderHeatmap() {
      if (this.heatLayer) {
        this.map.removeLayer(this.heatLayer);
      }

      if (this.points.length === 0) return;

      const heatData = this.points.map(p => [p.lat, p.lng, p.weight]);
      this.heatLayer = L.heatLayer(heatData, {
        radius: 25,
        blur: 15,
        maxZoom: 17,
        max: Math.max(...this.points.map(p => p.weight), 1),
        gradient: {
          0.2: '#3b82f6',
          0.4: '#22c55e',
          0.6: '#eab308',
          0.8: '#f97316',
          1.0: '#ef4444',
        },
      }).addTo(this.map);
    },

    fitBounds() {
      if (this.points.length === 0) return;
      const bounds = L.latLngBounds(this.points.map(p => [p.lat, p.lng]));
      this.map.flyToBounds(bounds, { padding: [80, 80], duration: 1, maxZoom: 14 });
    },

    applyFilters() {
      this.loadData();
    },

    resetFilters() {
      this.filters.exceptionCode = '';
      this.filters.from = '';
      this.filters.to = '';
      this.filters.customerId = '';
      this.applyFilters();
    },
  };
}
</script>
{% endblock %}
