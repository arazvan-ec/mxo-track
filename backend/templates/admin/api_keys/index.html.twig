{% extends 'base.html.twig' %}

{% block title %}API Keys - Admin{% endblock %}

{% block content %}
    <div class="sm:flex sm:items-center sm:justify-between mb-6">
      <h1 class="text-2xl font-bold" style="color: var(--color-text-primary);">API Keys</h1>
    </div>

    {# ── Create new API key form ─────────────────────────────────────── #}
    <div class="mb-8 overflow-hidden ring-1 sm:rounded-lg p-6" style="background: var(--color-surface-elevated); --tw-ring-color: var(--color-border);">
      <h2 class="text-lg font-semibold mb-4" style="color: var(--color-text-primary);">Crear nueva API Key</h2>
      <form method="post" action="{{ path('admin_api_keys_create') }}" class="flex flex-wrap items-end gap-4">
        <input type="hidden" name="_token" value="{{ csrf_token('create-api-key') }}">

        <div class="flex-1 min-w-[200px]">
          <label for="customer_id" class="block text-sm font-medium mb-1" style="color: var(--color-text-secondary);">Cliente</label>
          <select name="customer_id" id="customer_id" required
                  class="block w-full rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" style="border-color: var(--color-border);">
            <option value="">Seleccionar...</option>
            {% for customer in customers %}
              <option value="{{ customer.publicIdString }}">{{ customer.name }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="flex-1 min-w-[200px]">
          <label for="name" class="block text-sm font-medium mb-1" style="color: var(--color-text-secondary);">Nombre</label>
          <input type="text" name="name" id="name" required placeholder="Ej: Produccion, Testing..."
                 class="block w-full rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" style="border-color: var(--color-border);">
        </div>

        <div class="w-32">
          <label for="rate_limit" class="block text-sm font-medium mb-1" style="color: var(--color-text-secondary);">Limite/min</label>
          <input type="number" name="rate_limit" id="rate_limit" value="60" min="1" max="1000"
                 class="block w-full rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" style="border-color: var(--color-border);">
        </div>

        <button type="submit"
                class="inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
          Crear API Key
        </button>
      </form>
    </div>

    {# ── API keys table ──────────────────────────────────────────────── #}
    <div class="overflow-x-auto ring-1 sm:rounded-lg" style="background: var(--color-surface-elevated); --tw-ring-color: var(--color-border);">
      <table class="min-w-full divide-y" style="border-color: var(--color-border);">
        <thead style="background: var(--color-surface);">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Nombre</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Cliente</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Limite/min</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Ultimo uso</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Estado</th>
            <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y" style="border-color: var(--color-border); background: var(--color-surface-elevated);">
          {% for apiKey in apiKeys %}
            <tr>
              <td class="whitespace-nowrap px-6 py-4 text-sm font-medium" style="color: var(--color-text-primary);">
                {{ apiKey.name }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm" style="color: var(--color-text-secondary);">
                {{ apiKey.customer.name }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm" style="color: var(--color-text-secondary);">
                {{ apiKey.rateLimitPerMinute }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm" style="color: var(--color-text-secondary);">
                {{ apiKey.lastUsedAt ? apiKey.lastUsedAt|date('Y-m-d H:i') : 'Nunca' }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm">
                {% if apiKey.active %}
                  <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Activa</span>
                {% else %}
                  <span class="inline-flex rounded-full bg-red-100 px-2 text-xs font-semibold leading-5 text-red-800">Inactiva</span>
                {% endif %}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium space-x-2">
                <form method="post" action="{{ path('admin_api_keys_toggle', {publicId: apiKey.publicIdString}) }}" class="inline">
                  <input type="hidden" name="_token" value="{{ csrf_token('toggle-api-key-' ~ apiKey.publicIdString) }}">
                  <button type="submit" class="text-blue-600 hover:text-blue-800">
                    {{ apiKey.active ? 'Desactivar' : 'Activar' }}
                  </button>
                </form>
                <form method="post" action="{{ path('admin_api_keys_delete', {publicId: apiKey.publicIdString}) }}"
                      class="inline"
                      onsubmit="return confirm('Eliminar esta API key?');">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete-api-key-' ~ apiKey.publicIdString) }}">
                  <button type="submit" class="text-red-600 hover:text-red-800">Eliminar</button>
                </form>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="6" class="px-6 py-4 text-center text-sm" style="color: var(--color-text-secondary);">
                No hay API keys creadas.
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    {% if totalPages > 1 %}
      <nav class="mt-6 flex items-center justify-between">
        <div class="flex flex-1 justify-between sm:justify-end space-x-2">
          {% if page > 1 %}
            <a href="{{ path('admin_api_keys_index', {page: page - 1}) }}"
               class="rounded-md theme-card px-4 py-2 text-sm font-medium" style="color: var(--color-text-secondary);">
              Anterior
            </a>
          {% endif %}
          <span class="inline-flex items-center px-4 py-2 text-sm" style="color: var(--color-text-secondary);">
            Pagina {{ page }} de {{ totalPages }}
          </span>
          {% if page < totalPages %}
            <a href="{{ path('admin_api_keys_index', {page: page + 1}) }}"
               class="rounded-md theme-card px-4 py-2 text-sm font-medium" style="color: var(--color-text-secondary);">
              Siguiente
            </a>
          {% endif %}
        </div>
      </nav>
    {% endif %}
{% endblock %}
