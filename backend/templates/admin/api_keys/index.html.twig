{% extends 'base.html.twig' %}

{% block title %}API Keys - Admin{% endblock %}

{% block content %}
    <div class="sm:flex sm:items-center sm:justify-between mb-6">
      <h1 class="text-2xl font-bold text-gray-900">API Keys</h1>
    </div>

    {# ── Create new API key form ─────────────────────────────────────── #}
    <div class="mb-8 overflow-hidden bg-white shadow ring-1 ring-gray-200 sm:rounded-lg p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Crear nueva API Key</h2>
      <form method="post" action="{{ path('admin_api_keys_create') }}" class="flex flex-wrap items-end gap-4">
        <input type="hidden" name="_token" value="{{ csrf_token('create-api-key') }}">

        <div class="flex-1 min-w-[200px]">
          <label for="customer_id" class="block text-sm font-medium text-gray-700 mb-1">Cliente</label>
          <select name="customer_id" id="customer_id" required
                  class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm">
            <option value="">Seleccionar...</option>
            {% for customer in customers %}
              <option value="{{ customer.publicIdString }}">{{ customer.name }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="flex-1 min-w-[200px]">
          <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Nombre</label>
          <input type="text" name="name" id="name" required placeholder="Ej: Produccion, Testing..."
                 class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm">
        </div>

        <div class="w-32">
          <label for="rate_limit" class="block text-sm font-medium text-gray-700 mb-1">Limite/min</label>
          <input type="number" name="rate_limit" id="rate_limit" value="60" min="1" max="1000"
                 class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm">
        </div>

        <button type="submit"
                class="inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
          Crear API Key
        </button>
      </form>
    </div>

    {# ── API keys table ──────────────────────────────────────────────── #}
    <div class="overflow-hidden bg-white shadow ring-1 ring-gray-200 sm:rounded-lg">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Nombre</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Cliente</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Limite/min</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Ultimo uso</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Estado</th>
            <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          {% for apiKey in apiKeys %}
            <tr>
              <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900">
                {{ apiKey.name }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                {{ apiKey.customer.name }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                {{ apiKey.rateLimitPerMinute }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                {{ apiKey.lastUsedAt ? apiKey.lastUsedAt|date('Y-m-d H:i') : 'Nunca' }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm">
                {% if apiKey.active %}
                  <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Activa</span>
                {% else %}
                  <span class="inline-flex rounded-full bg-red-100 px-2 text-xs font-semibold leading-5 text-red-800">Inactiva</span>
                {% endif %}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium space-x-2">
                <form method="post" action="{{ path('admin_api_keys_toggle', {publicId: apiKey.publicIdString}) }}" class="inline">
                  <input type="hidden" name="_token" value="{{ csrf_token('toggle-api-key-' ~ apiKey.publicIdString) }}">
                  <button type="submit" class="text-blue-600 hover:text-blue-800">
                    {{ apiKey.active ? 'Desactivar' : 'Activar' }}
                  </button>
                </form>
                <form method="post" action="{{ path('admin_api_keys_delete', {publicId: apiKey.publicIdString}) }}"
                      class="inline"
                      onsubmit="return confirm('Eliminar esta API key?');">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete-api-key-' ~ apiKey.publicIdString) }}">
                  <button type="submit" class="text-red-600 hover:text-red-800">Eliminar</button>
                </form>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="6" class="px-6 py-4 text-center text-sm text-gray-500">
                No hay API keys creadas.
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    {% if totalPages > 1 %}
      <nav class="mt-6 flex items-center justify-between">
        <div class="flex flex-1 justify-between sm:justify-end space-x-2">
          {% if page > 1 %}
            <a href="{{ path('admin_api_keys_index', {page: page - 1}) }}"
               class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
              Anterior
            </a>
          {% endif %}
          <span class="inline-flex items-center px-4 py-2 text-sm text-gray-700">
            Pagina {{ page }} de {{ totalPages }}
          </span>
          {% if page < totalPages %}
            <a href="{{ path('admin_api_keys_index', {page: page + 1}) }}"
               class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
              Siguiente
            </a>
          {% endif %}
        </div>
      </nav>
    {% endif %}
{% endblock %}
