{% extends 'base.html.twig' %}

{% block title %}Importar envios CSV - MXO Track{% endblock %}

{% block breadcrumbs %}
  <li>
    <div class="flex items-center">
      <svg class="h-5 w-5 shrink-0" style="color: var(--color-text-muted);" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
      </svg>
      <span class="ml-2 text-sm font-medium" style="color: var(--color-text-secondary);">Envios</span>
    </div>
  </li>
  <li>
    <div class="flex items-center">
      <svg class="h-5 w-5 shrink-0" style="color: var(--color-text-muted);" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
      </svg>
      <span class="ml-2 text-sm font-medium" style="color: var(--color-text-primary);">Importar CSV</span>
    </div>
  </li>
{% endblock %}

{% block content %}
<div class="space-y-8">

  {# ── Page header ────────────────────────────────────────────────────── #}
  <div>
    <h1 class="text-2xl font-bold tracking-tight" style="color: var(--color-text-primary);">Importar envios desde CSV</h1>
    <p class="mt-1 text-sm" style="color: var(--color-text-secondary);">
      Carga un archivo CSV con los datos de envio para crear registros de forma masiva.
    </p>
  </div>

  {# ── Create Routes CTA (shown after successful import) ────────────── #}
  {% for importRunId in app.flashes('import_run_id') %}
    <div class="rounded-xl bg-emerald-50 border border-emerald-200 p-6">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="flex-shrink-0">
            <svg class="h-8 w-8 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/>
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-emerald-900">Envios importados correctamente</h3>
            <p class="mt-0.5 text-sm text-emerald-700">Puedes crear rutas optimizadas con los envios que acabas de importar.</p>
          </div>
        </div>
        <a href="/app/admin/route-planner?import_id={{ importRunId }}"
           class="inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-700 transition-colors">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
          </svg>
          Crear Rutas
        </a>
      </div>
    </div>
  {% endfor %}

  {# ── Import form card ──────────────────────────────────────────────── #}
  <div class="shadow-sm ring-1 ring-gray-900/5 rounded-xl" style="background: var(--color-surface-elevated);">
    <form method="post" enctype="multipart/form-data" action="{{ path('admin_shipments_import') }}">
      <input type="hidden" name="_token" value="{{ csrf_token('import-shipments') }}">

      <div class="px-6 py-6 space-y-6">

        {# Customer selector #}
        <div>
          <label for="customer_id" class="block text-sm font-medium" style="color: var(--color-text-secondary);">Cliente</label>
          <select id="customer_id" name="customer_id" required
                  class="mt-1 block w-full rounded-lg py-2.5 pl-3 pr-10 text-sm shadow-sm
                         focus:border-brand-500 focus:ring-brand-500 border" style="border-color: var(--color-border); background: var(--color-surface-elevated);">
            <option value="">Selecciona un cliente</option>
            {% for customer in customers %}
              <option value="{{ customer.publicIdString }}">{{ customer.name }}</option>
            {% endfor %}
          </select>
        </div>

        {# Drag & drop file zone #}
        <div>
          <label class="block text-sm font-medium mb-1" style="color: var(--color-text-secondary);">Archivo CSV</label>
          <div x-data="{ fileName: '', dragging: false }"
               @dragover.prevent="dragging = true"
               @dragleave="dragging = false"
               @drop.prevent="dragging = false; fileName = $event.dataTransfer.files[0]?.name; $refs.fileInput.files = $event.dataTransfer.files"
               :class="{ 'border-brand-500 bg-brand-50': dragging }"
               class="border-2 border-dashed rounded-lg p-8 text-center cursor-pointer transition-colors" style="border-color: var(--color-border);">
            <input type="file"
                   name="csv_file"
                   x-ref="fileInput"
                   @change="fileName = $event.target.files[0]?.name"
                   class="hidden"
                   accept=".csv,text/csv"
                   required>
            <div @click="$refs.fileInput.click()">
              <svg class="mx-auto h-12 w-12" style="color: var(--color-text-muted);" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/>
              </svg>
              <p class="mt-3 text-sm" style="color: var(--color-text-secondary);"
                 x-text="fileName || 'Arrastra un archivo CSV o haz clic para seleccionar'">
                Arrastra un archivo CSV o haz clic para seleccionar
              </p>
              <p class="mt-1 text-xs" style="color: var(--color-text-muted);" x-show="!fileName">Formato: .csv (separado por comas)</p>
              <p class="mt-1 text-xs text-brand-600 font-medium" x-show="fileName" x-cloak>
                Archivo seleccionado
              </p>
            </div>
          </div>
        </div>

        {# CSV format help (collapsible) #}
        <div x-data="{ open: false }">
          <button type="button" @click="open = !open"
                  class="flex items-center gap-2 text-sm text-brand-600 hover:text-brand-700 font-medium transition-colors">
            <svg class="h-4 w-4 transition-transform" :class="{ 'rotate-90': open }" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
            </svg>
            Formato esperado del CSV
          </button>

          <div x-show="open" x-collapse x-cloak class="mt-3">
            <div class="rounded-lg p-4 ring-1" style="background: var(--color-surface); border-color: var(--color-border);">
              <p class="text-sm mb-3" style="color: var(--color-text-secondary);">
                El archivo debe incluir una fila de cabecera. Solo <strong>reference</strong> es obligatoria; las demas columnas son opcionales.
              </p>
              <div class="overflow-x-auto">
                <table class="min-w-full text-xs">
                  <thead>
                    <tr style="border-bottom: 1px solid var(--color-border);">
                      <th class="text-left py-1.5 pr-4 font-semibold" style="color: var(--color-text-secondary);">Columna</th>
                      <th class="text-left py-1.5 pr-4 font-semibold" style="color: var(--color-text-secondary);">Descripcion</th>
                      <th class="text-left py-1.5 font-semibold" style="color: var(--color-text-secondary);">Ejemplo</th>
                    </tr>
                  </thead>
                  <tbody style="color: var(--color-text-secondary);">
                    <tr class="border-b">
                      <td class="py-1.5 pr-4 font-mono font-medium" style="color: var(--color-text-primary);">reference</td>
                      <td class="py-1.5 pr-4">Referencia unica del envio (obligatoria)</td>
                      <td class="py-1.5 font-mono">REF-001</td>
                    </tr>
                    <tr class="border-b">
                      <td class="py-1.5 pr-4 font-mono">recipient_name</td>
                      <td class="py-1.5 pr-4">Nombre del destinatario</td>
                      <td class="py-1.5 font-mono">Juan Garcia</td>
                    </tr>
                    <tr class="border-b">
                      <td class="py-1.5 pr-4 font-mono">address</td>
                      <td class="py-1.5 pr-4">Direccion de entrega</td>
                      <td class="py-1.5 font-mono">Calle Gran Via 42 Madrid</td>
                    </tr>
                    <tr class="border-b">
                      <td class="py-1.5 pr-4 font-mono">latitude</td>
                      <td class="py-1.5 pr-4">Latitud (-90 a 90)</td>
                      <td class="py-1.5 font-mono">40.4200</td>
                    </tr>
                    <tr class="border-b">
                      <td class="py-1.5 pr-4 font-mono">longitude</td>
                      <td class="py-1.5 pr-4">Longitud (-180 a 180)</td>
                      <td class="py-1.5 font-mono">-3.7025</td>
                    </tr>
                    <tr class="border-b">
                      <td class="py-1.5 pr-4 font-mono">phone</td>
                      <td class="py-1.5 pr-4">Telefono del destinatario</td>
                      <td class="py-1.5 font-mono">+34612345678</td>
                    </tr>
                    <tr class="border-b">
                      <td class="py-1.5 pr-4 font-mono">notes</td>
                      <td class="py-1.5 pr-4">Notas de entrega</td>
                      <td class="py-1.5 font-mono">Entregar en porteria</td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <div class="mt-3 pt-3 border-t">
                <p class="text-xs font-medium mb-2" style="color: var(--color-text-secondary);">Columnas opcionales adicionales (para optimizacion de rutas):</p>
                <div class="overflow-x-auto">
                  <table class="min-w-full text-xs">
                    <tbody style="color: var(--color-text-secondary);">
                      <tr class="border-b">
                        <td class="py-1.5 pr-4 font-mono">service_type</td>
                        <td class="py-1.5 pr-4">Tipo de servicio</td>
                        <td class="py-1.5 font-mono">standard</td>
                      </tr>
                      <tr class="border-b">
                        <td class="py-1.5 pr-4 font-mono">weight_kg</td>
                        <td class="py-1.5 pr-4">Peso total en kilogramos</td>
                        <td class="py-1.5 font-mono">2.50</td>
                      </tr>
                      <tr class="border-b">
                        <td class="py-1.5 pr-4 font-mono">volume_m3</td>
                        <td class="py-1.5 pr-4">Volumen total en metros cubicos</td>
                        <td class="py-1.5 font-mono">0.0350</td>
                      </tr>
                      <tr class="border-b">
                        <td class="py-1.5 pr-4 font-mono">num_parcels</td>
                        <td class="py-1.5 pr-4">Numero de paquetes</td>
                        <td class="py-1.5 font-mono">2</td>
                      </tr>
                      <tr class="border-b">
                        <td class="py-1.5 pr-4 font-mono">ean</td>
                        <td class="py-1.5 pr-4">Codigo EAN del producto</td>
                        <td class="py-1.5 font-mono">8412345678901</td>
                      </tr>
                      <tr class="border-b">
                        <td class="py-1.5 pr-4 font-mono">description</td>
                        <td class="py-1.5 pr-4">Descripcion del paquete</td>
                        <td class="py-1.5 font-mono">Caja electronica</td>
                      </tr>
                      <tr class="border-b">
                        <td class="py-1.5 pr-4 font-mono">service_time_seconds</td>
                        <td class="py-1.5 pr-4">Tiempo de servicio en segundos (default: 300)</td>
                        <td class="py-1.5 font-mono">180</td>
                      </tr>
                      <tr>
                        <td class="py-1.5 pr-4 font-mono">priority</td>
                        <td class="py-1.5 pr-4">Prioridad (0-100, mayor = mas urgente)</td>
                        <td class="py-1.5 font-mono">50</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="mt-3 pt-3 border-t">
                <p class="text-xs mb-2" style="color: var(--color-text-secondary);">Ejemplo de contenido CSV:</p>
                <pre class="text-xs rounded p-2 ring-1 overflow-x-auto font-mono" style="background: var(--color-surface-elevated); border-color: var(--color-border); color: var(--color-text-secondary);">reference,recipient_name,address,latitude,longitude,phone,notes,weight_kg,volume_m3,num_parcels
REF-001,Juan Garcia,Calle Gran Via 42 Madrid,40.4200,-3.7025,+34612345678,Entregar en porteria,2.50,0.0350,1
REF-002,Maria Lopez,Av. de la Castellana 100,40.4515,-3.6903,+34698765432,,5.00,0.1200,3</pre>
              </div>
            </div>
          </div>
        </div>

      </div>

      {# Form actions #}
      <div class="flex items-center justify-between gap-4 px-6 py-4 rounded-b-xl" style="border-top: 1px solid var(--color-border); background: var(--color-surface);">
        <a href="data:text/csv;charset=utf-8,reference%2Crecipient_name%2Caddress%2Clatitude%2Clongitude%2Cphone%2Cnotes%2Cweight_kg%2Cvolume_m3%2Cnum_parcels%0AREF-001%2CJuan%20Garcia%2CCalle%20Gran%20Via%2042%20Madrid%2C40.4200%2C-3.7025%2C%2B34612345678%2CEntregar%20en%20porteria%2C2.50%2C0.0350%2C1%0A"
           download="plantilla_envios.csv"
           class="inline-flex items-center gap-1.5 text-sm hover:opacity-80 transition-colors" style="color: var(--color-text-secondary);">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/>
          </svg>
          Descargar plantilla CSV
        </a>
        <button type="submit"
                class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm
                       hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2
                       focus-visible:outline-brand-600 transition-colors">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/>
          </svg>
          Importar envios
        </button>
      </div>

    </form>
  </div>

  {# ── Recent imports table ──────────────────────────────────────────── #}
  <div class="shadow-sm ring-1 ring-gray-900/5 rounded-xl" style="background: var(--color-surface-elevated);">
    <div class="px-6 py-5" style="border-bottom: 1px solid var(--color-border);">
      <h2 class="text-lg font-semibold" style="color: var(--color-text-primary);">Ultimas importaciones</h2>
      <p class="mt-0.5 text-sm" style="color: var(--color-text-secondary);">Historial de las 10 importaciones mas recientes.</p>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y" style="border-color: var(--color-border);">
        <thead style="background: var(--color-surface);">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-secondary);">
              Fecha
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-secondary);">
              Cliente
            </th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-secondary);">
              Creados
            </th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-secondary);">
              Omitidos
            </th>
          </tr>
        </thead>
        <tbody class="divide-y" style="border-color: var(--color-border);">
          {% for run in runs %}
            <tr class="transition-colors">
              <td class="whitespace-nowrap px-6 py-4 text-sm" style="color: var(--color-text-secondary);">
                {{ run.createdAt|date('d/m/Y H:i') }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm font-medium" style="color: var(--color-text-primary);">
                {{ run.customer.name }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-right">
                <span class="inline-flex items-center rounded-full badge-soft-emerald px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset ring-emerald-600/20">
                  {{ run.createdCount }}
                </span>
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-right">
                {% if run.skippedCount > 0 %}
                  <span class="inline-flex items-center rounded-full badge-soft-amber px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset ring-amber-600/20">
                    {{ run.skippedCount }}
                  </span>
                {% else %}
                  <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset ring-gray-500/10" style="background: var(--color-surface); color: var(--color-text-secondary);">
                    0
                  </span>
                {% endif %}
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="4" class="px-6 py-12 text-center">
                <svg class="mx-auto h-10 w-10" style="color: var(--color-text-muted);" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round"
                        d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
                </svg>
                <p class="mt-2 text-sm" style="color: var(--color-text-secondary);">Sin importaciones registradas.</p>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

</div>
{% endblock %}
