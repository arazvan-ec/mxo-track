{% extends 'base.html.twig' %}

{% block title %}{{ vehicle.id ? 'Editar vehiculo' : 'Nuevo vehiculo' }} - Admin{% endblock %}

{% block content %}
<div class="mx-auto max-w-2xl">
    {# Header #}
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-900">
        {{ vehicle.id ? 'Editar vehiculo' : 'Nuevo vehiculo' }}
      </h1>
    </div>

    {# Form #}
    <div class="bg-white shadow rounded-lg p-6">
      {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

        <div class="mb-4">
          {{ form_label(form.name, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
          {{ form_widget(form.name, {'attr': {'class': 'w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm'}}) }}
          {{ form_errors(form.name) }}
        </div>

        {# Capacity section #}
        <div class="mb-6 rounded-lg border border-gray-200 p-4">
          <h3 class="mb-3 text-sm font-semibold text-gray-800">Capacidad del vehiculo</h3>
          <p class="mb-4 text-xs text-gray-500">Estos valores se usan para la optimizacion de rutas y validacion de carga.</p>
          <div class="grid grid-cols-3 gap-4">
            <div>
              {{ form_label(form.maxWeightKg, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
              {{ form_widget(form.maxWeightKg) }}
              {{ form_errors(form.maxWeightKg) }}
            </div>
            <div>
              {{ form_label(form.maxVolumeM3, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
              {{ form_widget(form.maxVolumeM3) }}
              {{ form_errors(form.maxVolumeM3) }}
            </div>
            <div>
              {{ form_label(form.maxParcels, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
              {{ form_widget(form.maxParcels) }}
              {{ form_errors(form.maxParcels) }}
            </div>
          </div>
        </div>

        {# Skills section #}
        <div class="mb-6 rounded-lg border border-gray-200 p-4">
          <h3 class="mb-3 text-sm font-semibold text-gray-800">Habilidades del vehiculo</h3>
          <p class="mb-3 text-xs text-gray-500">Selecciona las capacidades especiales de este vehiculo.</p>
          <div class="space-y-2">
            {% for child in form.skills %}
              <div class="flex items-center">
                {{ form_widget(child, {'attr': {'class': 'h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500'}}) }}
                {{ form_label(child, null, {'label_attr': {'class': 'ml-2 block text-sm text-gray-700'}}) }}
              </div>
            {% endfor %}
          </div>
          {{ form_errors(form.skills) }}
        </div>

        <div class="mb-4">
          {{ form_label(form.traccarDeviceId, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
          {{ form_widget(form.traccarDeviceId) }}
          {{ form_errors(form.traccarDeviceId) }}
        </div>

        <div class="flex items-center mb-4">
          {{ form_widget(form.isActive, {'attr': {'class': 'h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500'}}) }}
          {{ form_label(form.isActive, null, {'label_attr': {'class': 'ml-2 block text-sm text-gray-700'}}) }}
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-gray-200">
          <a href="{{ path('admin_vehicles_index') }}"
             class="text-sm font-medium text-gray-600 hover:text-gray-900">
            Cancelar
          </a>
          <button type="submit"
                  class="inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
            {{ vehicle.id ? 'Guardar cambios' : 'Crear vehiculo' }}
          </button>
        </div>

      {{ form_end(form) }}
    </div>

</div>
{% endblock %}
