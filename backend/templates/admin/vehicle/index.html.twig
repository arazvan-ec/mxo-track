{% extends 'base.html.twig' %}

{% block title %}Vehiculos - Admin{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-100 py-8">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    {# Flash messages #}
    {% for type, messages in app.flashes %}
      {% for message in messages %}
        <div class="mb-4 rounded-md p-4 {% if type == 'success' %}bg-green-50 text-green-800{% elseif type == 'error' %}bg-red-50 text-red-800{% else %}bg-blue-50 text-blue-800{% endif %}">
          {{ message }}
        </div>
      {% endfor %}
    {% endfor %}

    {# Header #}
    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-gray-900">Vehiculos</h1>
      <a href="{{ path('admin_vehicles_new') }}"
         class="inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
        Nuevo vehiculo
      </a>
    </div>

    {# Table #}
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Nombre</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Traccar ID</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Estado</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Ultima posicion</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Creado</th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          {% for vehicle in vehicles %}
            <tr>
              <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900">
                {{ vehicle.name }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                {{ vehicle.traccarDeviceId ?? '-' }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm">
                {% if vehicle.active %}
                  <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Activo</span>
                {% else %}
                  <span class="inline-flex rounded-full bg-red-100 px-2 text-xs font-semibold leading-5 text-red-800">Inactivo</span>
                {% endif %}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                {% set lastPos = lastPositions[vehicle.id] ?? null %}
                {% if lastPos %}
                  {{ lastPos.lat|number_format(5) }}, {{ lastPos.lng|number_format(5) }}
                {% else %}
                  <span class="text-gray-400">Sin senal</span>
                {% endif %}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                {{ vehicle.createdAt|date('d/m/Y H:i') }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                <a href="{{ path('admin_vehicles_edit', {publicId: vehicle.publicIdString}) }}"
                   class="text-blue-600 hover:text-blue-900 mr-3">Editar</a>
                {% if vehicle.active %}
                  <form method="post" action="{{ path('admin_vehicles_delete', {publicId: vehicle.publicIdString}) }}" class="inline"
                        onsubmit="return confirm('Desactivar este vehiculo?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-vehicle-' ~ vehicle.publicIdString) }}">
                    <button type="submit" class="text-red-600 hover:text-red-900">Desactivar</button>
                  </form>
                {% endif %}
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="6" class="px-6 py-8 text-center text-sm text-gray-500">
                No hay vehiculos registrados.
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    {# Pagination #}
    {% if totalPages > 1 %}
      <nav class="mt-6 flex items-center justify-between">
        <div class="text-sm text-gray-700">
          Pagina {{ page }} de {{ totalPages }}
        </div>
        <div class="flex space-x-2">
          {% if page > 1 %}
            <a href="{{ path('admin_vehicles_index', {page: page - 1}) }}"
               class="inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
              Anterior
            </a>
          {% endif %}
          {% if page < totalPages %}
            <a href="{{ path('admin_vehicles_index', {page: page + 1}) }}"
               class="inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
              Siguiente
            </a>
          {% endif %}
        </div>
      </nav>
    {% endif %}

  </div>
</div>
{% endblock %}
