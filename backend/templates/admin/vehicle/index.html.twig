{% extends 'base.html.twig' %}

{% block title %}Vehiculos - Admin{% endblock %}

{% block content %}
    {# Header #}
    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold" style="color: var(--color-text-primary);">Vehiculos</h1>
      <a href="{{ path('admin_vehicles_new') }}"
         class="inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
        Nuevo vehiculo
      </a>
    </div>

    {# Table #}
    <div class="theme-card overflow-x-auto">
      <table class="min-w-full divide-y" style="border-color: var(--color-border);">
        <thead style="background: var(--color-surface);">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Nombre</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Traccar ID</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Estado</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Capacidad</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Ultima posicion</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Creado</th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: var(--color-text-secondary);">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y" style="border-color: var(--color-border); background: var(--color-surface-elevated);">
          {% for vehicle in vehicles %}
            <tr>
              <td class="whitespace-nowrap px-6 py-4 text-sm font-medium" style="color: var(--color-text-primary);">
                {{ vehicle.name }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm" style="color: var(--color-text-secondary);">
                {{ vehicle.traccarDeviceId ?? '-' }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm">
                {% if vehicle.active %}
                  <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Activo</span>
                {% else %}
                  <span class="inline-flex rounded-full bg-red-100 px-2 text-xs font-semibold leading-5 text-red-800">Inactivo</span>
                {% endif %}
              </td>
              <td class="px-6 py-4 text-sm" style="color: var(--color-text-secondary);">
                {% if vehicle.maxWeightKg or vehicle.maxVolumeM3 or vehicle.maxParcels %}
                  <div class="space-y-0.5 text-xs">
                    {% if vehicle.maxWeightKg %}<div>{{ vehicle.maxWeightKg }} kg</div>{% endif %}
                    {% if vehicle.maxVolumeM3 %}<div>{{ vehicle.maxVolumeM3 }} m3</div>{% endif %}
                    {% if vehicle.maxParcels %}<div>{{ vehicle.maxParcels }} paq.</div>{% endif %}
                  </div>
                {% else %}
                  <span style="color: var(--color-text-muted);">Sin configurar</span>
                {% endif %}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm" style="color: var(--color-text-secondary);">
                {% set lastPos = lastPositions[vehicle.id] ?? null %}
                {% if lastPos %}
                  {{ lastPos.lat|number_format(5) }}, {{ lastPos.lng|number_format(5) }}
                {% else %}
                  <span style="color: var(--color-text-muted);">Sin senal</span>
                {% endif %}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm" style="color: var(--color-text-secondary);">
                {{ vehicle.createdAt|date('d/m/Y H:i') }}
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                <a href="{{ path('admin_vehicles_edit', {publicId: vehicle.publicIdString}) }}"
                   class="text-blue-600 hover:opacity-80 mr-3">Editar</a>
                {% if vehicle.active %}
                  <form method="post" action="{{ path('admin_vehicles_delete', {publicId: vehicle.publicIdString}) }}" class="inline"
                        onsubmit="return confirm('Desactivar este vehiculo?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-vehicle-' ~ vehicle.publicIdString) }}">
                    <button type="submit" class="text-red-600 hover:opacity-80">Desactivar</button>
                  </form>
                {% endif %}
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="7" class="px-6 py-8 text-center text-sm" style="color: var(--color-text-secondary);">
                No hay vehiculos registrados.
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    {# Pagination #}
    {% if totalPages > 1 %}
      <nav class="mt-6 flex items-center justify-between">
        <div class="text-sm" style="color: var(--color-text-secondary);">
          Pagina {{ page }} de {{ totalPages }}
        </div>
        <div class="flex space-x-2">
          {% if page > 1 %}
            <a href="{{ path('admin_vehicles_index', {page: page - 1}) }}"
               class="inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
              Anterior
            </a>
          {% endif %}
          {% if page < totalPages %}
            <a href="{{ path('admin_vehicles_index', {page: page + 1}) }}"
               class="inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
              Siguiente
            </a>
          {% endif %}
        </div>
      </nav>
    {% endif %}

{% endblock %}
