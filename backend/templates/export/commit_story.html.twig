<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Commit Story: {{ branch }}</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Helvetica Neue', Arial, sans-serif; color: #1e293b; font-size: 13px; padding: 32px; max-width: 900px; margin: 0 auto; line-height: 1.5; }
    h1 { font-size: 22px; margin-bottom: 4px; color: #0f172a; }
    h2 { font-size: 15px; margin-top: 28px; margin-bottom: 12px; border-bottom: 2px solid #6366f1; padding-bottom: 4px; color: #1e293b; }
    .meta { color: #64748b; font-size: 11px; margin-bottom: 24px; }
    .meta strong { color: #334155; }

    /* KPI Grid */
    .kpi-grid { display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; }
    .kpi-card { border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 16px; flex: 1; min-width: 120px; }
    .kpi-card .label { font-size: 10px; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; }
    .kpi-card .value { font-size: 22px; font-weight: 700; margin-top: 2px; }
    .kpi-card .desc { font-size: 9px; color: #94a3b8; margin-top: 2px; }

    /* Type colors */
    .color-feat { color: #10b981; }
    .color-fix { color: #ef4444; }
    .color-test { color: #f59e0b; }
    .color-docs { color: #3b82f6; }
    .color-refactor { color: #8b5cf6; }
    .color-chore { color: #6b7280; }
    .color-other { color: #475569; }

    .bg-feat { background: #10b981; }
    .bg-fix { background: #ef4444; }
    .bg-test { background: #f59e0b; }
    .bg-docs { background: #3b82f6; }
    .bg-refactor { background: #8b5cf6; }
    .bg-chore { background: #6b7280; }
    .bg-other { background: #475569; }

    /* Type breakdown */
    .type-grid { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px; }
    .type-pill { display: inline-flex; align-items: center; gap: 6px; border: 1px solid #e2e8f0; border-radius: 20px; padding: 4px 12px; font-size: 12px; font-weight: 500; }
    .type-pill .dot { width: 8px; height: 8px; border-radius: 50%; }
    .type-pill .count { font-weight: 700; }

    /* Timeline */
    .timeline { position: relative; padding-left: 32px; margin-top: 8px; }
    .timeline::before { content: ''; position: absolute; left: 11px; top: 4px; bottom: 4px; width: 2px; background: #e2e8f0; }

    .timeline-item { position: relative; margin-bottom: 24px; }
    .timeline-item:last-child { margin-bottom: 0; }

    .timeline-dot { position: absolute; left: -25px; top: 3px; width: 14px; height: 14px; border-radius: 50%; border: 2px solid #fff; box-shadow: 0 0 0 2px #e2e8f0; }

    .timeline-header { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .type-badge { display: inline-block; font-size: 10px; font-weight: 600; text-transform: uppercase; color: #fff; padding: 1px 8px; border-radius: 4px; letter-spacing: 0.3px; }
    .timeline-subject { font-weight: 600; font-size: 13px; color: #0f172a; }
    .timeline-meta { font-size: 11px; color: #94a3b8; margin-top: 2px; }
    .timeline-stat { font-size: 11px; color: #64748b; margin-top: 2px; }
    .timeline-stat .plus { color: #10b981; font-weight: 600; }
    .timeline-stat .minus { color: #ef4444; font-weight: 600; }
    .timeline-body { margin-top: 4px; font-size: 12px; color: #475569; font-style: italic; }

    details { margin-top: 4px; }
    details summary { font-size: 11px; color: #6366f1; cursor: pointer; }
    details summary:hover { text-decoration: underline; }
    details ul { margin-top: 4px; padding-left: 16px; }
    details li { font-size: 11px; color: #64748b; font-family: 'SF Mono', 'Consolas', monospace; }

    /* No commits */
    .empty-state { text-align: center; padding: 40px; color: #94a3b8; font-size: 14px; }

    /* Footer */
    .footer { margin-top: 40px; padding-top: 8px; border-top: 1px solid #e2e8f0; font-size: 9px; color: #94a3b8; text-align: center; }

    @media print {
      body { padding: 0; font-size: 11px; }
      @page { margin: 1.5cm; }
      details { display: none; }
      .timeline-dot { box-shadow: none; border: 2px solid #cbd5e1; }
    }
  </style>
</head>
<body>

  <h1>Commit Story: {{ branch }}</h1>
  <p class="meta">
    {% if date_from and date_to %}
      <strong>{{ date_from|date('d/m/Y H:i') }}</strong> — <strong>{{ date_to|date('d/m/Y H:i') }}</strong> |
    {% endif %}
    {% if authors|length > 0 %}
      {{ authors|join(', ') }} |
    {% endif %}
    Generado: {{ generated_at|date('d/m/Y H:i') }}
  </p>

  {% if error is defined and error %}
    <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 16px; margin-bottom: 20px; color: #991b1b; font-size: 13px;">
      <strong>Error:</strong> {{ error }}
    </div>
  {% endif %}

  {% if commits|length > 0 %}
    <h2>Resumen</h2>
    <div class="kpi-grid">
      <div class="kpi-card">
        <div class="label">Commits</div>
        <div class="value" style="color: #6366f1;">{{ total_commits }}</div>
      </div>
      <div class="kpi-card">
        <div class="label">Archivos</div>
        <div class="value" style="color: #334155;">{{ total_files }}</div>
        <div class="desc">archivos tocados</div>
      </div>
      <div class="kpi-card">
        <div class="label">Lineas +</div>
        <div class="value" style="color: #10b981;">{{ total_insertions }}</div>
      </div>
      <div class="kpi-card">
        <div class="label">Lineas -</div>
        <div class="value" style="color: #ef4444;">{{ total_deletions }}</div>
      </div>
      {% if authors|length > 0 %}
      <div class="kpi-card">
        <div class="label">Autores</div>
        <div class="value" style="color: #334155;">{{ authors|length }}</div>
      </div>
      {% endif %}
    </div>

    <h2>Por tipo</h2>
    <div class="type-grid">
      {% for type, count in type_breakdown %}
        <span class="type-pill">
          <span class="dot bg-{{ type }}"></span>
          {{ type }}
          <span class="count color-{{ type }}">{{ count }}</span>
        </span>
      {% endfor %}
    </div>

    <h2>Timeline</h2>
    <div class="timeline">
      {% for commit in commits %}
        <div class="timeline-item">
          <div class="timeline-dot bg-{{ commit.type }}"></div>
          <div class="timeline-header">
            <span class="type-badge bg-{{ commit.type }}">{{ commit.type }}</span>
            <span class="timeline-subject">{{ commit.subject }}</span>
          </div>
          <div class="timeline-meta">
            {{ commit.hash }} | {{ commit.date|date('Y-m-d H:i') }} | {{ commit.author }}
          </div>
          <div class="timeline-stat">
            {{ commit.files_count }} archivo{{ commit.files_count != 1 ? 's' : '' }}
            {% if commit.insertions > 0 %}<span class="plus">+{{ commit.insertions }}</span>{% endif %}
            {% if commit.deletions > 0 %}<span class="minus">-{{ commit.deletions }}</span>{% endif %}
          </div>
          {% if commit.body %}
            <div class="timeline-body">{{ commit.body }}</div>
          {% endif %}
          {% if commit.files|length > 0 %}
            <details>
              <summary>{{ commit.files|length }} archivo{{ commit.files|length != 1 ? 's' : '' }} modificado{{ commit.files|length != 1 ? 's' : '' }}</summary>
              <ul>
                {% for file in commit.files %}
                  <li>{{ file }}</li>
                {% endfor %}
              </ul>
            </details>
          {% endif %}
        </div>
      {% endfor %}
    </div>

  {% else %}
    <div class="empty-state">
      No se encontraron commits entre la base y la rama especificada.
    </div>
  {% endif %}

  <div class="footer">
    MXO Track — Commit Story generado automaticamente | {{ generated_at|date('d/m/Y H:i:s') }}
  </div>

</body>
</html>
