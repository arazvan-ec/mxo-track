{#
  Route Map Component
  Params:
    - mapId: string (unique DOM id for this map)
    - mapData: string (JSON from MapViewData.toJson())
    - height: string (CSS height, default '500px')
#}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<style>
  #{{ mapId }} { height: {{ height|default('500px') }}; width: 100%; border-radius: 0.5rem; }
  #{{ mapId }} img { max-width: none !important; max-height: none !important; }
  #{{ mapId }} .leaflet-tile { max-width: none !important; max-height: none !important; }
</style>
<div id="{{ mapId }}" class="border border-gray-200"></div>
<script>
document.addEventListener('DOMContentLoaded', function() {
  var data = {{ mapData|raw }};
  window['mxoMap_' + '{{ mapId }}'] = new MxoRouteMap('{{ mapId }}', data);
});
</script>
