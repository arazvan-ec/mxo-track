{#
  MxoRouteMap — Shared JS class for rendering route maps.
  Include ONCE per page in the {% block scripts %} section.
  Requires: Leaflet 1.9.4, leaflet-polylinedecorator 1.6.0
#}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="https://unpkg.com/leaflet-polylinedecorator@1.6.0/dist/leaflet.polylineDecorator.js"></script>
<script>
(function() {
  'use strict';

  // ── Color constants ──
  var COLORS = {
    routes: ['#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899', '#14b8a6'],
    stopStatus: {
      PENDING: '#3b82f6',
      DELIVERED: '#22c55e',
      EXCEPTION: '#ef4444',
      SKIPPED: '#6b7280'
    },
    origin: '#059669',
    vehicle: '#1e3a8a',
    originalRoute: '#ef4444',
    comparisonActual: '#ef4444',
    comparisonPlanned: '#3b82f6'
  };

  // ── Decode Google/OSRM encoded polyline ──
  function decodePolyline(encoded) {
    var points = [], lat = 0, lng = 0, index = 0;
    while (index < encoded.length) {
      var b, shift = 0, result = 0;
      do { b = encoded.charCodeAt(index++) - 63; result |= (b & 0x1f) << shift; shift += 5; } while (b >= 0x20);
      lat += (result & 1) ? ~(result >> 1) : (result >> 1);
      shift = 0; result = 0;
      do { b = encoded.charCodeAt(index++) - 63; result |= (b & 0x1f) << shift; shift += 5; } while (b >= 0x20);
      lng += (result & 1) ? ~(result >> 1) : (result >> 1);
      points.push([lat / 1e5, lng / 1e5]);
    }
    return points;
  }

  // ── MxoRouteMap class ──
  function MxoRouteMap(elementId, data) {
    this.elementId = elementId;
    this.data = data;
    this.map = null;
    this.routeLayers = [];
    this.vehicleMarker = null;
    this.allPoints = [];

    this.init();

    if (data.mercureTopic) {
      this.subscribeMercure(data.mercureTopic);
    }
  }

  MxoRouteMap.COLORS = COLORS;
  MxoRouteMap.decodePolyline = decodePolyline;

  MxoRouteMap.prototype.init = function() {
    var el = document.getElementById(this.elementId);
    if (!el) return;

    this.map = L.map(this.elementId, { zoomControl: true });
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 19
    }).addTo(this.map);

    this.renderRoutes();
    this.renderOrigin();
    this.renderVehicle();
    this.fitBounds();
    this.addResetControl();

    var self = this;
    setTimeout(function() { self.map.invalidateSize(); }, 100);
  };

  MxoRouteMap.prototype.renderRoutes = function() {
    var self = this;
    var routes = this.data.routes || [];
    this.routeLayers = [];

    routes.forEach(function(rd, routeIdx) {
      var color = rd.color || COLORS.routes[routeIdx % COLORS.routes.length];
      var layer = L.layerGroup();
      var stops = rd.stops || [];

      // Polyline
      var points;
      if (rd.polyline) {
        points = decodePolyline(rd.polyline);
      } else {
        // Fallback: straight lines through stops
        points = [];
        stops.forEach(function(s) {
          if (s.lat && s.lng) points.push([s.lat, s.lng]);
        });
      }

      if (points.length >= 2) {
        var poly = L.polyline(points, {
          color: color,
          weight: 5,
          opacity: 0.85
        }).addTo(layer);

        try {
          L.polylineDecorator(poly, {
            patterns: [
              { offset: 25, repeat: 80, symbol: L.Symbol.arrowHead({
                  pixelSize: 12, polygon: false,
                  pathOptions: { color: color, weight: 2, opacity: 0.9 }
                })
              }
            ]
          }).addTo(layer);
        } catch(e) { /* polyline decorator optional */ }

        points.forEach(function(p) { self.allPoints.push(p); });
      }

      // Comparison polyline (planned vs actual)
      if (rd.comparisonPolyline) {
        var actualPoints = decodePolyline(rd.comparisonPolyline);
        if (actualPoints.length >= 2) {
          L.polyline(actualPoints, {
            color: COLORS.comparisonActual,
            weight: 4,
            opacity: 0.7,
            dashArray: '8, 6'
          }).addTo(layer);
        }
      }

      // Stop markers
      stops.forEach(function(stop) {
        if (!stop.lat || !stop.lng || stop.isOrigin) return;

        var statusColor = COLORS.stopStatus[stop.status] || COLORS.stopStatus.PENDING;
        var icon = L.divIcon({
          html: '<div style="background:' + statusColor + ';color:#fff;width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;border:2px solid #fff;box-shadow:0 2px 4px rgba(0,0,0,.3);">' + stop.sequence + '</div>',
          className: '',
          iconSize: [28, 28],
          iconAnchor: [14, 14]
        });

        var popupHtml = '<strong>' + (rd.name || 'Ruta') + ' #' + stop.sequence + '</strong>';
        if (stop.recipientName) popupHtml += '<br>' + stop.recipientName;
        popupHtml += '<br><small>' + stop.address + '</small>';
        if (stop.status === 'DELIVERED' && stop.deliveredAt) {
          popupHtml += '<br><span style="color:#22c55e;font-size:11px;">Entregado: ' + new Date(stop.deliveredAt).toLocaleTimeString() + '</span>';
        }
        if (stop.status === 'EXCEPTION') {
          popupHtml += '<br><span style="color:#ef4444;font-size:11px;">Excepcion' + (stop.exceptionCode ? ': ' + stop.exceptionCode : '') + '</span>';
        }

        L.marker([stop.lat, stop.lng], { icon: icon, zIndexOffset: 100 + routeIdx * 10 })
          .bindPopup(popupHtml)
          .addTo(layer);

        self.allPoints.push([stop.lat, stop.lng]);
      });

      layer.addTo(self.map);
      self.routeLayers.push({ layer: layer, color: color, name: rd.name });
    });
  };

  MxoRouteMap.prototype.renderOrigin = function() {
    var origin = this.data.origin;
    if (!origin || !origin.lat || !origin.lng) return;

    var icon = L.divIcon({
      html: '<div style="background:#059669;color:#fff;width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;border:3px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.3);">O</div>',
      className: '',
      iconSize: [32, 32],
      iconAnchor: [16, 16]
    });

    L.marker([origin.lat, origin.lng], { icon: icon, zIndexOffset: 1000 })
      .bindPopup('<strong>Origen</strong>' + (origin.address ? '<br>' + origin.address : ''))
      .addTo(this.map);

    this.allPoints.push([origin.lat, origin.lng]);
  };

  MxoRouteMap.prototype.renderVehicle = function() {
    var pos = this.data.vehiclePosition;
    if (!pos || !pos.lat || !pos.lng) return;

    var icon = this.createVehicleIcon(pos.course);
    this.vehicleMarker = L.marker([pos.lat, pos.lng], { icon: icon, zIndexOffset: 2000 })
      .bindTooltip('Vehiculo' + (pos.speed ? ' - ' + Math.round(pos.speed) + ' km/h' : ''), {
        direction: 'top', offset: [0, -20]
      })
      .addTo(this.map);
    this.allPoints.push([pos.lat, pos.lng]);

    // Subscribe to vehicle position updates via Mercure
    var vehicleId = this.data.vehiclePublicId;
    if (vehicleId) {
      this.subscribeVehicle(vehicleId);
    }
  };

  MxoRouteMap.prototype.createVehicleIcon = function(course) {
    var rotation = course || 0;
    return L.divIcon({
      className: '',
      iconSize: [36, 36],
      iconAnchor: [18, 18],
      html: '<div style="background:#1e3a8a;border:2px solid #3b82f6;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,.4);transform:rotate(' + rotation + 'deg);">' +
        '<svg width="18" height="18" viewBox="0 0 24 24" fill="#fff" xmlns="http://www.w3.org/2000/svg">' +
        '<path d="M18 18.5a1.5 1.5 0 100-3 1.5 1.5 0 000 3zm-12 0a1.5 1.5 0 100-3 1.5 1.5 0 000 3zM19.92 6.09C19.72 5.46 19.16 5 18.5 5h-11c-.66 0-1.21.42-1.42 1.02L4 12v6c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h10v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-6l-2.08-5.91zM7.5 15a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm9 0a1.5 1.5 0 110-3 1.5 1.5 0 010 3zM5.81 10l1.04-3h10.29l1.04 3H5.81z"/>' +
        '</svg></div>'
    });
  };

  MxoRouteMap.prototype.subscribeVehicle = function(vehiclePublicId) {
    var self = this;
    fetch('/api/mercure-token', { credentials: 'include' })
      .then(function(res) { return res.json(); })
      .then(function(tokenData) {
        var mercureUrl = self.data.mercureUrl || tokenData.mercureUrl;
        if (!mercureUrl) return;

        var hub = new URL(mercureUrl);
        hub.searchParams.set('topic', '/map/vehicles/' + vehiclePublicId + '/position');
        if (tokenData.token) {
          hub.searchParams.set('authorization', tokenData.token);
        }

        var es = new EventSource(hub);
        es.onmessage = function(e) {
          try {
            var d = JSON.parse(e.data);
            if (d.lat && d.lng) {
              if (self.vehicleMarker) {
                self.vehicleMarker.setLatLng([d.lat, d.lng]);
                self.vehicleMarker.setIcon(self.createVehicleIcon(d.course));
                if (self.vehicleMarker.getTooltip()) self.vehicleMarker.unbindTooltip();
                self.vehicleMarker.bindTooltip('Vehiculo - ' + Math.round(d.speed || 0) + ' km/h', {
                  direction: 'top', offset: [0, -20]
                });
              } else {
                self.vehicleMarker = L.marker([d.lat, d.lng], {
                  icon: self.createVehicleIcon(d.course), zIndexOffset: 2000
                }).bindTooltip('Vehiculo', { direction: 'top', offset: [0, -20] })
                  .addTo(self.map);
              }
            }
          } catch(err) { /* ignore */ }
        };

        window.addEventListener('beforeunload', function() { es.close(); });
      })
      .catch(function(err) {
        console.warn('MxoRouteMap: vehicle tracking failed', err);
      });
  };

  MxoRouteMap.prototype.fitBounds = function() {
    if (this.allPoints.length > 0) {
      this.map.fitBounds(this.allPoints, { padding: [40, 40] });
    } else {
      this.map.setView([40.4168, -3.7038], 12);
    }
  };

  MxoRouteMap.prototype.addResetControl = function() {
    var self = this;
    var ResetControl = L.Control.extend({
      options: { position: 'topright' },
      onAdd: function() {
        var btn = L.DomUtil.create('div', 'leaflet-control-reset leaflet-bar');
        btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>';
        btn.title = 'Centrar mapa';
        btn.style.cssText = 'background:#fff;cursor:pointer;width:34px;height:34px;display:flex;align-items:center;justify-content:center;';
        L.DomEvent.disableClickPropagation(btn);
        btn.addEventListener('click', function() { self.fitBounds(); });
        return btn;
      }
    });
    this.map.addControl(new ResetControl());
  };

  MxoRouteMap.prototype.clearLayers = function() {
    var self = this;
    this.routeLayers.forEach(function(rl) {
      self.map.removeLayer(rl.layer);
    });
    this.routeLayers = [];
    this.allPoints = [];

    // Remove all non-tile layers
    self.map.eachLayer(function(layer) {
      if (!(layer instanceof L.TileLayer)) {
        self.map.removeLayer(layer);
      }
    });
  };

  MxoRouteMap.prototype.update = function(newData) {
    this.data = Object.assign({}, this.data, newData);
    this.clearLayers();
    this.renderRoutes();
    this.renderOrigin();
    this.fitBounds();

    // Emit custom event for external components (metrics, stop list, etc.)
    document.dispatchEvent(new CustomEvent('mxo:route-updated', {
      detail: { mapId: this.elementId, data: this.data }
    }));
  };

  MxoRouteMap.prototype.subscribeMercure = function(topic) {
    var self = this;
    fetch('/api/mercure-token', { credentials: 'include' })
      .then(function(res) { return res.json(); })
      .then(function(tokenData) {
        var mercureUrl = self.data.mercureUrl || tokenData.mercureUrl;
        if (!mercureUrl) return;

        var hub = new URL(mercureUrl);
        hub.searchParams.set('topic', topic);
        if (tokenData.token) {
          hub.searchParams.set('authorization', tokenData.token);
        }

        var es = new EventSource(hub);
        es.onmessage = function(e) {
          try {
            var msg = JSON.parse(e.data);
            // Unified envelope: {type, routePublicId, data, occurredAt}
            if (msg.type && msg.routePublicId && msg.data) {
              if (msg.type === 'route_snapshot') {
                self.update(msg.data);
              }
              // Other event types are informational; no map update needed
            } else {
              // Legacy format: direct MapViewData
              self.update(msg);
            }
          } catch(err) {
            console.warn('MxoRouteMap: failed to parse Mercure update', err);
          }
        };

        window.addEventListener('beforeunload', function() { es.close(); });
      })
      .catch(function(err) {
        console.warn('MxoRouteMap: failed to subscribe to Mercure', err);
      });
  };

  // Toggle route visibility (call from external controls)
  MxoRouteMap.prototype.toggleRoute = function(routeIndex, visible) {
    var rl = this.routeLayers[routeIndex];
    if (!rl) return;
    if (visible) {
      rl.layer.addTo(this.map);
    } else {
      this.map.removeLayer(rl.layer);
    }
  };

  // Expose globally
  window.MxoRouteMap = MxoRouteMap;
})();
</script>
