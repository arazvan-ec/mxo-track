{#
  Route Card Component — per-route detail card
  Params:
    - route: array (RouteViewData.toArray())
    - showMetrics: bool (default false)
    - showTiming: bool (default false)
    - showValidation: bool (default false)
    - showOriginalOrder: bool (default false)
    - routeIndex: int (for toggle controls)
    - mapId: string (optional, for route toggle)
#}
{% set showMetrics = showMetrics|default(false) %}
{% set showTiming = showTiming|default(false) %}
{% set showValidation = showValidation|default(false) %}
{% set showOriginalOrder = showOriginalOrder|default(false) %}

<div class="rounded-lg border border-gray-200 bg-white overflow-hidden" x-data="{ expanded: true }">
  {# Header #}
  <div class="flex items-center justify-between px-4 py-3 cursor-pointer hover:bg-gray-50"
       @click="expanded = !expanded">
    <div class="flex items-center gap-3">
      {# Color indicator #}
      <div class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: {{ route.color|default('#3b82f6') }};"></div>
      <h4 class="text-sm font-semibold text-gray-900">{{ route.name|default('Ruta') }}</h4>
      {% if route.vehicleName is defined and route.vehicleName %}
        <span class="text-xs text-gray-500">{{ route.vehicleName }}</span>
      {% endif %}

      {# Toggle visibility on map #}
      {% if mapId is defined and routeIndex is defined %}
      <label class="flex items-center gap-1 text-xs text-gray-500 cursor-pointer" @click.stop>
        <input type="checkbox" checked class="w-3.5 h-3.5"
               onchange="window['mxoMap_{{ mapId }}'] && window['mxoMap_{{ mapId }}'].toggleRoute({{ routeIndex }}, this.checked)">
        Mapa
      </label>
      {% endif %}
    </div>

    <div class="flex items-center gap-2">
      <span class="text-xs text-gray-500">{{ route.stops|default([])|length }} paradas</span>
      <svg class="h-4 w-4 text-gray-400 transition-transform" :class="expanded ? 'rotate-180' : ''" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
      </svg>
    </div>
  </div>

  <div x-show="expanded" x-collapse>
    <div class="border-t border-gray-100 px-4 py-3 space-y-4">

      {# Metrics #}
      {% if showMetrics and route.metrics is defined and route.metrics %}
      <div class="grid grid-cols-3 gap-3">
        <div>
          <p class="text-xs text-gray-500">Dist. antes</p>
          <p class="text-sm font-semibold text-gray-700">{{ route.metrics.distanceBeforeKm is defined ? route.metrics.distanceBeforeKm|number_format(1) : '—' }} km</p>
        </div>
        <div>
          <p class="text-xs text-gray-500">Dist. despues</p>
          <p class="text-sm font-semibold text-blue-600">{{ route.metrics.distanceAfterKm is defined ? route.metrics.distanceAfterKm|number_format(1) : '—' }} km</p>
        </div>
        <div>
          <p class="text-xs text-gray-500">Ahorro</p>
          <p class="text-sm font-semibold text-green-600">{{ route.metrics.savingsPercent is defined ? route.metrics.savingsPercent|number_format(1) : '0' }}%</p>
        </div>
      </div>
      {% endif %}

      {# Timing #}
      {% if showTiming and route.timing is defined and route.timing %}
      <div class="grid grid-cols-3 gap-3">
        <div>
          <p class="text-xs text-gray-500">Conduccion</p>
          <p class="text-sm font-semibold text-gray-700">{{ route.timing.drivingTimeMinutes|default(0) }} min</p>
        </div>
        <div>
          <p class="text-xs text-gray-500">Entregas</p>
          <p class="text-sm font-semibold text-gray-700">{{ route.timing.deliveryTimeMinutes|default(0) }} min</p>
        </div>
        <div>
          <p class="text-xs text-gray-500">Total</p>
          <p class="text-sm font-semibold text-gray-900">{{ route.timing.totalTimeMinutes|default(0) }} min</p>
        </div>
      </div>
      {% endif %}

      {# Capacity Validation #}
      {% if showValidation and route.validation is defined and route.validation %}
      <div>
        {% if route.validation.valid is defined and not route.validation.valid %}
          <div class="rounded-md bg-red-50 border border-red-200 p-2">
            {% for error in route.validation.errors|default([]) %}
              <p class="text-xs text-red-700">{{ error }}</p>
            {% endfor %}
          </div>
        {% endif %}
      </div>
      {% endif %}

      {# Stop list (compact) #}
      <div class="space-y-1">
        {% for stop in route.stops|default([]) %}
          {% if not stop.isOrigin|default(false) %}
          <div class="flex items-center gap-2 text-xs">
            {% set statusColor = 'text-blue-600' %}
            {% if stop.status|default('PENDING') == 'DELIVERED' %}{% set statusColor = 'text-green-600' %}
            {% elseif stop.status|default('PENDING') == 'EXCEPTION' %}{% set statusColor = 'text-red-600' %}{% endif %}
            <span class="{{ statusColor }} font-mono font-bold w-5 text-right">{{ stop.sequence }}</span>
            <span class="text-gray-700 truncate flex-1">{{ stop.recipientName|default(stop.address) }}</span>
            <span class="text-gray-400 truncate max-w-[200px]">{{ stop.address }}</span>
          </div>
          {% endif %}
        {% endfor %}
      </div>

      {# Original order comparison #}
      {% if showOriginalOrder and route.originalStops is defined and route.originalStops %}
      <details class="text-xs">
        <summary class="cursor-pointer text-gray-500 hover:text-gray-700">Ver orden original</summary>
        <div class="mt-2 space-y-1 pl-2 border-l-2 border-gray-200">
          {% for os in route.originalStops %}
            {% if not os.isOrigin|default(false) %}
            <div class="flex items-center gap-2">
              <span class="text-gray-400 font-mono w-5 text-right">{{ os.sequence }}</span>
              <span class="text-gray-600">{{ os.recipientName|default(os.address) }}</span>
            </div>
            {% endif %}
          {% endfor %}
        </div>
      </details>
      {% endif %}

    </div>
  </div>
</div>
