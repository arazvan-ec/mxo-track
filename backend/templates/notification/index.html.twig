{% extends 'base.html.twig' %}

{% block title %}Notificaciones - MXO Track{% endblock %}

{% block breadcrumbs %}
    <li>
        <div class="flex items-center">
            <svg class="h-5 w-5 shrink-0" style="color: var(--color-text-muted);" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
            </svg>
            <span class="ml-2 text-sm font-medium" style="color: var(--color-text-secondary);">Notificaciones</span>
        </div>
    </li>
{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="sm:flex sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold" style="color: var(--color-text-primary);">Notificaciones</h1>
            <p class="mt-1 text-sm" style="color: var(--color-text-secondary);">
                {% if unread_count > 0 %}
                    {{ unread_count }} sin leer de {{ total_count }} total
                {% else %}
                    {{ total_count }} notificaciones
                {% endif %}
            </p>
        </div>
    </div>

    {% if notifications is empty %}
        <div class="text-center py-12">
            <svg class="mx-auto h-12 w-12" style="color: var(--color-text-muted);" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"/>
            </svg>
            <h3 class="mt-2 text-sm font-semibold" style="color: var(--color-text-primary);">Sin notificaciones</h3>
            <p class="mt-1 text-sm" style="color: var(--color-text-secondary);">No tienes notificaciones por el momento.</p>
        </div>
    {% else %}
        <div class="theme-card rounded-lg overflow-hidden">
            <ul role="list" class="divide-y" style="border-color: var(--color-border);">
                {% for notification in notifications %}
                    <li class="relative px-4 py-5 sm:px-6 {{ not notification.read ? 'bg-blue-50/50' : '' }}">
                        <div class="flex items-start gap-x-4">
                            <div class="min-w-0 flex-auto">
                                <div class="flex items-center gap-x-3">
                                    {% if not notification.read %}
                                        <span class="flex-none rounded-full bg-blue-500 p-1">
                                            <span class="sr-only">Sin leer</span>
                                        </span>
                                    {% endif %}
                                    <p class="text-sm font-semibold leading-6" style="color: var(--color-text-primary);">{{ notification.title }}</p>
                                    <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset
                                        {% if notification.type starts with 'shipment_delivered' %}
                                            badge-soft-green ring-green-600/20
                                        {% elseif notification.type starts with 'shipment_exception' or notification.type starts with 'vehicle_offline' %}
                                            badge-soft-red ring-red-600/20
                                        {% elseif notification.type starts with 'route_assigned' %}
                                            badge-soft-blue ring-blue-600/20
                                        {% else %}
                                            ring-gray-600/20
                                        {% endif %}
                                    " {% if not (notification.type starts with 'shipment_delivered' or notification.type starts with 'shipment_exception' or notification.type starts with 'vehicle_offline' or notification.type starts with 'route_assigned') %}style="color: var(--color-text-secondary);"{% endif %}>{{ notification.type }}</span>
                                </div>
                                <p class="mt-1 text-sm leading-5" style="color: var(--color-text-secondary);">{{ notification.message }}</p>
                                <p class="mt-1 text-xs" style="color: var(--color-text-muted);">{{ notification.createdAt|date('d/m/Y H:i') }}</p>
                            </div>
                            <div class="flex-none flex items-center gap-x-2">
                                {% if not notification.read %}
                                    <form method="post" action="{{ path('notification_mark_read', { publicId: notification.publicIdString }) }}">
                                        <button type="submit"
                                                class="rounded-md px-3 py-2 text-xs font-semibold shadow-sm ring-1 ring-inset transition-colors"
                                                style="background: var(--color-surface-elevated); color: var(--color-text-primary); --tw-ring-color: var(--color-border);">
                                            Marcar leida
                                        </button>
                                    </form>
                                {% else %}
                                    <span class="text-xs" style="color: var(--color-text-muted);">Leida {{ notification.readAt|date('d/m/Y H:i') }}</span>
                                {% endif %}
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </div>

        {# Pagination #}
        {% if total_pages > 1 %}
            <nav class="flex items-center justify-between" aria-label="Pagination">
                <div class="hidden sm:block">
                    <p class="text-sm" style="color: var(--color-text-secondary);">
                        Pagina <span class="font-medium">{{ current_page }}</span> de <span class="font-medium">{{ total_pages }}</span>
                    </p>
                </div>
                <div class="flex flex-1 justify-between sm:justify-end gap-x-3">
                    {% if current_page > 1 %}
                        <a href="{{ path('notification_index', { page: current_page - 1 }) }}"
                           class="relative inline-flex items-center rounded-md px-3 py-2 text-sm font-semibold ring-1 ring-inset"
                           style="background: var(--color-surface-elevated); color: var(--color-text-primary); --tw-ring-color: var(--color-border);">
                            Anterior
                        </a>
                    {% endif %}
                    {% if current_page < total_pages %}
                        <a href="{{ path('notification_index', { page: current_page + 1 }) }}"
                           class="relative inline-flex items-center rounded-md px-3 py-2 text-sm font-semibold ring-1 ring-inset"
                           style="background: var(--color-surface-elevated); color: var(--color-text-primary); --tw-ring-color: var(--color-border);">
                            Siguiente
                        </a>
                    {% endif %}
                </div>
            </nav>
        {% endif %}
    {% endif %}
</div>
{% endblock %}
