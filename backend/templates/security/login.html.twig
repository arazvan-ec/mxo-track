<!doctype html>
<html lang="es" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Iniciar sesion - MXO Track</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#eff6ff',
              100: '#dbeafe',
              200: '#bfdbfe',
              300: '#93c5fd',
              400: '#60a5fa',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
              800: '#1e40af',
              900: '#1e3a8a',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="h-full bg-slate-100">

<div class="flex min-h-full">

  {# ── Left panel: decorative ─────────────────────────────────────── #}
  <div class="hidden lg:flex lg:w-1/2 lg:flex-col lg:justify-center lg:items-center relative bg-slate-800 overflow-hidden">
    {# Subtle grid pattern overlay #}
    <div class="absolute inset-0 opacity-5">
      <svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="0.5"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)"/>
      </svg>
    </div>

    {# Decorative gradient blobs #}
    <div class="absolute -top-24 -left-24 h-96 w-96 rounded-full bg-brand-600/20 blur-3xl"></div>
    <div class="absolute -bottom-24 -right-24 h-96 w-96 rounded-full bg-brand-400/10 blur-3xl"></div>

    <div class="relative z-10 max-w-md px-8 text-center">
      {# Logo #}
      <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-2xl bg-brand-600 shadow-lg shadow-brand-600/30 mb-8">
        <svg class="h-10 w-10 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
        </svg>
      </div>

      <h1 class="text-3xl font-bold text-white tracking-tight">MXO Track</h1>
      <p class="mt-3 text-lg text-slate-300">
        Plataforma de seguimiento logistico en tiempo real
      </p>

      <div class="mt-10 grid grid-cols-3 gap-6 text-center">
        <div>
          <div class="flex h-12 w-12 mx-auto items-center justify-center rounded-lg bg-slate-700/50">
            <svg class="h-6 w-6 text-brand-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
            </svg>
          </div>
          <p class="mt-2 text-xs font-medium text-slate-400">GPS en vivo</p>
        </div>
        <div>
          <div class="flex h-12 w-12 mx-auto items-center justify-center rounded-lg bg-slate-700/50">
            <svg class="h-6 w-6 text-brand-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/>
            </svg>
          </div>
          <p class="mt-2 text-xs font-medium text-slate-400">Rutas</p>
        </div>
        <div>
          <div class="flex h-12 w-12 mx-auto items-center justify-center rounded-lg bg-slate-700/50">
            <svg class="h-6 w-6 text-brand-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
            </svg>
          </div>
          <p class="mt-2 text-xs font-medium text-slate-400">POD seguro</p>
        </div>
      </div>
    </div>
  </div>

  {# ── Right panel: login form ────────────────────────────────────── #}
  <div class="flex flex-1 flex-col justify-center px-6 py-12 lg:w-1/2 lg:px-16 xl:px-24">
    <div class="mx-auto w-full max-w-sm">

      {# Mobile logo #}
      <div class="lg:hidden text-center mb-8">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-xl bg-brand-600 shadow-lg mb-4">
          <svg class="h-7 w-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-slate-800">MXO Track</h1>
      </div>

      <div>
        <h2 class="text-2xl font-bold leading-9 tracking-tight" style="color: var(--color-text-primary);">
          Iniciar sesion
        </h2>
        <p class="mt-2 text-sm" style="color: var(--color-text-secondary);">
          Introduce tus credenciales para acceder al panel
        </p>
      </div>

      {# Error message #}
      {% if error %}
      <div class="mt-6 rounded-lg bg-red-50 p-4 ring-1 ring-inset ring-red-200">
        <div class="flex items-center gap-3">
          <svg class="h-5 w-5 text-red-500 shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd"/>
          </svg>
          <p class="text-sm font-medium text-red-800">Credenciales invalidas. Verifica tu email y clave.</p>
        </div>
      </div>
      {% endif %}

      <form class="mt-8 space-y-6" method="post">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        {# Email field #}
        <div>
          <label for="email" class="block text-sm font-medium leading-6" style="color: var(--color-text-primary);">
            Correo electronico
          </label>
          <div class="mt-2 relative">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5">
              <svg class="h-5 w-5" style="color: var(--color-text-muted);" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
              </svg>
            </div>
            <input id="email"
                   name="_username"
                   type="email"
                   value="{{ last_username }}"
                   autocomplete="email"
                   required
                   placeholder="usuario@empresa.com"
                   class="block w-full rounded-lg border-0 py-3 pl-11 pr-4 shadow-sm ring-1 ring-inset focus:ring-2 focus:ring-inset focus:ring-brand-600 text-sm leading-6 transition-shadow"
                   style="background: var(--color-surface-elevated); color: var(--color-text-primary); border-color: var(--color-border);">
          </div>
        </div>

        {# Password field #}
        <div>
          <label for="password" class="block text-sm font-medium leading-6" style="color: var(--color-text-primary);">
            Clave
          </label>
          <div class="mt-2 relative">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5">
              <svg class="h-5 w-5" style="color: var(--color-text-muted);" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
              </svg>
            </div>
            <input id="password"
                   name="_password"
                   type="password"
                   autocomplete="current-password"
                   required
                   placeholder="Tu clave de acceso"
                   class="block w-full rounded-lg border-0 py-3 pl-11 pr-4 shadow-sm ring-1 ring-inset focus:ring-2 focus:ring-inset focus:ring-brand-600 text-sm leading-6 transition-shadow"
                   style="background: var(--color-surface-elevated); color: var(--color-text-primary); border-color: var(--color-border);">
          </div>
        </div>

        {# Submit button #}
        <div>
          <button type="submit"
                  class="flex w-full justify-center rounded-lg bg-brand-600 px-4 py-3 text-sm font-semibold leading-6 text-white shadow-sm hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 transition-colors">
            Acceder al panel
          </button>
        </div>
      </form>

      {# Footer #}
      <p class="mt-10 text-center text-xs" style="color: var(--color-text-muted);">
        MXO Track &mdash; Plataforma de seguimiento logistico
      </p>

    </div>
  </div>

</div>

</body>
</html>
