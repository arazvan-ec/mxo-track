{% extends 'base.html.twig' %}

{% block title %}Buscar: {{ query }} - MXO Track{% endblock %}

{% block breadcrumbs %}
  <li>
    <div class="flex items-center">
      <svg class="h-5 w-5 shrink-0" style="color: var(--color-text-muted);" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
      </svg>
      <span class="ml-2 text-sm font-medium" style="color: var(--color-text-secondary);">Resultados de busqueda</span>
    </div>
  </li>
{% endblock %}

{% block content %}
  <div class="mb-6">
    <h1 class="text-2xl font-bold" style="color: var(--color-text-primary);">Resultados de busqueda</h1>
    {% if query is not empty %}
      <p class="mt-1 text-sm" style="color: var(--color-text-secondary);">{{ results|length }} resultado{{ results|length != 1 ? 's' : '' }} para "<span class="font-medium" style="color: var(--color-text-secondary);">{{ query }}</span>"</p>
    {% endif %}
  </div>

  {# Search form #}
  <div class="mb-6">
    <form action="{{ path('app_search') }}" method="GET" class="max-w-lg">
      <div class="relative">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
          <svg class="h-5 w-5" style="color: var(--color-text-muted);" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
          </svg>
        </div>
        <input type="text" name="q" value="{{ query }}" placeholder="Buscar envios, rutas, vehiculos..."
               class="block w-full rounded-lg border py-2.5 pl-10 pr-3 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
               style="background: var(--color-surface-elevated); color: var(--color-text-primary); border-color: var(--color-border);">
      </div>
    </form>
  </div>

  {% if results|length > 0 %}
    <div class="theme-card rounded-lg overflow-hidden divide-y" style="border-color: var(--color-border);">
      {% for result in results %}
        <a href="{{ result.url }}" class="flex items-center gap-4 px-6 py-4 transition-colors hover:opacity-80">
          {# Type icon #}
          <div class="shrink-0">
            {% if result.type == 'shipment' %}
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-blue-100 text-blue-600">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"/>
                </svg>
              </span>
            {% elseif result.type == 'route' %}
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-amber-100 text-amber-600">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/>
                </svg>
              </span>
            {% elseif result.type == 'vehicle' %}
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-green-100 text-green-600">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
                </svg>
              </span>
            {% endif %}
          </div>

          {# Content #}
          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium" style="color: var(--color-text-primary);">{{ result.label }}</p>
            {% if result.extra is not empty %}
              <p class="text-xs" style="color: var(--color-text-secondary);">{{ result.extra }}</p>
            {% endif %}
          </div>

          {# Type badge #}
          <div class="shrink-0">
            {% if result.type == 'shipment' %}
              <span class="inline-flex rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-medium text-blue-800">Envio</span>
            {% elseif result.type == 'route' %}
              <span class="inline-flex rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-800">Ruta</span>
            {% elseif result.type == 'vehicle' %}
              <span class="inline-flex rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800">Vehiculo</span>
            {% endif %}
          </div>

          {# Arrow #}
          <svg class="h-5 w-5 shrink-0" style="color: var(--color-text-muted);" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
          </svg>
        </a>
      {% endfor %}
    </div>
  {% elseif query is not empty %}
    <div class="rounded-lg px-6 py-12 text-center shadow" style="background: var(--color-surface-elevated);">
      <svg class="mx-auto h-12 w-12" style="color: var(--color-text-muted);" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
      </svg>
      <h3 class="mt-4 text-sm font-semibold" style="color: var(--color-text-primary);">Sin resultados</h3>
      <p class="mt-1 text-sm" style="color: var(--color-text-secondary);">No se encontraron resultados para "{{ query }}". Intenta con otros terminos.</p>
    </div>
  {% endif %}
{% endblock %}
