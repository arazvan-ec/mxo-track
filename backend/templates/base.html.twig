<!doctype html>
<html lang="{{ app.request.locale }}" class="h-full bg-gray-50">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}MXO Track{% endblock %}</title>
  <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}">
  <link rel="icon" type="image/png" href="{{ asset('favicon.png') }}">

  {# Preconnect to external CDNs for faster resource loading #}
  <link rel="preconnect" href="https://cdn.tailwindcss.com">
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>

  <style>[x-cloak] { display: none !important; }</style>

  {# Tailwind CSS via CDN (TODO: replace with compiled build via npm run build:css) #}
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#eff6ff',
              100: '#dbeafe',
              200: '#bfdbfe',
              300: '#93c5fd',
              400: '#60a5fa',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
              800: '#1e40af',
              900: '#1e3a8a',
            },
            sidebar: {
              DEFAULT: '#1e293b',
              hover: '#334155',
              active: '#0f172a',
            }
          }
        }
      }
    }
  </script>

  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
  {% block styles %}{% endblock %}
</head>
<body class="h-full" {% block body_attrs %}{% endblock %}>
{% block body %}
<div class="min-h-full">

  {# ── Sidebar (icons-only on mobile, full on desktop) ────────────── #}
  <div class="fixed inset-y-0 z-30 flex w-16 lg:w-64 flex-col transition-all duration-200">
    <div class="flex grow flex-col overflow-y-auto bg-slate-800 border-r border-slate-700">
      {% include '_sidebar_content.html.twig' %}
    </div>
  </div>

  {# ── Main content area ──────────────────────────────────────────── #}
  <div class="pl-16 lg:pl-64">

    {# ── Top bar ─────────────────────────────────────────────────── #}
    <div class="sticky top-0 z-20 flex h-16 shrink-0 items-center gap-x-4 border-b border-gray-200 bg-white px-4 shadow-sm sm:gap-x-6 sm:px-6 lg:px-8">

      <div class="flex flex-1 gap-x-4 self-stretch lg:gap-x-6">
        {# Search bar #}
        <div class="flex flex-1 items-center" x-data="searchAutocomplete()" @click.outside="showDropdown = false">
          <div class="relative w-full max-w-md">
            <form action="{{ path('app_search') }}" method="GET" class="relative">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
                </svg>
              </div>
              <input type="text" name="q" placeholder="Buscar envios, rutas, vehiculos..."
                     class="block w-full rounded-lg border border-gray-200 bg-gray-50 py-2 pl-9 pr-3 text-sm text-gray-900 placeholder:text-gray-400 focus:border-brand-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-brand-500"
                     x-model="query" @input.debounce.300ms="fetchResults()" @focus="if(results.length) showDropdown = true"
                     autocomplete="off">
            </form>
            {# Autocomplete dropdown #}
            <div x-show="showDropdown && results.length > 0" x-cloak
                 class="absolute left-0 top-full z-50 mt-1 w-full rounded-lg bg-white shadow-lg ring-1 ring-gray-200 max-h-80 overflow-y-auto">
              <template x-for="result in results" :key="result.url">
                <a :href="result.url" class="flex items-center gap-3 px-4 py-2.5 hover:bg-gray-50 transition-colors border-b border-gray-100 last:border-0">
                  <span class="shrink-0">
                    <template x-if="result.type === 'shipment'">
                      <span class="inline-flex h-6 w-6 items-center justify-center rounded bg-blue-100 text-blue-600">
                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"/></svg>
                      </span>
                    </template>
                    <template x-if="result.type === 'route'">
                      <span class="inline-flex h-6 w-6 items-center justify-center rounded bg-amber-100 text-amber-600">
                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
                      </span>
                    </template>
                    <template x-if="result.type === 'vehicle'">
                      <span class="inline-flex h-6 w-6 items-center justify-center rounded bg-green-100 text-green-600">
                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/></svg>
                      </span>
                    </template>
                  </span>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium text-gray-900 truncate" x-text="result.label"></p>
                    <p class="text-xs text-gray-500 truncate" x-text="result.extra"></p>
                  </div>
                  <span class="shrink-0 text-[10px] font-medium uppercase tracking-wider text-gray-400" x-text="result.type === 'shipment' ? 'Envio' : (result.type === 'route' ? 'Ruta' : 'Vehiculo')"></span>
                </a>
              </template>
            </div>
          </div>
        </div>

        {# Notification bell + User dropdown #}
        <div class="flex items-center gap-x-4 lg:gap-x-6">

          {# ── Language switcher ──────────────────────────────────── #}
          <div x-data="{ langOpen: false }" class="relative">
            <button type="button" @click="langOpen = !langOpen" @click.outside="langOpen = false"
                    class="flex items-center gap-1 rounded-md px-2 py-1 text-xs font-medium text-gray-600 hover:bg-gray-100 transition-colors">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 21l5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 016-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 01-3.827-5.802"/>
              </svg>
              <span>{{ app.request.locale|upper }}</span>
            </button>
            <div x-show="langOpen"
                 x-transition:enter="transition ease-out duration-100"
                 x-transition:enter-start="transform opacity-0 scale-95"
                 x-transition:enter-end="transform opacity-100 scale-100"
                 x-transition:leave="transition ease-in duration-75"
                 x-transition:leave-start="transform opacity-100 scale-100"
                 x-transition:leave-end="transform opacity-0 scale-95"
                 class="absolute right-0 z-10 mt-2 w-32 origin-top-right rounded-md bg-white py-1 shadow-lg ring-1 ring-gray-900/5 focus:outline-none"
                 style="display: none;">
              <form method="post" action="{{ path('app_locale_switch', {locale: 'es'}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('locale') }}">
                <button type="submit" class="block w-full px-4 py-2 text-left text-sm {% if app.request.locale == 'es' %}text-brand-600 font-medium bg-gray-50{% else %}text-gray-700 hover:bg-gray-50{% endif %}">
                  {{ 'locale.es'|trans }}
                </button>
              </form>
              <form method="post" action="{{ path('app_locale_switch', {locale: 'en'}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('locale') }}">
                <button type="submit" class="block w-full px-4 py-2 text-left text-sm {% if app.request.locale == 'en' %}text-brand-600 font-medium bg-gray-50{% else %}text-gray-700 hover:bg-gray-50{% endif %}">
                  {{ 'locale.en'|trans }}
                </button>
              </form>
            </div>
          </div>

          {# ── Notification bell ─────────────────────────────────── #}
          {% if app.user %}
          <div x-data="notificationBell()" x-init="init()" @beforeunload.window="destroy()"
               data-user-id="{{ app.user.id }}" data-mercure-url="{{ mercure_public_url }}" class="relative">
            <a href="{{ path('notification_index') }}"
               class="relative -m-2.5 p-2.5 text-gray-400 hover:text-gray-500 transition-colors">
              <span class="sr-only">Ver notificaciones</span>
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"/>
              </svg>
              <span x-show="unreadCount > 0" x-cloak
                    x-text="unreadCount > 99 ? '99+' : unreadCount"
                    class="absolute -top-1 -right-1 flex h-5 min-w-[1.25rem] items-center justify-center rounded-full bg-red-500 px-1 text-[10px] font-bold text-white">
              </span>
            </a>
          </div>

          {# Separator #}
          <div class="hidden lg:block lg:h-6 lg:w-px lg:bg-gray-200" aria-hidden="true"></div>
          {% endif %}

          <div x-data="{ open: false }" class="relative">
            <button type="button" @click="open = !open" @click.outside="open = false"
                    class="-m-1.5 flex items-center p-1.5">
              <span class="sr-only">{{ 'a11y.user_menu'|trans }}</span>
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-sm font-semibold text-white">
                {{ app.user ? app.user.email|first|upper : '?' }}
              </span>
              <span class="hidden lg:flex lg:items-center">
                <span class="ml-3 text-sm font-semibold leading-6 text-gray-900" aria-hidden="true">
                  {{ app.user ? app.user.email : '' }}
                </span>
                <svg class="ml-2 h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/>
                </svg>
              </span>
            </button>

            <div x-show="open"
                 x-transition:enter="transition ease-out duration-100"
                 x-transition:enter-start="transform opacity-0 scale-95"
                 x-transition:enter-end="transform opacity-100 scale-100"
                 x-transition:leave="transition ease-in duration-75"
                 x-transition:leave-start="transform opacity-100 scale-100"
                 x-transition:leave-end="transform opacity-0 scale-95"
                 class="absolute right-0 z-10 mt-2.5 w-48 origin-top-right rounded-md bg-white py-2 shadow-lg ring-1 ring-gray-900/5 focus:outline-none"
                 style="display: none;">
              <div class="px-4 py-2 border-b border-gray-100">
                <p class="text-xs text-gray-500">{{ 'sidebar.logged_as'|trans }}</p>
                <p class="text-sm font-medium text-gray-900 truncate">{{ app.user ? app.user.email : '' }}</p>
              </div>
              <a href="{{ path('app_logout') }}"
                 class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 transition-colors">
                {{ 'sidebar.close_session'|trans }}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    {# ── Flash messages (toasts) ─────────────────────────────────── #}
    <div class="fixed top-20 right-4 z-50 flex flex-col gap-3 w-96 max-w-[calc(100vw-2rem)]">
      {% for type, messages in app.flashes %}
        {% for message in messages %}
          <div x-data="{ show: true }"
               x-init="setTimeout(() => show = false, 5000)"
               x-show="show"
               x-transition:enter="transition ease-out duration-300"
               x-transition:enter-start="opacity-0 translate-x-8"
               x-transition:enter-end="opacity-100 translate-x-0"
               x-transition:leave="transition ease-in duration-200"
               x-transition:leave-start="opacity-100 translate-x-0"
               x-transition:leave-end="opacity-0 translate-x-8"
               class="pointer-events-auto rounded-lg p-4 shadow-lg ring-1 ring-black/5
                      {% if type == 'success' %}bg-emerald-50 text-emerald-800 ring-emerald-200{% endif %}
                      {% if type == 'error' or type == 'danger' %}bg-red-50 text-red-800 ring-red-200{% endif %}
                      {% if type == 'warning' %}bg-amber-50 text-amber-800 ring-amber-200{% endif %}
                      {% if type == 'info' %}bg-blue-50 text-blue-800 ring-blue-200{% endif %}">
            <div class="flex items-start gap-3">
              <div class="shrink-0 pt-0.5">
                {% if type == 'success' %}
                  <svg class="h-5 w-5 text-emerald-500" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/>
                  </svg>
                {% elseif type == 'error' or type == 'danger' %}
                  <svg class="h-5 w-5 text-red-500" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd"/>
                  </svg>
                {% elseif type == 'warning' %}
                  <svg class="h-5 w-5 text-amber-500" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
                  </svg>
                {% else %}
                  <svg class="h-5 w-5 text-blue-500" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd"/>
                  </svg>
                {% endif %}
              </div>
              <p class="text-sm font-medium flex-1">{{ message }}</p>
              <button @click="show = false" class="shrink-0 text-current opacity-50 hover:opacity-100 transition-opacity">
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z"/>
                </svg>
              </button>
            </div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>

    {# ── Page content ────────────────────────────────────────────── #}
    <main class="py-8">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        {% block content %}{% endblock %}
      </div>
    </main>
  </div>

</div>
{% endblock %}
{% block scripts %}{% endblock %}
<script>
function searchAutocomplete() {
  return {
    query: '',
    results: [],
    showDropdown: false,
    fetchTimeout: null,
    async fetchResults() {
      if (this.query.length < 2) {
        this.results = [];
        this.showDropdown = false;
        return;
      }
      try {
        const resp = await fetch('/api/search?q=' + encodeURIComponent(this.query));
        const data = await resp.json();
        this.results = data.results || [];
        this.showDropdown = this.results.length > 0;
      } catch (e) {
        this.results = [];
        this.showDropdown = false;
      }
    }
  };
}

function notificationBell() {
  return {
    unreadCount: 0,
    _eventSource: null,
    async init() {
      try {
        const resp = await fetch('/api/notifications/unread-count');
        if (resp.ok) {
          const data = await resp.json();
          this.unreadCount = data.unread_count || 0;
        }
      } catch (_) {}
      this._connectSSE();
    },
    async _connectSSE() {
      const userId = this.$el.dataset.userId;
      const mercureBase = this.$el.dataset.mercureUrl;
      if (!userId || !mercureBase) return;

      try {
        const tokenRes = await fetch('/api/mercure-token', { credentials: 'include' });
        if (!tokenRes.ok) return;
        const { token } = await tokenRes.json();

        const hub = new URL(mercureBase);
        hub.searchParams.append('topic', '/map/users/' + userId + '/notifications');
        if (token) hub.searchParams.set('authorization', token);

        this._eventSource = new EventSource(hub);
        this._eventSource.onmessage = (e) => {
          try {
            const data = JSON.parse(e.data);
            if (typeof data.unread_count === 'number') {
              this.unreadCount = data.unread_count;
            }
          } catch (_) {}
        };
      } catch (_) {}
    },
    destroy() {
      if (this._eventSource) {
        this._eventSource.close();
        this._eventSource = null;
      }
    }
  };
}
</script>
</body>
</html>
