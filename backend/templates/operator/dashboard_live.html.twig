{% extends 'base.html.twig' %}

{% block title %}Dashboard Live - MXO Track{% endblock %}

{% block styles %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
<style>
  #live-map { height: 400px; width: 100%; border-radius: 0.75rem; z-index: 1; }
  .vehicle-marker {
    width: 32px; height: 32px;
    background: #1e3a8a;
    border: 2px solid #3b82f6;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.4);
    transition: transform 0.8s ease;
  }
  .vehicle-marker svg { width: 16px; height: 16px; fill: #fff; }
  .stop-marker {
    width: 22px; height: 22px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 10px; font-weight: 700; color: #fff;
    box-shadow: 0 2px 6px rgba(0,0,0,0.35);
    border: 2px solid rgba(255,255,255,0.6);
  }
  .stop-pending   { background: #3b82f6; }
  .stop-delivered  { background: #22c55e; }
  .stop-exception  { background: #ef4444; }
  .stop-skipped    { background: #6b7280; }
  .leaflet-tooltip.vehicle-tooltip {
    background: rgba(15,23,42,0.92);
    border: 1px solid rgba(59,130,246,0.5);
    color: #e2e8f0;
    font-size: 12px;
    padding: 4px 8px;
    border-radius: 6px;
  }
  .leaflet-tooltip.vehicle-tooltip::before { border-top-color: rgba(15,23,42,0.92); }
</style>
{% endblock %}

{% block content %}
<div x-data="liveDashboard()" x-init="init()">

{# -- Page header -- #}
<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold tracking-tight text-gray-900">Dashboard en Vivo</h1>
    <p class="mt-1 text-sm text-gray-500">
      Seguimiento en tiempo real de rutas y entregas
    </p>
  </div>
  <div class="flex items-center gap-3">
    <div class="flex items-center gap-2 rounded-full bg-gray-50 px-3 py-1.5 ring-1 ring-gray-200">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full opacity-75"
              :class="sseConnected ? 'bg-emerald-400' : 'bg-red-400'"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full"
              :class="sseConnected ? 'bg-emerald-500' : 'bg-red-500'"></span>
      </span>
      <span class="text-xs font-medium text-gray-600" x-text="sseConnected ? 'En vivo' : 'Desconectado'"></span>
    </div>
    <span class="text-xs text-gray-400 font-mono" x-text="currentTime"></span>
    <a href="{{ path('admin_dashboard') }}"
       class="inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-1.5 text-sm font-medium text-gray-700 shadow-sm ring-1 ring-gray-300 hover:bg-gray-50 transition-colors">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
      </svg>
      Dashboard
    </a>
  </div>
</div>

{# -- KPI Cards -- #}
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">

  {# Active routes #}
  <div class="relative overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5">
    <div class="p-5">
      <div class="flex items-center gap-4">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-indigo-50">
          <svg class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-500">Rutas activas</p>
          <p class="text-2xl font-bold text-gray-900" x-text="kpi.activeRoutes">{{ totalActiveRoutes }}</p>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-1 bg-indigo-500"></div>
  </div>

  {# Deliveries today #}
  <div class="relative overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5">
    <div class="p-5">
      <div class="flex items-center gap-4">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-emerald-50">
          <svg class="h-6 w-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-500">Entregas hoy</p>
          <p class="text-2xl font-bold text-gray-900" x-text="kpi.deliveriesToday">{{ deliveriesToday }}</p>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-1 bg-emerald-500"></div>
  </div>

  {# Exceptions #}
  <div class="relative overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5">
    <div class="p-5">
      <div class="flex items-center gap-4">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg"
             :class="kpi.exceptionsToday > 0 ? 'bg-red-50' : 'bg-gray-50'">
          <svg class="h-6 w-6" :class="kpi.exceptionsToday > 0 ? 'text-red-600' : 'text-gray-400'" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-500">Excepciones</p>
          <p class="text-2xl font-bold" :class="kpi.exceptionsToday > 0 ? 'text-red-600' : 'text-gray-900'" x-text="kpi.exceptionsToday">{{ exceptionsToday }}</p>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-1" :class="kpi.exceptionsToday > 0 ? 'bg-red-500' : 'bg-gray-300'"></div>
  </div>

  {# Completion rate #}
  <div class="relative overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5">
    <div class="p-5">
      <div class="flex items-center gap-4">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-amber-50">
          <svg class="h-6 w-6 text-amber-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-500">Completado</p>
          <p class="text-2xl font-bold text-gray-900" x-text="kpi.completionRate + '%'">{{ completionRate }}%</p>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-1 bg-amber-500"></div>
  </div>

</div>

{# -- Live Map -- #}
<div class="mb-6 rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5 overflow-hidden">
  <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
    <h2 class="text-base font-semibold text-gray-900">Mapa de flota en vivo</h2>
    <a href="{{ path('fleet_map') }}"
       class="inline-flex items-center gap-1.5 text-xs font-medium text-brand-600 hover:text-brand-500 transition-colors">
      Abrir mapa completo
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
      </svg>
    </a>
  </div>
  <div id="live-map"></div>
</div>

{# -- Active Routes Table -- #}
<div class="rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5 overflow-hidden">
  <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
    <h2 class="text-base font-semibold text-gray-900">Rutas activas</h2>
    <a href="{{ path('admin_routes_index') }}"
       class="text-xs font-medium text-brand-600 hover:text-brand-500 transition-colors">
      Ver todas &rarr;
    </a>
  </div>

  {% if activeRoutes|length > 0 %}
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Ruta</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Conductor</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Vehiculo</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Progreso</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Estado</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Alertas</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 bg-white">
        {% for route in activeRoutes %}
          {% set counts = stopCounts[route.id] ?? {total: 0, delivered: 0, exceptions: 0} %}
          {% set pct = counts.total > 0 ? ((counts.delivered / counts.total) * 100)|round(0) : 0 %}
          {% set isDelayed = route.startAt and route.estimatedDurationMinutes and (date().timestamp - route.startAt.timestamp) > (route.estimatedDurationMinutes * 60) and route.status.value == 'ACTIVE' %}
          <tr class="hover:bg-gray-50 transition-colors" id="route-row-{{ route.publicIdString }}">
            <td class="whitespace-nowrap px-6 py-4">
              <div class="text-sm font-medium text-gray-900">{{ route.name }}</div>
              <div class="text-xs text-gray-500">{{ route.publicIdString[:8] }}...</div>
            </td>
            <td class="whitespace-nowrap px-6 py-4">
              {% if route.driver %}
                <div class="text-sm text-gray-900">{{ route.driver.name ?? route.driver.email }}</div>
              {% else %}
                <span class="text-sm text-gray-400">Sin asignar</span>
              {% endif %}
            </td>
            <td class="whitespace-nowrap px-6 py-4">
              {% if route.vehicle %}
                <div class="text-sm text-gray-900">{{ route.vehicle.name }}</div>
              {% else %}
                <span class="text-sm text-gray-400">Sin vehiculo</span>
              {% endif %}
            </td>
            <td class="whitespace-nowrap px-6 py-4">
              <div class="flex items-center gap-3">
                <div class="w-24 h-2 bg-gray-200 rounded-full overflow-hidden">
                  <div class="h-full rounded-full transition-all duration-500
                              {% if pct == 100 %}bg-emerald-500{% elseif pct > 50 %}bg-blue-500{% else %}bg-amber-500{% endif %}"
                       style="width: {{ pct }}%"></div>
                </div>
                <span class="text-sm font-medium text-gray-700">{{ counts.delivered }}/{{ counts.total }}</span>
              </div>
            </td>
            <td class="whitespace-nowrap px-6 py-4">
              {% if route.status.value == 'ACTIVE' %}
                <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20">
                  Activa
                </span>
              {% elseif route.status.value == 'PLANNED' %}
                <span class="inline-flex items-center rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-600/20">
                  Planificada
                </span>
              {% endif %}
            </td>
            <td class="whitespace-nowrap px-6 py-4">
              {% if isDelayed %}
                <span class="inline-flex items-center gap-1 rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/20 animate-pulse">
                  <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
                  </svg>
                  Retrasada
                </span>
              {% elseif counts.exceptions > 0 %}
                <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700 ring-1 ring-inset ring-amber-600/20">
                  {{ counts.exceptions }} excepcion{{ counts.exceptions > 1 ? 'es' : '' }}
                </span>
              {% else %}
                <span class="text-xs text-gray-400">--</span>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
    <div class="px-6 py-12 text-center">
      <svg class="mx-auto h-10 w-10 text-gray-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/>
      </svg>
      <p class="mt-2 text-sm text-gray-500">No hay rutas activas en este momento.</p>
    </div>
  {% endif %}
</div>

</div>

{# -- Leaflet JS -- #}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
function esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

function liveDashboard() {
  return {
    vehicles: {{ vehicles_json|raw }},
    routes: {{ routes_json|raw }},
    mercureUrl: '{{ mercure_public_url }}',
    sseConnected: false,
    currentTime: '',
    _eventSource: null,
    _mercureToken: null,
    map: null,
    vehicleMarkers: {},

    kpi: {
      activeRoutes: {{ totalActiveRoutes }},
      deliveriesToday: {{ deliveriesToday }},
      exceptionsToday: {{ exceptionsToday }},
      completionRate: {{ completionRate }},
    },

    init() {
      this.initMap();
      this.placeVehicles();
      this.placeRouteStops();
      this.startClock();
      this.fetchMercureToken().then(() => this.connectSse());
    },

    initMap() {
      this.map = L.map('live-map', {
        zoomControl: true,
        attributionControl: false,
      }).setView([40.4168, -3.7038], 6);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
      }).addTo(this.map);

      // Fit bounds to vehicles/route stops
      const points = [];
      this.vehicles.forEach(v => {
        if (v.last_position) points.push([v.last_position.lat, v.last_position.lng]);
      });
      this.routes.forEach(r => {
        r.stops.forEach(s => {
          if (s.lat && s.lng) points.push([s.lat, s.lng]);
        });
      });
      if (points.length > 0) {
        this.map.fitBounds(L.latLngBounds(points), { padding: [40, 40], maxZoom: 14 });
      }
    },

    createVehicleIcon(course) {
      const rotation = course || 0;
      return L.divIcon({
        className: '',
        iconSize: [32, 32],
        iconAnchor: [16, 16],
        html: '<div class="vehicle-marker" style="transform: rotate(' + rotation + 'deg);"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M18 18.5a1.5 1.5 0 100-3 1.5 1.5 0 000 3zm-12 0a1.5 1.5 0 100-3 1.5 1.5 0 000 3zM19.92 6.09C19.72 5.46 19.16 5 18.5 5h-11c-.66 0-1.21.42-1.42 1.02L4 12v6c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h10v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-6l-2.08-5.91zM7.5 15a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm9 0a1.5 1.5 0 110-3 1.5 1.5 0 010 3zM5.81 10l1.04-3h10.29l1.04 3H5.81z"/></svg></div>',
      });
    },

    createStopIcon(status, sequence) {
      const cls = { 'PENDING': 'stop-pending', 'DELIVERED': 'stop-delivered', 'EXCEPTION': 'stop-exception', 'SKIPPED': 'stop-skipped' }[status] || 'stop-pending';
      return L.divIcon({
        className: '',
        iconSize: [22, 22],
        iconAnchor: [11, 11],
        html: '<div class="stop-marker ' + cls + '">' + sequence + '</div>',
      });
    },

    placeVehicles() {
      this.vehicles.forEach(v => {
        if (!v.last_position) return;
        const latlng = [v.last_position.lat, v.last_position.lng];
        const marker = L.marker(latlng, {
          icon: this.createVehicleIcon(v.last_position.course),
        }).addTo(this.map);

        const speed = Math.round(v.last_position.speed || 0);
        marker.bindTooltip(esc(v.name) + ' - ' + speed + ' km/h', {
          className: 'vehicle-tooltip',
          direction: 'top',
          offset: [0, -18],
        });

        this.vehicleMarkers[v.public_id] = marker;
      });
    },

    placeRouteStops() {
      this.routes.forEach(r => {
        const validStops = [];
        r.stops.forEach(s => {
          if (!s.lat || !s.lng) return;
          const latlng = [s.lat, s.lng];
          validStops.push({ latlng, status: s.status });

          const marker = L.marker(latlng, {
            icon: this.createStopIcon(s.status, s.sequence),
          }).addTo(this.map);

          let tooltip = '<strong>#' + s.sequence + '</strong> ' + esc(s.address);
          if (s.recipient) tooltip += '<br>' + esc(s.recipient);
          tooltip += '<br><em>' + esc(s.status) + '</em>';
          marker.bindTooltip(tooltip, {
            className: 'vehicle-tooltip',
            direction: 'top',
            offset: [0, -12],
          });
        });

        // Draw route polyline
        for (let i = 1; i < validStops.length; i++) {
          const color = { DELIVERED: '#22c55e', EXCEPTION: '#ef4444', SKIPPED: '#6b7280' }[validStops[i].status] || '#3b82f6';
          L.polyline([validStops[i - 1].latlng, validStops[i].latlng], {
            color: color,
            weight: 2.5,
            opacity: 0.7,
          }).addTo(this.map);
        }
      });
    },

    startClock() {
      const update = () => {
        const now = new Date();
        this.currentTime = now.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      };
      update();
      setInterval(update, 1000);
    },

    async fetchMercureToken() {
      try {
        const res = await fetch('/api/mercure-token', { credentials: 'include' });
        if (res.ok) {
          const data = await res.json();
          this._mercureToken = data.token;
        }
      } catch (_) { /* silent */ }
    },

    connectSse() {
      if (this._eventSource) this._eventSource.close();

      const hub = new URL(this.mercureUrl);
      this.vehicles.forEach(v => {
        hub.searchParams.append('topic', '/vehicles/' + v.public_id + '/position');
      });
      hub.searchParams.append('topic', '/operator/fleet');

      if (this._mercureToken) {
        hub.searchParams.set('authorization', this._mercureToken);
      }

      this._eventSource = new EventSource(hub.toString());

      this._eventSource.onopen = () => { this.sseConnected = true; };
      this._eventSource.onerror = () => { this.sseConnected = false; };

      this._eventSource.onmessage = (event) => {
        this.sseConnected = true;
        try {
          const payload = JSON.parse(event.data);
          const vid = payload.vehicle_public_id || payload.vehicleId;
          if (vid && Number.isFinite(payload.lat) && Number.isFinite(payload.lng)) {
            this.handlePositionUpdate(vid, payload);
          }
        } catch (_) { /* ignore malformed */ }
      };
    },

    handlePositionUpdate(vid, payload) {
      const latlng = [payload.lat, payload.lng];
      const speed = payload.speed || 0;
      const course = payload.course || 0;
      const rawTime = payload.device_time || payload.deviceTime || '';
      const deviceTime = rawTime.includes('T') ? rawTime.slice(11, 16) : rawTime;

      // Update vehicle data
      const vehicle = this.vehicles.find(v => v.public_id === vid);
      if (vehicle) {
        vehicle.last_position = { lat: payload.lat, lng: payload.lng, speed: speed, course: course, device_time: deviceTime };
      }

      const tooltipOpts = { className: 'vehicle-tooltip', direction: 'top', offset: [0, -18] };
      if (this.vehicleMarkers[vid]) {
        const marker = this.vehicleMarkers[vid];
        marker.setLatLng(latlng);
        if (marker.getTooltip()) marker.unbindTooltip();
        marker.setIcon(this.createVehicleIcon(course));
        const name = vehicle ? vehicle.name : vid;
        marker.bindTooltip(esc(name) + ' - ' + Math.round(speed) + ' km/h', tooltipOpts);
      } else {
        const marker = L.marker(latlng, {
          icon: this.createVehicleIcon(course),
        }).addTo(this.map);
        const name = vehicle ? vehicle.name : vid;
        marker.bindTooltip(esc(name) + ' - ' + Math.round(speed) + ' km/h', tooltipOpts);
        this.vehicleMarkers[vid] = marker;
      }
    },
  };
}
</script>
{% endblock %}
