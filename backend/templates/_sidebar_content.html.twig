{# ── Brand header ──────────────────────────────────────────────────── #}
<div class="flex h-16 shrink-0 items-center px-6 border-b border-slate-700">
  <a href="/" class="flex items-center gap-3">
    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-600">
      <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
      </svg>
    </div>
    <span class="text-lg font-bold text-white tracking-tight">MXO Track</span>
  </a>
</div>

{# ── Navigation links ─────────────────────────────────────────────── #}
<nav class="flex flex-1 flex-col px-4 py-6">
  <ul role="list" class="flex flex-1 flex-col gap-y-1">

    {# ── Admin / Operator navigation ─────────────────────────────── #}
    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_OPERATOR') %}

      <li class="mb-2">
        <span class="px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">Principal</span>
      </li>

      {# Dashboard #}
      <li>
        <a href="{{ path('admin_dashboard') }}"
           class="group flex items-center gap-x-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors
                  {% if app.request.attributes.get('_route') == 'admin_dashboard' %}
                    bg-slate-900 text-white
                  {% else %}
                    text-slate-300 hover:bg-slate-700 hover:text-white
                  {% endif %}">
          <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/>
          </svg>
          Dashboard
        </a>
      </li>

      <li class="mt-4 mb-2">
        <span class="px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">Operaciones</span>
      </li>

      {# Vehiculos #}
      <li>
        <a href="{{ path('admin_vehicles_index') }}"
           class="group flex items-center gap-x-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors
                  {% if app.request.attributes.get('_route') starts with 'admin_vehicles' %}
                    bg-slate-900 text-white
                  {% else %}
                    text-slate-300 hover:bg-slate-700 hover:text-white
                  {% endif %}">
          <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
          </svg>
          Vehiculos
        </a>
      </li>

      {# Transportistas #}
      <li>
        <a href="{{ path('admin_drivers_index') }}"
           class="group flex items-center gap-x-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors
                  {% if app.request.attributes.get('_route') starts with 'admin_drivers' %}
                    bg-slate-900 text-white
                  {% else %}
                    text-slate-300 hover:bg-slate-700 hover:text-white
                  {% endif %}">
          <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
          </svg>
          Transportistas
        </a>
      </li>

      {# Rutas #}
      <li>
        <a href="{{ path('admin_routes_index') }}"
           class="group flex items-center gap-x-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors
                  {% if app.request.attributes.get('_route') starts with 'admin_routes' %}
                    bg-slate-900 text-white
                  {% else %}
                    text-slate-300 hover:bg-slate-700 hover:text-white
                  {% endif %}">
          <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/>
          </svg>
          Rutas
        </a>
      </li>

      {# Clientes #}
      <li>
        <a href="{{ path('admin_customers_index') }}"
           class="group flex items-center gap-x-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors
                  {% if app.request.attributes.get('_route') starts with 'admin_customers' %}
                    bg-slate-900 text-white
                  {% else %}
                    text-slate-300 hover:bg-slate-700 hover:text-white
                  {% endif %}">
          <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z"/>
          </svg>
          Almacenes
        </a>
      </li>

      <li class="mt-4 mb-2">
        <span class="px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">Administracion</span>
      </li>

      {# Usuarios #}
      <li>
        <a href="{{ path('admin_users_index') }}"
           class="group flex items-center gap-x-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors
                  {% if app.request.attributes.get('_route') starts with 'admin_users' %}
                    bg-slate-900 text-white
                  {% else %}
                    text-slate-300 hover:bg-slate-700 hover:text-white
                  {% endif %}">
          <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"/>
          </svg>
          Usuarios
        </a>
      </li>

      {# Import CSV #}
      <li>
        <a href="{{ path('admin_shipments_import') }}"
           class="group flex items-center gap-x-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors
                  {% if app.request.attributes.get('_route') starts with 'admin_shipments_import' %}
                    bg-slate-900 text-white
                  {% else %}
                    text-slate-300 hover:bg-slate-700 hover:text-white
                  {% endif %}">
          <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/>
          </svg>
          Import CSV
        </a>
      </li>

      <li class="mt-4 mb-2">
        <span class="px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">Seguimiento</span>
      </li>

      {# Mapa #}
      <li>
        <a href="{{ path('fleet_map') }}"
           class="group flex items-center gap-x-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors
                  {% if app.request.attributes.get('_route') == 'fleet_map' %}
                    bg-slate-900 text-white
                  {% else %}
                    text-slate-300 hover:bg-slate-700 hover:text-white
                  {% endif %}">
          <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
          </svg>
          Mapa
        </a>
      </li>

    {% endif %}

    {# ── Customer navigation ─────────────────────────────────────── #}
    {% if is_granted('ROLE_CUSTOMER') and not is_granted('ROLE_ADMIN') and not is_granted('ROLE_OPERATOR') %}

      <li class="mb-2">
        <span class="px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">Principal</span>
      </li>

      {# Dashboard #}
      <li>
        <a href="{{ path('customer_dashboard') }}"
           class="group flex items-center gap-x-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors
                  {% if app.request.attributes.get('_route') == 'customer_dashboard' %}
                    bg-slate-900 text-white
                  {% else %}
                    text-slate-300 hover:bg-slate-700 hover:text-white
                  {% endif %}">
          <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/>
          </svg>
          Dashboard
        </a>
      </li>

      <li class="mt-4 mb-2">
        <span class="px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">Mis entregas</span>
      </li>

      {# Mis Rutas #}
      <li>
        <a href="{{ path('customer_routes_index') }}"
           class="group flex items-center gap-x-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors
                  {% if app.request.attributes.get('_route') starts with 'customer_routes' %}
                    bg-slate-900 text-white
                  {% else %}
                    text-slate-300 hover:bg-slate-700 hover:text-white
                  {% endif %}">
          <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/>
          </svg>
          Mis Rutas
        </a>
      </li>

      {# Mis Envios #}
      <li>
        <a href="{{ path('customer_shipments_index') }}"
           class="group flex items-center gap-x-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors
                  {% if app.request.attributes.get('_route') starts with 'customer_shipments' %}
                    bg-slate-900 text-white
                  {% else %}
                    text-slate-300 hover:bg-slate-700 hover:text-white
                  {% endif %}">
          <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"/>
          </svg>
          Mis Envios
        </a>
      </li>

      <li class="mt-4 mb-2">
        <span class="px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">Seguimiento</span>
      </li>

      {# Mapa #}
      <li>
        <a href="{{ path('fleet_map') }}"
           class="group flex items-center gap-x-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors
                  {% if app.request.attributes.get('_route') == 'fleet_map' %}
                    bg-slate-900 text-white
                  {% else %}
                    text-slate-300 hover:bg-slate-700 hover:text-white
                  {% endif %}">
          <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
          </svg>
          Mapa
        </a>
      </li>

    {% endif %}

    {# ── Driver navigation ───────────────────────────────────────── #}
    {% if is_granted('ROLE_DRIVER') and not is_granted('ROLE_ADMIN') %}

      <li class="mb-2">
        <span class="px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">Conductor</span>
      </li>

      {# Mis Rutas (driver) #}
      <li>
        <a href="{{ path('admin_routes_index') }}"
           class="group flex items-center gap-x-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors
                  {% if app.request.attributes.get('_route') starts with 'admin_routes' or app.request.attributes.get('_route') starts with 'driver' %}
                    bg-slate-900 text-white
                  {% else %}
                    text-slate-300 hover:bg-slate-700 hover:text-white
                  {% endif %}">
          <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/>
          </svg>
          Mis Rutas
        </a>
      </li>

    {% endif %}

    {# ── Sidebar footer ──────────────────────────────────────────── #}
    <li class="mt-auto pt-6 border-t border-slate-700">
      <div class="flex items-center gap-x-3 px-3 py-2">
        <div class="flex h-8 w-8 items-center justify-center rounded-full bg-slate-600 text-sm font-semibold text-white">
          {{ app.user ? app.user.email|first|upper : '?' }}
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-sm font-medium text-white truncate">{{ app.user ? app.user.email : '' }}</p>
          <p class="text-xs text-slate-400 truncate">
            {% if is_granted('ROLE_ADMIN') %}
              Administrador
            {% elseif is_granted('ROLE_OPERATOR') %}
              Operador
            {% elseif is_granted('ROLE_CUSTOMER') %}
              Cliente
            {% elseif is_granted('ROLE_DRIVER') %}
              Conductor
            {% endif %}
          </p>
        </div>
        <a href="{{ path('app_logout') }}" class="text-slate-400 hover:text-white transition-colors" title="Cerrar sesion">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9"/>
          </svg>
        </a>
      </div>
    </li>

  </ul>
</nav>
