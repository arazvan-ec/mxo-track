{
  "name": "transporte-tracking/backend",
  "type": "project",
  "require": {
    "doctrine/doctrine-bundle": "^2.12",
    "doctrine/doctrine-migrations-bundle": "^3.4",
    "doctrine/orm": "^3.2",
    "ext-json": "*",
    "firebase/php-jwt": "^6.10 || ^7.0",
    "php": ">=8.2",
    "predis/predis": "^2.3",
    "symfony/asset": "^7.4",
    "symfony/console": "^7.4",
    "symfony/dotenv": "^7.4",
    "symfony/flex": "^2",
    "symfony/framework-bundle": "^7.4",
    "symfony/http-client": "^7.4",
    "symfony/mercure-bundle": "0.3.*",
    "symfony/messenger": "^7.4",
    "symfony/runtime": "^7.4",
    "symfony/security-bundle": "^7.4",
    "symfony/serializer": "^7.4",
    "symfony/twig-bundle": "^7.4",
    "symfony/uid": "^7.4",
    "symfony/ux-turbo": "^2.28",
    "symfony/validator": "^7.4",
    "symfony/yaml": "^7.4",
    "symfony/rate-limiter": "^7.4",
    "symfony/form": "7.4.*"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^3.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    }
  },
  "extra": {
    "symfony": {
      "require": "7.4.*"
    }
  },
  "conflict": {
    "symfony/symfony": ">=8.0"
  }
}
